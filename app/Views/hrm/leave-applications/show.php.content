<?php
use App\Core\Auth;
$a = $application;
$statusBadge = ['Pending' => 'warning', 'Approved' => 'success', 'Rejected' => 'danger'][$a['status']] ?? 'secondary';
?>
<?= flash_messages() ?>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h4 class="mb-0"><?= e($a['employee_name']) ?> &middot; <?= e($a['leave_type_name']) ?></h4>
    <span class="text-muted"><?= e($a['employee_no']) ?></span>
  </div>
  <span class="badge bg-<?= $statusBadge ?> fs-6"><?= e($a['status']) ?></span>
</div>

<div class="card mb-3">
  <div class="card-body">
    <table class="table table-sm table-borderless mb-0">
      <tr><th class="text-muted" style="width:25%">Leave Type</th><td><span class="badge" style="background-color: <?= e($a['leave_type_color']) ?>">&nbsp;</span> <?= e($a['leave_type_name']) ?> (<?= $a['leave_type_is_paid'] ? 'Paid' : 'Unpaid' ?>)</td></tr>
      <tr><th class="text-muted">Dates</th><td><?= e(date('d M Y', strtotime($a['start_date']))) ?> &ndash; <?= e(date('d M Y', strtotime($a['end_date']))) ?> (<?= (int) $a['total_days'] ?> day<?= (int) $a['total_days'] === 1 ? '' : 's' ?>)</td></tr>
      <tr><th class="text-muted">Reason</th><td><?= nl2br(e($a['reason'])) ?></td></tr>
      <?php if ($a['status'] !== 'Pending'): ?>
        <tr><th class="text-muted">Decision By</th><td><?= e($a['approved_by_name'] ?: '—') ?> on <?= $a['approved_at'] ? e(date('d M Y H:i', strtotime($a['approved_at']))) : '—' ?></td></tr>
        <tr><th class="text-muted">Comment</th><td><?= e($a['approver_comment'] ?: '—') ?></td></tr>
      <?php endif; ?>
    </table>
  </div>
</div>

<?php if ($a['status'] === 'Pending' && Auth::can('hrm.manage')): ?>
<div class="row">
  <div class="col-md-6 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title text-success">Approve</h5>
        <form method="post" action="<?= url('/hrm/leave-applications/' . $a['id'] . '/approve') ?>">
          <?= csrf_field() ?>
          <div class="mb-2">
            <textarea name="approver_comment" rows="2" class="form-control" placeholder="Optional comment"></textarea>
          </div>
          <button type="submit" class="btn btn-success btn-sm"><i class="mdi mdi-check"></i> Approve</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-md-6 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title text-danger">Reject</h5>
        <form method="post" action="<?= url('/hrm/leave-applications/' . $a['id'] . '/reject') ?>">
          <?= csrf_field() ?>
          <div class="mb-2">
            <textarea name="approver_comment" rows="2" class="form-control" placeholder="Reason for rejection"></textarea>
          </div>
          <button type="submit" class="btn btn-danger btn-sm"><i class="mdi mdi-close"></i> Reject</button>
        </form>
      </div>
    </div>
  </div>
</div>
<?php endif; ?>

<a href="<?= url('/hrm/leave-applications') ?>" class="btn btn-outline-secondary btn-sm">Back</a>
