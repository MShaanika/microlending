<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Leave Applications</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/leave-applications/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Apply for Leave</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/leave-applications') ?>" class="row g-2 mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="col-md-3">
        <input type="text" name="q" class="form-control" placeholder="Search reason..." value="<?= e($filters['search']) ?>">
      </div>
      <div class="col-md-3">
        <select name="employee_id" class="form-select">
          <option value="">All employees</option>
          <?php foreach ($employees as $emp): ?>
            <option value="<?= (int) $emp['id'] ?>" <?= (string) $filters['employee_id'] === (string) $emp['id'] ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-2">
        <select name="status" class="form-select">
          <option value="">All statuses</option>
          <?php foreach (['Pending', 'Approved', 'Rejected'] as $s): ?>
            <option value="<?= $s ?>" <?= $filters['status'] === $s ? 'selected' : '' ?>><?= $s ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-2">
        <select name="per_page" class="form-select" onchange="this.form.submit()">
          <?php foreach ([10, 25, 50, 100] as $pp): ?>
            <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary w-100"><i class="mdi mdi-magnify"></i></button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Employee', 'employee', $_GET, $sort, $dir) ?>
            <?= sortable_th('Leave Type', 'leave_type', $_GET, $sort, $dir) ?>
            <?= sortable_th('From', 'start_date', $_GET, $sort, $dir) ?>
            <th>To</th>
            <?= sortable_th('Days', 'total_days', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($applications)): ?>
            <tr><td colspan="6" class="text-center text-muted py-4">No leave applications found.</td></tr>
          <?php endif; ?>
          <?php foreach ($applications as $a):
            $statusBadge = ['Pending' => 'warning', 'Approved' => 'success', 'Rejected' => 'danger'][$a['status']] ?? 'secondary';
          ?>
            <tr>
              <td><a href="<?= url('/hrm/leave-applications/' . $a['id']) ?>"><?= e($a['employee_name']) ?></a></td>
              <td><span class="badge" style="background-color: <?= e($a['leave_type_color']) ?>">&nbsp;</span> <?= e($a['leave_type_name']) ?></td>
              <td><?= e(date('d M Y', strtotime($a['start_date']))) ?></td>
              <td><?= e(date('d M Y', strtotime($a['end_date']))) ?></td>
              <td><?= (int) $a['total_days'] ?></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($a['status']) ?></span></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($applications) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
