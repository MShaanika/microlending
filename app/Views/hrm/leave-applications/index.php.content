<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Leave Applications</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/leave-applications/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Apply for Leave</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/leave-applications') ?>" class="row g-2 mb-3">
      <div class="col-md-4">
        <select name="employee_id" class="form-select">
          <option value="">All employees</option>
          <?php foreach ($employees as $emp): ?>
            <option value="<?= (int) $emp['id'] ?>" <?= (string) $filters['employee_id'] === (string) $emp['id'] ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">All statuses</option>
          <?php foreach (['Pending', 'Approved', 'Rejected'] as $s): ?>
            <option value="<?= $s ?>" <?= $filters['status'] === $s ? 'selected' : '' ?>><?= $s ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary w-100"><i class="mdi mdi-magnify"></i></button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Employee</th><th>Leave Type</th><th>From</th><th>To</th><th>Days</th><th>Status</th></tr>
        </thead>
        <tbody>
          <?php if (empty($applications)): ?>
            <tr><td colspan="6" class="text-center text-muted py-4">No leave applications found.</td></tr>
          <?php endif; ?>
          <?php foreach ($applications as $a):
            $statusBadge = ['Pending' => 'warning', 'Approved' => 'success', 'Rejected' => 'danger'][$a['status']] ?? 'secondary';
          ?>
            <tr>
              <td><a href="<?= url('/hrm/leave-applications/' . $a['id']) ?>"><?= e($a['employee_name']) ?></a></td>
              <td><span class="badge" style="background-color: <?= e($a['leave_type_color']) ?>">&nbsp;</span> <?= e($a['leave_type_name']) ?></td>
              <td><?= e(date('d M Y', strtotime($a['start_date']))) ?></td>
              <td><?= e(date('d M Y', strtotime($a['end_date']))) ?></td>
              <td><?= (int) $a['total_days'] ?></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($a['status']) ?></span></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
