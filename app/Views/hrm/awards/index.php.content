<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Awards</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/awards/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/hrm/awards/create') ?>" data-modal-title="Add Award" data-modal-size="lg"><i class="mdi mdi-plus"></i> Add Award</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/awards') ?>" class="row g-2 mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="col-md-3">
        <input type="text" name="q" class="form-control" placeholder="Search description..." value="<?= e($filters['search']) ?>">
      </div>
      <div class="col-md-4">
        <select name="employee_id" class="form-select">
          <option value="">All employees</option>
          <?php foreach ($employees as $emp): ?>
            <option value="<?= (int) $emp['id'] ?>" <?= (string) $filters['employee_id'] === (string) $emp['id'] ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-2">
        <select name="per_page" class="form-select" onchange="this.form.submit()">
          <?php foreach ([10, 25, 50, 100] as $pp): ?>
            <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary w-100"><i class="mdi mdi-magnify"></i></button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Employee', 'employee', $_GET, $sort, $dir) ?>
            <?= sortable_th('Award Type', 'award_type', $_GET, $sort, $dir) ?>
            <?= sortable_th('Date', 'award_date', $_GET, $sort, $dir) ?>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($awards)): ?>
            <tr><td colspan="4" class="text-center text-muted py-4">No awards recorded yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($awards as $a): ?>
            <tr>
              <td><a href="<?= url('/hrm/awards/' . $a['id']) ?>" data-modal-url="<?= url('/hrm/awards/' . $a['id']) ?>" data-modal-title="Award" data-modal-size="lg"><?= e($a['employee_name']) ?></a></td>
              <td><?= e($a['award_type_name'] ?: '—') ?></td>
              <td><?= e(date('d M Y', strtotime($a['award_date']))) ?></td>
              <td class="text-muted small"><?= e($a['description'] ?: '—') ?></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($awards) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
