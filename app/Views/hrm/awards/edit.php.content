<?php $a = $award; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Edit Award</h4>

    <form method="post" action="<?= url('/hrm/awards/' . $a['id']) ?>">
      <?= csrf_field() ?>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Employee <span class="text-danger">*</span></label>
          <select name="employee_id" class="form-select <?= isset($errors['employee_id']) ? 'is-invalid' : '' ?>">
            <option value="">Select employee</option>
            <?php foreach ($employees as $emp): ?>
              <option value="<?= (int) $emp['id'] ?>" <?= $a['employee_id'] == $emp['id'] ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
            <?php endforeach; ?>
          </select>
          <?php if (isset($errors['employee_id'])): ?><div class="invalid-feedback d-block"><?= e($errors['employee_id']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Award Type</label>
          <select name="award_type_id" class="form-select">
            <option value="">Select type</option>
            <?php foreach ($awardTypes as $t): ?>
              <option value="<?= (int) $t['id'] ?>" <?= $a['award_type_id'] == $t['id'] ? 'selected' : '' ?>><?= e($t['name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Award Date <span class="text-danger">*</span></label>
          <input type="date" name="award_date" class="form-control <?= isset($errors['award_date']) ? 'is-invalid' : '' ?>" value="<?= e($a['award_date']) ?>">
          <?php if (isset($errors['award_date'])): ?><div class="invalid-feedback d-block"><?= e($errors['award_date']) ?></div><?php endif; ?>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" rows="3" class="form-control"><?= e($a['description'] ?? '') ?></textarea>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Changes</button>
      <a href="<?= url('/hrm/awards/' . $a['id']) ?>" class="btn btn-outline-secondary" data-modal-url="<?= url('/hrm/awards/' . $a['id']) ?>" data-modal-title="Award" data-modal-size="lg">Cancel</a>
    </form>
  </div>
</div>
