<form method="post" action="<?= url('/hrm/awards/' . $a['id'] . '/delete') ?>" onsubmit="return confirm('Delete this award?');" class="d-inline">
  <?= csrf_field() ?>
  <button type="submit" class="btn btn-outline-danger btn-sm"><i class="mdi mdi-delete"></i> Delete</button>
</form>
<?php endif; ?>
