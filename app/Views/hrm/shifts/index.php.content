<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Shifts</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/shifts/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/hrm/shifts/create') ?>" data-modal-title="Add Shift" data-modal-size="md"><i class="mdi mdi-plus"></i> Add Shift</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/shifts') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search shifts..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
        <?php foreach ([10, 25, 50, 100] as $pp): ?>
          <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
        <?php endforeach; ?>
      </select>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Shift', 'name', $_GET, $sort, $dir) ?>
            <?= sortable_th('Start', 'start_time', $_GET, $sort, $dir) ?>
            <?= sortable_th('End', 'end_time', $_GET, $sort, $dir) ?>
            <th>Break</th><th>Night Shift</th>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <?php if (Auth::can('hrm.manage')): ?><th></th><?php endif; ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($shifts)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4">No shifts yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($shifts as $s): ?>
            <tr>
              <td><?= e($s['shift_name']) ?></td>
              <td><?= $s['start_time'] ? e(date('H:i', strtotime($s['start_time']))) : '—' ?></td>
              <td><?= $s['end_time'] ? e(date('H:i', strtotime($s['end_time']))) : '—' ?></td>
              <td>
                <?php if ($s['break_start_time'] && $s['break_end_time']): ?>
                  <?= e(date('H:i', strtotime($s['break_start_time']))) ?> &ndash; <?= e(date('H:i', strtotime($s['break_end_time']))) ?>
                <?php else: ?>—<?php endif; ?>
              </td>
              <td><?= $s['is_night_shift'] ? '<span class="mdi mdi-weather-night text-primary"></span> Yes' : 'No' ?></td>
              <td><span class="badge bg-<?= $s['is_active'] ? 'success' : 'secondary' ?>"><?= $s['is_active'] ? 'Active' : 'Inactive' ?></span></td>
              <?php if (Auth::can('hrm.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/hrm/shifts/' . $s['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary" data-modal-url="<?= url('/hrm/shifts/' . $s['id'] . '/edit') ?>" data-modal-title="Edit Shift" data-modal-size="md"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/hrm/shifts/' . $s['id'] . '/toggle-active') ?>" class="d-inline">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-<?= $s['is_active'] ? 'danger' : 'success' ?>">
                    <?= $s['is_active'] ? 'Deactivate' : 'Activate' ?>
                  </button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($shifts) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
