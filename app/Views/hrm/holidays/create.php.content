<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Add Holiday</h4>

    <form method="post" action="<?= url('/hrm/holidays') ?>">
      <?= csrf_field() ?>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Name <span class="text-danger">*</span></label>
          <input type="text" name="name" class="form-control <?= isset($errors['name']) ? 'is-invalid' : '' ?>" value="<?= old('name', $old) ?>">
          <?php if (isset($errors['name'])): ?><div class="invalid-feedback d-block"><?= e($errors['name']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Type</label>
          <select name="holiday_type" class="form-select">
            <?php foreach (['Public', 'Company', 'Optional'] as $t): ?>
              <option value="<?= $t ?>" <?= ($old['holiday_type'] ?? 'Public') === $t ? 'selected' : '' ?>><?= $t ?></option>
            <?php endforeach; ?>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Start Date <span class="text-danger">*</span></label>
          <input type="date" name="start_date" class="form-control <?= isset($errors['start_date']) ? 'is-invalid' : '' ?>" value="<?= old('start_date', $old) ?>">
          <?php if (isset($errors['start_date'])): ?><div class="invalid-feedback d-block"><?= e($errors['start_date']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">End Date</label>
          <input type="date" name="end_date" class="form-control <?= isset($errors['end_date']) ? 'is-invalid' : '' ?>" value="<?= old('end_date', $old) ?>">
          <?php if (isset($errors['end_date'])): ?><div class="invalid-feedback d-block"><?= e($errors['end_date']) ?></div><?php endif; ?>
          <div class="form-text">Leave blank for a single-day holiday.</div>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" rows="2" class="form-control"><?= old('description', $old) ?></textarea>
      </div>

      <div class="form-check mb-3">
        <input type="checkbox" class="form-check-input" id="isPaid" name="is_paid" value="1" <?= ($old === [] || !empty($old['is_paid'])) ? 'checked' : '' ?>>
        <label class="form-check-label" for="isPaid">Paid holiday</label>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Holiday</button>
      <a href="<?= url('/hrm/holidays') ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
