<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Holidays</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/holidays/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/hrm/holidays/create') ?>" data-modal-title="Add Holiday" data-modal-size="md"><i class="mdi mdi-plus"></i> Add Holiday</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/holidays') ?>" class="row g-2 mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="col-md-3">
        <input type="text" name="q" class="form-control" placeholder="Search holidays..." value="<?= e($search) ?>">
      </div>
      <div class="col-md-2">
        <select name="year" class="form-select">
          <option value="">All years</option>
          <?php for ($y = (int) date('Y') + 1; $y >= (int) date('Y') - 3; $y--): ?>
            <option value="<?= $y ?>" <?= $year === $y ? 'selected' : '' ?>><?= $y ?></option>
          <?php endfor; ?>
        </select>
      </div>
      <div class="col-md-2">
        <select name="per_page" class="form-select" onchange="this.form.submit()">
          <?php foreach ([10, 25, 50, 100] as $pp): ?>
            <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary w-100"><i class="mdi mdi-magnify"></i></button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Name', 'name', $_GET, $sort, $dir) ?>
            <?= sortable_th('Type', 'holiday_type', $_GET, $sort, $dir) ?>
            <?= sortable_th('From', 'start_date', $_GET, $sort, $dir) ?>
            <th>To</th><th>Paid</th>
            <?php if (Auth::can('hrm.manage')): ?><th></th><?php endif; ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($holidays)): ?>
            <tr><td colspan="6" class="text-center text-muted py-4">No holidays added yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($holidays as $h): ?>
            <tr>
              <td><?= e($h['name']) ?></td>
              <td><?= e($h['holiday_type']) ?></td>
              <td><?= e(date('d M Y', strtotime($h['start_date']))) ?></td>
              <td><?= e(date('d M Y', strtotime($h['end_date']))) ?></td>
              <td><?= $h['is_paid'] ? 'Yes' : 'No' ?></td>
              <?php if (Auth::can('hrm.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/hrm/holidays/' . $h['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary" data-modal-url="<?= url('/hrm/holidays/' . $h['id'] . '/edit') ?>" data-modal-title="Edit Holiday" data-modal-size="md"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/hrm/holidays/' . $h['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Delete this holiday?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($holidays) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
