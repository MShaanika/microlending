<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Edit Department</h4>

    <form method="post" action="<?= url('/hrm/departments/' . $department['id']) ?>">
      <?= csrf_field() ?>

      <div class="mb-3">
        <label class="form-label">Department Name <span class="text-danger">*</span></label>
        <input type="text" name="department_name" class="form-control <?= isset($errors['department_name']) ? 'is-invalid' : '' ?>" value="<?= e($department['department_name']) ?>">
        <?php if (isset($errors['department_name'])): ?><div class="invalid-feedback d-block"><?= e($errors['department_name']) ?></div><?php endif; ?>
      </div>

      <div class="mb-3">
        <label class="form-label">Branch</label>
        <select name="branch_id" class="form-select">
          <option value="">All branches</option>
          <?php foreach ($branches as $b): ?>
            <option value="<?= (int) $b['id'] ?>" <?= ($department['branch_id'] ?? '') == $b['id'] ? 'selected' : '' ?>><?= e($b['branch_name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Changes</button>
      <a href="<?= url('/hrm/departments') ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
