<?php
use App\Core\Auth;
$t = $transfer;
$statusBadge = ['Pending' => 'warning', 'Approved' => 'success', 'In Progress' => 'info', 'Rejected' => 'danger', 'Cancelled' => 'secondary'][$t['status']] ?? 'secondary';
?>
<?= flash_messages() ?>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h4 class="mb-0"><?= e($t['employee_name']) ?></h4>
    <span class="text-muted"><?= e($t['employee_no']) ?></span>
  </div>
  <span class="badge bg-<?= $statusBadge ?> fs-6"><?= e($t['status']) ?></span>
</div>

<div class="card mb-3">
  <div class="card-body">
    <table class="table table-sm table-borderless mb-0">
      <tr><th class="text-muted" style="width:25%">Effective Date</th><td><?= e(date('d M Y', strtotime($t['effective_date']))) ?></td></tr>
      <tr><th class="text-muted">Transfer Date</th><td><?= $t['transfer_date'] ? e(date('d M Y', strtotime($t['transfer_date']))) : '—' ?></td></tr>
      <tr><th class="text-muted">From</th><td><?= e($t['from_branch_name'] ?: '—') ?> &middot; <?= e($t['from_department_name'] ?: '—') ?> &middot; <?= e($t['from_designation_name'] ?: '—') ?></td></tr>
      <tr><th class="text-muted">To</th><td><?= e($t['to_branch_name'] ?: '—') ?> &middot; <?= e($t['to_department_name'] ?: '—') ?> &middot; <?= e($t['to_designation_name'] ?: '—') ?></td></tr>
      <tr><th class="text-muted">Reason</th><td><?= nl2br(e($t['reason'] ?: '—')) ?></td></tr>
      <?php if ($t['status'] !== 'Pending'): ?>
        <tr><th class="text-muted">Decision By</th><td><?= e($t['approved_by_name'] ?: '—') ?></td></tr>
      <?php endif; ?>
    </table>
  </div>
</div>

<?php if ($t['status'] === 'Pending' && Auth::can('hrm.manage')): ?>
<div class="row">
  <div class="col-md-6 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title text-success">Approve</h5>
        <p class="text-muted small">This will update the employee's branch/department/designation.</p>
        <form method="post" action="<?= url('/hrm/transfers/' . $t['id'] . '/approve') ?>" data-modal-behavior="reload">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-success btn-sm"><i class="mdi mdi-check"></i> Approve</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-md-6 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title text-danger">Reject</h5>
        <form method="post" action="<?= url('/hrm/transfers/' . $t['id'] . '/reject') ?>" data-modal-behavior="reload">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-danger btn-sm"><i class="mdi mdi-close"></i> Reject</button>
        </form>
      </div>
    </div>
  </div>
</div>
<?php endif; ?>

<?php if (Auth::can('hrm.manage')): ?>
<form method="post" action="<?= url('/hrm/transfers/' . $t['id'] . '/delete') ?>" onsubmit="return confirm('Delete this transfer record?');" class="d-inline">
  <?= csrf_field() ?>
  <button type="submit" class="btn btn-outline-danger btn-sm"><i class="mdi mdi-delete"></i> Delete</button>
</form>
<?php endif; ?>
<a href="<?= url('/hrm/transfers') ?>" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Back</a>
