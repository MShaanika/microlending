<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Payroll</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/payrolls/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/hrm/payrolls/create') ?>" data-modal-title="New Payroll Run" data-modal-size="lg"><i class="mdi mdi-plus"></i> New Payroll Run</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/payrolls') ?>" class="row g-2 mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="col-md-4">
        <input type="text" name="q" class="form-control" placeholder="Search title..." value="<?= e($filters['search']) ?>">
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">All statuses</option>
          <?php foreach ($statuses as $s): ?>
            <option value="<?= $s ?>" <?= $filters['status'] === $s ? 'selected' : '' ?>><?= $s ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-3">
        <select name="per_page" class="form-select" onchange="this.form.submit()">
          <?php foreach ([10, 25, 50, 100] as $pp): ?>
            <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100"><i class="mdi mdi-magnify"></i></button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Title', 'title', $_GET, $sort, $dir) ?>
            <?= sortable_th('Period', 'pay_period_start', $_GET, $sort, $dir) ?>
            <?= sortable_th('Frequency', 'frequency', $_GET, $sort, $dir) ?>
            <?= sortable_th('Employees', 'employee_count', $_GET, $sort, $dir) ?>
            <?= sortable_th('Net Pay', 'total_net_pay', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($payrolls)): ?>
            <tr><td colspan="6" class="text-center text-muted py-4">No payroll runs yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($payrolls as $p):
            $statusBadge = ['Draft' => 'secondary', 'Processing' => 'warning', 'Completed' => 'success', 'Cancelled' => 'danger'][$p['status']] ?? 'secondary';
          ?>
            <tr>
              <td><a href="<?= url('/hrm/payrolls/' . $p['id']) ?>" data-modal-url="<?= url('/hrm/payrolls/' . $p['id']) ?>" data-modal-title="<?= e($p['title']) ?>" data-modal-size="xl"><?= e($p['title']) ?></a></td>
              <td><?= e(date('d M Y', strtotime($p['pay_period_start']))) ?> &ndash; <?= e(date('d M Y', strtotime($p['pay_period_end']))) ?></td>
              <td><?= e($p['payroll_frequency']) ?></td>
              <td><?= (int) $p['employee_count'] ?></td>
              <td class="text-end"><?= format_money($p['total_net_pay']) ?></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($p['status']) ?></span></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($payrolls) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
