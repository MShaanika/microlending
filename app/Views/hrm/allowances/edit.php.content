<?php $a = $allowance; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Edit Allowance</h4>
    <p class="text-muted small"><?= e($a['employee_name']) ?> &middot; <?= e($a['type_name']) ?></p>

    <form method="post" action="<?= url('/hrm/allowances/' . $a['id']) ?>">
      <?= csrf_field() ?>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Type</label>
          <select name="type" class="form-select">
            <option value="Fixed" <?= $a['type'] === 'Fixed' ? 'selected' : '' ?>>Fixed Amount (NAD)</option>
            <option value="Percentage" <?= $a['type'] === 'Percentage' ? 'selected' : '' ?>>Percentage of Basic Salary</option>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Amount</label>
          <input type="number" step="0.01" name="amount" class="form-control" value="<?= e($a['amount']) ?>">
        </div>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Changes</button>
      <a href="<?= url('/hrm/allowances') ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
