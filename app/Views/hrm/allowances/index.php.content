<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Employee Allowances</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/allowances/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/hrm/allowances/create') ?>" data-modal-title="Assign Allowance" data-modal-size="lg"><i class="mdi mdi-plus"></i> Assign Allowance</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/allowances') ?>" class="row g-2 mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="col-md-4">
        <input type="text" name="q" class="form-control" placeholder="Search employee or type..." value="<?= e($filters['search']) ?>">
      </div>
      <div class="col-md-4">
        <select name="employee_id" class="form-select">
          <option value="">All employees</option>
          <?php foreach ($employees as $emp): ?>
            <option value="<?= (int) $emp['id'] ?>" <?= (string) $filters['employee_id'] === (string) $emp['id'] ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-3">
        <select name="per_page" class="form-select" onchange="this.form.submit()">
          <?php foreach ([10, 25, 50, 100] as $pp): ?>
            <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary w-100"><i class="mdi mdi-magnify"></i></button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Employee', 'employee', $_GET, $sort, $dir) ?>
            <?= sortable_th('Allowance Type', 'type_name', $_GET, $sort, $dir) ?>
            <?= sortable_th('Type', 'type', $_GET, $sort, $dir) ?>
            <?= sortable_th('Amount', 'amount', $_GET, $sort, $dir) ?>
            <?php if (Auth::can('hrm.manage')): ?><th></th><?php endif; ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($allowances)): ?>
            <tr><td colspan="5" class="text-center text-muted py-4">No allowances assigned yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($allowances as $a): ?>
            <tr>
              <td><?= e($a['employee_name']) ?> <span class="text-muted small">(<?= e($a['employee_no']) ?>)</span></td>
              <td><?= e($a['type_name']) ?></td>
              <td><?= e($a['type']) ?></td>
              <td class="text-end"><?= $a['type'] === 'Percentage' ? number_format((float) $a['amount'], 2) . '%' : format_money($a['amount']) ?></td>
              <?php if (Auth::can('hrm.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/hrm/allowances/' . $a['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary" data-modal-url="<?= url('/hrm/allowances/' . $a['id'] . '/edit') ?>" data-modal-title="Edit Allowance" data-modal-size="md"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/hrm/allowances/' . $a['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Remove this allowance?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($allowances) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
