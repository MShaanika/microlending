<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-1">Employment Contract Templates</h4>
    <p class="text-muted small mb-3">A real .docx template filled in automatically for each employee -- Name, Position, Salary and the term dates come from the employee's own record (or what you type when generating); Duties comes from the employee's Designation (set under HRM &gt; Designations). Edit the base wording by replacing the file below.</p>

    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Name</th><th>Status</th><th>Last Updated</th><th></th></tr></thead>
        <tbody>
          <?php foreach ($templates as $t): ?>
            <tr>
              <td><?= e($t['name']) ?></td>
              <td><span class="badge bg-<?= $t['is_active'] ? 'success' : 'secondary' ?>"><?= $t['is_active'] ? 'Active' : 'Inactive' ?></span></td>
              <td class="small text-muted"><?= e($t['updated_at'] ?? $t['created_at']) ?></td>
              <td style="min-width:320px;">
                <form method="post" action="<?= url('/hrm/employment-contract-templates/' . $t['id'] . '/replace') ?>" enctype="multipart/form-data" class="d-flex gap-2 align-items-center">
                  <?= csrf_field() ?>
                  <input type="file" name="template_file" accept=".docx" class="form-control form-control-sm" required>
                  <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Replace File</button>
                </form>
              </td>
            </tr>
          <?php endforeach; ?>
          <?php if (empty($templates)): ?>
            <tr><td colspan="4" class="text-muted small">No templates yet.</td></tr>
          <?php endif; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
