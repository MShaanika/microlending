<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">New Staff Loan</h4>

    <form method="post" action="<?= url('/hrm/staff-loans') ?>">
      <?= csrf_field() ?>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Employee <span class="text-danger">*</span></label>
          <select name="employee_id" class="form-select <?= isset($errors['employee_id']) ? 'is-invalid' : '' ?>">
            <option value="">Select employee</option>
            <?php foreach ($employees as $emp): ?>
              <option value="<?= (int) $emp['id'] ?>" <?= (($old['employee_id'] ?? '') == $emp['id']) ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
            <?php endforeach; ?>
          </select>
          <?php if (isset($errors['employee_id'])): ?><div class="invalid-feedback d-block"><?= e($errors['employee_id']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Loan Type</label>
          <select name="staff_loan_type_id" class="form-select">
            <option value="">Select type</option>
            <?php foreach ($types as $t): ?>
              <option value="<?= (int) $t['id'] ?>" <?= (($old['staff_loan_type_id'] ?? '') == $t['id']) ? 'selected' : '' ?>><?= e($t['name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Title <span class="text-danger">*</span></label>
        <input type="text" name="title" class="form-control <?= isset($errors['title']) ? 'is-invalid' : '' ?>" value="<?= old('title', $old) ?>" placeholder="e.g. Emergency Salary Advance">
        <?php if (isset($errors['title'])): ?><div class="invalid-feedback d-block"><?= e($errors['title']) ?></div><?php endif; ?>
      </div>

      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Principal Amount (NAD) <span class="text-danger">*</span></label>
          <input type="number" step="0.01" name="principal_amount" class="form-control <?= isset($errors['principal_amount']) ? 'is-invalid' : '' ?>" value="<?= old('principal_amount', $old) ?>">
          <?php if (isset($errors['principal_amount'])): ?><div class="invalid-feedback d-block"><?= e($errors['principal_amount']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Number of Installments <span class="text-danger">*</span></label>
          <input type="number" step="1" min="1" name="number_of_installments" class="form-control <?= isset($errors['number_of_installments']) ? 'is-invalid' : '' ?>" value="<?= old('number_of_installments', $old) ?>">
          <div class="form-text">Interest-free -- split evenly across this many payroll runs.</div>
          <?php if (isset($errors['number_of_installments'])): ?><div class="invalid-feedback d-block"><?= e($errors['number_of_installments']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Start Date <span class="text-danger">*</span></label>
          <input type="date" name="start_date" class="form-control <?= isset($errors['start_date']) ? 'is-invalid' : '' ?>" value="<?= old('start_date', $old) ?>">
          <div class="form-text">First payroll period the deduction can begin.</div>
          <?php if (isset($errors['start_date'])): ?><div class="invalid-feedback d-block"><?= e($errors['start_date']) ?></div><?php endif; ?>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Reason</label>
        <textarea name="reason" rows="3" class="form-control"><?= old('reason', $old) ?></textarea>
      </div>

      <div class="alert alert-info">New staff loans start as <strong>Pending</strong> and only begin deducting from payroll once approved.</div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Staff Loan</button>
      <a href="<?= url('/hrm/staff-loans') ?>" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</a>
    </form>
  </div>
</div>
