<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Staff Loans</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/staff-loans/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> New Staff Loan</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/staff-loans') ?>" class="row g-2 mb-3">
      <div class="col-md-4">
        <select name="employee_id" class="form-select">
          <option value="">All employees</option>
          <?php foreach ($employees as $emp): ?>
            <option value="<?= (int) $emp['id'] ?>" <?= (string) $filters['employee_id'] === (string) $emp['id'] ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">All statuses</option>
          <?php foreach ($statuses as $s): ?>
            <option value="<?= $s ?>" <?= $filters['status'] === $s ? 'selected' : '' ?>><?= $s ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary w-100"><i class="mdi mdi-magnify"></i></button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Employee</th><th>Title</th><th>Type</th><th>Principal</th><th>Installment</th><th>Outstanding</th><th>Status</th></tr>
        </thead>
        <tbody>
          <?php if (empty($loans)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4">No staff loans found.</td></tr>
          <?php endif; ?>
          <?php foreach ($loans as $l):
            $statusBadge = ['Pending' => 'warning', 'Active' => 'success', 'Completed' => 'secondary', 'Cancelled' => 'dark', 'Rejected' => 'danger'][$l['status']] ?? 'secondary';
          ?>
            <tr>
              <td><?= e($l['employee_name']) ?></td>
              <td><a href="<?= url('/hrm/staff-loans/' . $l['id']) ?>"><?= e($l['title']) ?></a></td>
              <td><?= e($l['type_name'] ?: '—') ?></td>
              <td><?= format_money($l['principal_amount']) ?></td>
              <td><?= format_money($l['installment_amount']) ?></td>
              <td><?= format_money($l['outstanding_balance']) ?></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($l['status']) ?></span></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
