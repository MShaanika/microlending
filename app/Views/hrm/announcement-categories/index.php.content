<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Announcement Categories</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/announcement-categories/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Add Category</a>
      <?php endif; ?>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Name</th><?php if (Auth::can('hrm.manage')): ?><th></th><?php endif; ?></tr>
        </thead>
        <tbody>
          <?php if (empty($categories)): ?>
            <tr><td colspan="2" class="text-center text-muted py-4">No announcement categories yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($categories as $c): ?>
            <tr>
              <td><?= e($c['name']) ?></td>
              <?php if (Auth::can('hrm.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/hrm/announcement-categories/' . $c['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/hrm/announcement-categories/' . $c['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Delete this category?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
