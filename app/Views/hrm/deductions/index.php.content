<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Employee Deductions</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/deductions/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Assign Deduction</a>
      <?php endif; ?>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Employee</th><th>Deduction Type</th><th>Type</th><th class="text-end">Amount</th><?php if (Auth::can('hrm.manage')): ?><th></th><?php endif; ?></tr>
        </thead>
        <tbody>
          <?php if (empty($deductions)): ?>
            <tr><td colspan="5" class="text-center text-muted py-4">No deductions assigned yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($deductions as $d): ?>
            <tr>
              <td><?= e($d['employee_name']) ?> <span class="text-muted small">(<?= e($d['employee_no']) ?>)</span></td>
              <td><?= e($d['type_name']) ?></td>
              <td><?= e($d['type']) ?></td>
              <td class="text-end"><?= $d['type'] === 'Percentage' ? number_format((float) $d['amount'], 2) . '%' : format_money($d['amount']) ?></td>
              <?php if (Auth::can('hrm.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/hrm/deductions/' . $d['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/hrm/deductions/' . $d['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Remove this deduction?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
