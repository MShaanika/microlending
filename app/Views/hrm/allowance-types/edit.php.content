<?php $t = $type; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Edit Allowance Type</h4>

    <form method="post" action="<?= url('/hrm/allowance-types/' . $t['id']) ?>">
      <?= csrf_field() ?>

      <div class="mb-3">
        <label class="form-label">Name <span class="text-danger">*</span></label>
        <input type="text" name="name" class="form-control <?= isset($errors['name']) ? 'is-invalid' : '' ?>" value="<?= e($t['name']) ?>">
        <?php if (isset($errors['name'])): ?><div class="invalid-feedback d-block"><?= e($errors['name']) ?></div><?php endif; ?>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" rows="2" class="form-control"><?= e($t['description'] ?? '') ?></textarea>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Changes</button>
      <a href="<?= url('/hrm/allowance-types') ?>" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</a>
    </form>
  </div>
</div>
