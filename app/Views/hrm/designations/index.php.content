<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Designations</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/designations/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/hrm/designations/create') ?>" data-modal-title="Add Designation" data-modal-size="md"><i class="mdi mdi-plus"></i> Add Designation</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/designations') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search designations..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
        <?php foreach ([10, 25, 50, 100] as $pp): ?>
          <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
        <?php endforeach; ?>
      </select>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Designation', 'name', $_GET, $sort, $dir) ?>
            <?= sortable_th('Department', 'department', $_GET, $sort, $dir) ?>
            <?= sortable_th('Branch', 'branch', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <?php if (Auth::can('hrm.manage')): ?><th></th><?php endif; ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($designations)): ?>
            <tr><td colspan="5" class="text-center text-muted py-4">No designations yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($designations as $d): ?>
            <tr>
              <td><?= e($d['designation_name']) ?></td>
              <td><?= e($d['department_name'] ?: '—') ?></td>
              <td><?= e($d['branch_name'] ?: '—') ?></td>
              <td><span class="badge bg-<?= $d['is_active'] ? 'success' : 'secondary' ?>"><?= $d['is_active'] ? 'Active' : 'Inactive' ?></span></td>
              <?php if (Auth::can('hrm.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/hrm/designations/' . $d['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary" data-modal-url="<?= url('/hrm/designations/' . $d['id'] . '/edit') ?>" data-modal-title="Edit Designation" data-modal-size="md"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/hrm/designations/' . $d['id'] . '/toggle-active') ?>" class="d-inline">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-<?= $d['is_active'] ? 'danger' : 'success' ?>">
                    <?= $d['is_active'] ? 'Deactivate' : 'Activate' ?>
                  </button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($designations) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
