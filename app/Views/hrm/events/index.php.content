<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Events</h4>
      <?php if (Auth::can('hrm.manage')): ?>
        <a href="<?= url('/hrm/events/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> New Event</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/hrm/events') ?>" class="row g-2 mb-3">
      <div class="col-md-4">
        <select name="department_id" class="form-select">
          <option value="">All departments</option>
          <?php foreach ($departments as $d): ?>
            <option value="<?= (int) $d['id'] ?>" <?= (string) $filters['department_id'] === (string) $d['id'] ? 'selected' : '' ?>><?= e($d['department_name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">All statuses</option>
          <?php foreach (['Pending', 'Approved', 'Rejected'] as $s): ?>
            <option value="<?= $s ?>" <?= $filters['status'] === $s ? 'selected' : '' ?>><?= $s ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn btn-outline-secondary w-100"><i class="mdi mdi-magnify"></i></button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Title</th><th>Type</th><th>Departments</th><th>Dates</th><th>Location</th><th>Status</th></tr>
        </thead>
        <tbody>
          <?php if (empty($events)): ?>
            <tr><td colspan="6" class="text-center text-muted py-4">No events found.</td></tr>
          <?php endif; ?>
          <?php foreach ($events as $e):
            $statusBadge = ['Pending' => 'warning', 'Approved' => 'success', 'Rejected' => 'danger'][$e['status']] ?? 'secondary';
          ?>
            <tr>
              <td>
                <?php if (!empty($e['color'])): ?><span class="badge" style="background-color: <?= e($e['color']) ?>">&nbsp;</span><?php endif; ?>
                <a href="<?= url('/hrm/events/' . $e['id']) ?>"><?= e($e['title']) ?></a>
              </td>
              <td><?= e($e['event_type_name'] ?: '—') ?></td>
              <td class="text-muted small"><?= e($e['department_names'] ?: '—') ?></td>
              <td><?= e(date('d M Y', strtotime($e['start_date']))) ?> &ndash; <?= e(date('d M Y', strtotime($e['end_date']))) ?></td>
              <td><?= e($e['location']) ?></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($e['status']) ?></span></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
