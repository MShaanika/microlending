<?php
use App\Core\Auth;
$e = $event;
$statusBadge = ['Pending' => 'warning', 'Approved' => 'success', 'Rejected' => 'danger'][$e['status']] ?? 'secondary';
?>
<?= flash_messages() ?>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h4 class="mb-0">
      <?php if (!empty($e['color'])): ?><span class="badge" style="background-color: <?= e($e['color']) ?>">&nbsp;</span><?php endif; ?>
      <?= e($e['title']) ?>
    </h4>
    <span class="text-muted"><?= e($e['event_type_name'] ?: 'General') ?></span>
  </div>
  <span class="badge bg-<?= $statusBadge ?> fs-6"><?= e($e['status']) ?></span>
</div>

<div class="card mb-3">
  <div class="card-body">
    <table class="table table-sm table-borderless mb-0">
      <tr><th class="text-muted" style="width:25%">Dates</th><td><?= e(date('d M Y', strtotime($e['start_date']))) ?> &ndash; <?= e(date('d M Y', strtotime($e['end_date']))) ?></td></tr>
      <tr><th class="text-muted">Time</th><td><?= $e['start_time'] ? e(date('H:i', strtotime($e['start_time']))) : '—' ?> &ndash; <?= $e['end_time'] ? e(date('H:i', strtotime($e['end_time']))) : '—' ?></td></tr>
      <tr><th class="text-muted">Location</th><td><?= e($e['location']) ?></td></tr>
      <tr><th class="text-muted">Departments</th><td><?= !empty($departmentNames) ? e(implode(', ', $departmentNames)) : '—' ?></td></tr>
      <tr><th class="text-muted">Description</th><td><?= nl2br(e($e['description'] ?: '—')) ?></td></tr>
      <?php if ($e['status'] !== 'Pending'): ?>
        <tr><th class="text-muted">Decision By</th><td><?= e($e['approved_by_name'] ?: '—') ?></td></tr>
      <?php endif; ?>
    </table>
  </div>
</div>

<?php if ($e['status'] === 'Pending' && Auth::can('hrm.manage')): ?>
<div class="row">
  <div class="col-md-6 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title text-success">Approve</h5>
        <form method="post" action="<?= url('/hrm/events/' . $e['id'] . '/approve') ?>">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-success btn-sm"><i class="mdi mdi-check"></i> Approve</button>
        </form>
      </div>
    </div>
  </div>
  <div class="col-md-6 mb-3">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title text-danger">Reject</h5>
        <form method="post" action="<?= url('/hrm/events/' . $e['id'] . '/reject') ?>">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-danger btn-sm"><i class="mdi mdi-close"></i> Reject</button>
        </form>
      </div>
    </div>
  </div>
</div>
<?php endif; ?>

<?php if (Auth::can('hrm.manage')): ?>
<form method="post" action="<?= url('/hrm/events/' . $e['id'] . '/delete') ?>" onsubmit="return confirm('Delete this event?');" class="d-inline">
  <?= csrf_field() ?>
  <button type="submit" class="btn btn-outline-danger btn-sm"><i class="mdi mdi-delete"></i> Delete</button>
</form>
<?php endif; ?>
<a href="<?= url('/hrm/events') ?>" class="btn btn-outline-secondary btn-sm">Back</a>
