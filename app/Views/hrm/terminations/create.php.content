<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Record a Termination</h4>

    <form method="post" action="<?= url('/hrm/terminations') ?>">
      <?= csrf_field() ?>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Employee <span class="text-danger">*</span></label>
          <select name="employee_id" class="form-select <?= isset($errors['employee_id']) ? 'is-invalid' : '' ?>">
            <option value="">Select employee</option>
            <?php foreach ($employees as $emp): ?>
              <option value="<?= (int) $emp['id'] ?>" <?= (($old['employee_id'] ?? '') == $emp['id']) ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
            <?php endforeach; ?>
          </select>
          <?php if (isset($errors['employee_id'])): ?><div class="invalid-feedback d-block"><?= e($errors['employee_id']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Termination Type</label>
          <select name="termination_type_id" class="form-select">
            <option value="">Select type</option>
            <?php foreach ($terminationTypes as $t): ?>
              <option value="<?= (int) $t['id'] ?>" <?= (($old['termination_type_id'] ?? '') == $t['id']) ? 'selected' : '' ?>><?= e($t['name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Notice Date</label>
          <input type="date" name="notice_date" class="form-control" value="<?= old('notice_date', $old) ?>">
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Termination Date</label>
          <input type="date" name="termination_date" class="form-control" value="<?= old('termination_date', $old) ?>">
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Reason <span class="text-danger">*</span></label>
        <input type="text" name="reason" class="form-control <?= isset($errors['reason']) ? 'is-invalid' : '' ?>" value="<?= old('reason', $old) ?>">
        <?php if (isset($errors['reason'])): ?><div class="invalid-feedback d-block"><?= e($errors['reason']) ?></div><?php endif; ?>
      </div>

      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" rows="4" class="form-control"><?= old('description', $old) ?></textarea>
      </div>

      <div class="alert alert-warning">Approving this termination will mark the employee's status as <strong>Terminated</strong>.</div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Record Termination</button>
      <a href="<?= url('/hrm/terminations') ?>" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</a>
    </form>
  </div>
</div>
