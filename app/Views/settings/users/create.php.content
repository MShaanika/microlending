<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Add User</h4>

    <!-- autocomplete="off" + readonly/onfocus -- see edit.php.content's own note: autocomplete="off" alone does NOT stop Chrome's Autofill from overwriting these generically-named fields with another saved account's values; readonly at render time (removed the instant a real user focuses the field) is the part Chrome actually respects. -->
    <form method="post" action="<?= url('/settings/users') ?>" autocomplete="off">
      <?= csrf_field() ?>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Full Name <span class="text-danger">*</span></label>
          <input type="text" name="name" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" class="form-control <?= isset($errors['name']) ? 'is-invalid' : '' ?>" value="<?= old('name', $old) ?>">
          <?php if (isset($errors['name'])): ?><div class="invalid-feedback d-block"><?= e($errors['name']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Username <span class="text-danger">*</span></label>
          <input type="text" name="username" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" class="form-control <?= isset($errors['username']) ? 'is-invalid' : '' ?>" value="<?= old('username', $old) ?>">
          <?php if (isset($errors['username'])): ?><div class="invalid-feedback d-block"><?= e($errors['username']) ?></div><?php endif; ?>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Email <span class="text-danger">*</span></label>
          <input type="email" name="email" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" class="form-control <?= isset($errors['email']) ? 'is-invalid' : '' ?>" value="<?= old('email', $old) ?>">
          <?php if (isset($errors['email'])): ?><div class="invalid-feedback d-block"><?= e($errors['email']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Phone</label>
          <input type="text" name="phone" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" class="form-control" value="<?= old('phone', $old) ?>">
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Password <span class="text-danger">*</span></label>
          <div class="input-group">
            <input type="password" name="password" id="newUserPassword" class="form-control <?= isset($errors['password']) ? 'is-invalid' : '' ?>" autocomplete="new-password">
            <button class="btn btn-outline-secondary" type="button" id="toggleNewUserPassword" tabindex="-1" title="Show/hide password"><i class="mdi mdi-eye-outline"></i></button>
            <button class="btn btn-outline-info" type="button" id="generateNewUserPassword" title="Generate a strong password"><i class="mdi mdi-dice-multiple-outline"></i> Generate</button>
          </div>
          <?php if (isset($errors['password'])): ?><div class="invalid-feedback d-block"><?= e($errors['password']) ?></div><?php else: ?><div class="form-text">At least 8 characters. "Generate" fills a strong random one and shows it so you can pass it on to the user.</div><?php endif; ?>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Job Title / Type</label>
          <select name="user_type" class="form-select">
            <?php foreach ($userTypes as $t): ?>
              <option value="<?= e($t) ?>" <?= old('user_type', $old) === $t ? 'selected' : '' ?>><?= e($t) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Branch</label>
          <select name="branch_id" class="form-select">
            <option value="">-- none --</option>
            <?php foreach ($branches as $b): ?>
              <option value="<?= (int) $b['id'] ?>" <?= (string) old('branch_id', $old) === (string) $b['id'] ? 'selected' : '' ?>><?= e($b['branch_name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
      </div>

      <div class="mb-3">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="bypass_ip_restriction" value="1" id="bypassIpRestriction" <?= !empty($old['bypass_ip_restriction']) ? 'checked' : '' ?>>
          <label class="form-check-label" for="bypassIpRestriction">Allow login from anywhere (ignores this user's branch IP restriction)</label>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Roles</label>
        <?php if (isset($errors['role_ids'])): ?><div class="text-danger small mb-1"><?= e($errors['role_ids']) ?></div><?php endif; ?>
        <div class="row">
          <?php foreach ($roles as $r): ?>
            <div class="col-md-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="role_ids[]" value="<?= (int) $r['id'] ?>" id="role<?= (int) $r['id'] ?>" <?= in_array((int) $r['id'], $selectedRoleIds, true) ? 'checked' : '' ?>>
                <label class="form-check-label" for="role<?= (int) $r['id'] ?>"><?= e($r['role_name']) ?></label>
              </div>
            </div>
          <?php endforeach; ?>
        </div>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save User</button>
      <a href="<?= url('/settings/users') ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>

<script src="<?= asset('dist/js/password-tools.js') ?>"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var input = document.getElementById('newUserPassword');
  var toggleBtn = document.getElementById('toggleNewUserPassword');
  var generateBtn = document.getElementById('generateNewUserPassword');
  var icon = toggleBtn ? toggleBtn.querySelector('i') : null;
  var iconClasses = { masked: 'mdi-eye-outline', visible: 'mdi-eye-off-outline' };
  window.PasswordTools.bindToggle(toggleBtn, [input], icon, iconClasses);
  window.PasswordTools.bindGenerate(generateBtn, [input], icon, iconClasses);
});
</script>
