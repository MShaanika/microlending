<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Edit User</h4>

    <!--
      autocomplete="off" alone is NOT load-bearing -- Chrome has ignored it
      for its own Autofill (personal-info) heuristic for years, regardless
      of the attribute's value; it only ever affected the separate Password
      Manager prompt. That's why the 2026-10-13 fix (autocomplete="off"
      everywhere) didn't hold: confirmed again by direct DB query the very
      next day -- every user row still has its own real, distinct
      name/username/email, but the Edit page kept showing one logged-in
      staff member's own saved Autofill values on top of them, and a
      careless Save would silently persist those wrong values onto
      whichever user's row the URL actually pointed at (hence also looking
      like "saves to the wrong user"). The only thing Chrome reliably
      respects: a field marked readonly at render time, which Chrome's
      Autofill engine skips entirely -- onfocus below removes it the
      instant a real user actually interacts with the field, which Chrome
      never simulates. autocomplete="off" is kept as a harmless second
      layer, not the actual fix.
    -->
    <form method="post" action="<?= url('/settings/users/' . $editUser['id']) ?>" autocomplete="off">
      <?= csrf_field() ?>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Full Name <span class="text-danger">*</span></label>
          <input type="text" name="name" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" class="form-control <?= isset($errors['name']) ? 'is-invalid' : '' ?>" value="<?= e($editUser['name']) ?>">
          <?php if (isset($errors['name'])): ?><div class="invalid-feedback d-block"><?= e($errors['name']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Username <span class="text-danger">*</span></label>
          <input type="text" name="username" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" class="form-control <?= isset($errors['username']) ? 'is-invalid' : '' ?>" value="<?= e($editUser['username']) ?>">
          <?php if (isset($errors['username'])): ?><div class="invalid-feedback d-block"><?= e($errors['username']) ?></div><?php endif; ?>
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Email <span class="text-danger">*</span></label>
          <input type="email" name="email" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" class="form-control <?= isset($errors['email']) ? 'is-invalid' : '' ?>" value="<?= e($editUser['email']) ?>">
          <?php if (isset($errors['email'])): ?><div class="invalid-feedback d-block"><?= e($errors['email']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Phone</label>
          <input type="text" name="phone" autocomplete="off" readonly onfocus="this.removeAttribute('readonly')" class="form-control" value="<?= e($editUser['phone'] ?? '') ?>">
        </div>
      </div>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Job Title / Type</label>
          <select name="user_type" class="form-select">
            <?php foreach ($userTypes as $t): ?>
              <option value="<?= e($t) ?>" <?= $editUser['user_type'] === $t ? 'selected' : '' ?>><?= e($t) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Branch</label>
          <select name="branch_id" class="form-select">
            <option value="">-- none --</option>
            <?php foreach ($branches as $b): ?>
              <option value="<?= (int) $b['id'] ?>" <?= (int) $editUser['branch_id'] === (int) $b['id'] ? 'selected' : '' ?>><?= e($b['branch_name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
      </div>

      <div class="mb-3">
        <div class="form-check">
          <input class="form-check-input" type="checkbox" name="bypass_ip_restriction" value="1" id="bypassIpRestriction" <?= !empty($editUser['bypass_ip_restriction']) ? 'checked' : '' ?>>
          <label class="form-check-label" for="bypassIpRestriction">Allow login from anywhere (ignores this user's branch IP restriction)</label>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Roles</label>
        <?php if (isset($errors['role_ids'])): ?><div class="text-danger small mb-1"><?= e($errors['role_ids']) ?></div><?php endif; ?>
        <div class="row">
          <?php foreach ($roles as $r): ?>
            <div class="col-md-4">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" name="role_ids[]" value="<?= (int) $r['id'] ?>" id="role<?= (int) $r['id'] ?>" <?= in_array((int) $r['id'], $selectedRoleIds, true) ? 'checked' : '' ?>>
                <label class="form-check-label" for="role<?= (int) $r['id'] ?>"><?= e($r['role_name']) ?></label>
              </div>
            </div>
          <?php endforeach; ?>
        </div>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Changes</button>
      <a href="<?= url('/settings/users') ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
