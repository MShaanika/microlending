<?= flash_messages() ?>

<?php
  $contacts = $contacts ?? [];
  $loadedContactIds = (string) ($loadedContactIds ?? '');
  $loadedVersion = (string) ($loadedVersion ?? '');
  $canEditBank = (bool) ($canEditBank ?? true); // false = no borrowers.edit_bank: the bank section is shown read-only and ignored on save
  $val = static fn (string $k): string => e((string) ($borrower[$k] ?? ''));
  $err = static function (array $errors, string $k): string {
    return isset($errors[$k]) ? '<div class="invalid-feedback d-block">' . e($errors[$k]) . '</div>' : '';
  };
  $bad = static fn (array $errors, string $k): string => isset($errors[$k]) ? 'is-invalid' : '';
  // One contact row. $i is the position in the list (NOT the database id); the database id travels in a hidden field.
  $renderContact = static function ($i, array $c, array $errors): string {
    $p = 'contacts[' . $i . ']';
    $ek = 'contacts.' . $i . '.';
    $typeOptions = '';
    $types = \App\Services\BorrowerProfileService::CONTACT_TYPES;
    foreach ($types as $t) {
      $typeOptions .= '<option value="' . e($t) . '"' . ((($c['contact_type'] ?? 'Next of Kin') === $t) ? ' selected' : '') . '>' . e($t) . '</option>';
    }
    $field = static function (string $name, string $label, string $type, string $cols) use ($p, $c, $errors, $ek): string {
      $bad = isset($errors[$ek . $name]) ? ' is-invalid' : '';
      $msg = isset($errors[$ek . $name]) ? '<div class="invalid-feedback d-block">' . e($errors[$ek . $name]) . '</div>' : '';
      $max = (int) (\App\Services\BorrowerProfileService::CONTACT_TEXT[$name] ?? 150);
      // the address is a TEXT column that may hold several lines: a textarea keeps the line breaks (a one-line input would flatten them)
      if ($type === 'textarea') {
        return '<div class="' . $cols . ' mb-3"><label class="form-label">' . $label . '</label>'
          . '<textarea maxlength="' . $max . '" name="' . $p . '[' . $name . ']" class="form-control' . $bad . '" rows="1">' . e((string) ($c[$name] ?? '')) . '</textarea>' . $msg . '</div>';
      }
      return '<div class="' . $cols . ' mb-3"><label class="form-label">' . $label . '</label>'
        . '<input type="' . ($type === 'email' ? 'text" inputmode="email' : $type) . '" maxlength="' . $max . '" name="' . $p . '[' . $name . ']" class="form-control' . $bad . '" value="' . e((string) ($c[$name] ?? '')) . '">' . $msg . '</div>';
    };
    $typeBad = isset($errors[$ek . 'contact_type']) ? ' is-invalid' : '';
    $typeMsg = isset($errors[$ek . 'contact_type']) ? '<div class="invalid-feedback d-block">' . e($errors[$ek . 'contact_type']) . '</div>' : '';
    $idMsg = isset($errors[$ek . 'id']) ? '<div class="col-12 text-danger small mb-2">' . e($errors[$ek . 'id']) . '</div>' : '';
    return '<div class="row contact-row border-top pt-3 mt-2">'
      . '<input type="hidden" name="' . $p . '[id]" value="' . e((string) ($c['id'] ?? '')) . '">' . $idMsg
      . '<div class="col-md-2 mb-3"><label class="form-label">Type</label><select name="' . $p . '[contact_type]" class="form-select' . $typeBad . '">' . $typeOptions . '</select>' . $typeMsg . '</div>'
      . $field('full_name', 'Full Name', 'text', 'col-md-3')
      . $field('relationship', 'Relationship', 'text', 'col-md-2')
      . $field('phone', 'Phone', 'text', 'col-md-2')
      . $field('email', 'Email', 'email', 'col-md-2')
      . $field('address', 'Address', 'textarea', 'col-md-11')
      . '<div class="col-md-1 mb-3 d-flex align-items-end"><button type="button" class="btn btn-sm btn-outline-danger remove-contact-btn" title="Remove this contact"><i class="mdi mdi-delete"></i></button></div>'
      . '</div>';
  };
  // a stored value that is not in the standard list (older data) stays selectable, so saving never silently drops it
  $withCurrent = static function (array $options, string $current): array {
    return ($current !== '' && !in_array($current, $options, true)) ? array_merge($options, [$current]) : $options;
  };
?>

