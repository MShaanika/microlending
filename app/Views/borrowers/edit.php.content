        <i class="mdi mdi-plus"></i> Add Contact
      </button>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Update Client</button>
      <a href="<?= url('/borrowers/' . $borrower['id']) ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>

<template id="contact-row-template">
  <?= $renderContact('__INDEX__', ['id' => '', 'contact_type' => 'Next of Kin'], []) ?>
</template>

<script>
(function () {
  var container = document.getElementById('contacts-container');
  var template = document.getElementById('contact-row-template');
  var addBtn = document.getElementById('add-contact-btn');
  var index = container.querySelectorAll('.contact-row').length;

  function wire(row) {
    row.querySelector('.remove-contact-btn').addEventListener('click', function () { row.remove(); });
  }

  container.querySelectorAll('.contact-row').forEach(wire);

  addBtn.addEventListener('click', function () {
    var wrapper = document.createElement('div');
    wrapper.innerHTML = template.innerHTML.replace(/__INDEX__/g, index);
    var row = wrapper.firstElementChild;
    wire(row);
    container.appendChild(row);
    if (typeof window.initSelect2 === 'function') { window.initSelect2(row); }
    index++;
  });
})();
</script>
