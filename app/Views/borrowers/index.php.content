<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
      <h4 class="card-title mb-0">Borrowers</h4>
      <a href="<?= url('/borrowers/create') ?>" class="btn btn-info waves-effect waves-light">
        <i class="mdi mdi-plus"></i> Add Borrower
      </a>
    </div>

    <?php
      $bar = [
          'action' => url('/borrowers'),
          'search' => ['value' => $search ?? '', 'placeholder' => 'Name, phone, ID number, loan ref no'],
          'status' => ['value' => $status ?? '', 'options' => ['Pending', 'Approved', 'Rejected', 'Blacklisted', 'Inactive']],
          'branches' => $branches ?? [], 'branch' => $selectedBranchId ?? null,
          'date' => ['label' => 'Registered', 'from' => $filter['from'] ?? '', 'to' => $filter['to'] ?? ''],
          'export' => true,
      ];
      include __DIR__ . '/../partials/list_filter_bar.php';
    ?>

    <div data-list-results>
    <?php $count = count($borrowers); include __DIR__ . '/../partials/list_count.php'; ?>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Borrower No</th>
            <th>Loan Ref No</th>
            <th>Name</th>
            <th>Phone</th>
            <th>ID Number</th>
            <th>Branch</th>
            <th>Registered</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($borrowers)): ?>
            <tr><td colspan="9" class="text-center text-muted py-4"><?= !empty($filtersActive) ? 'Nothing matches your filters.' : 'No borrowers found.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($borrowers as $b): ?>
            <?php
              $badge = match ($b['status']) {
                'Approved' => 'success',
                'Rejected' => 'danger',
                'Blacklisted' => 'dark',
                'Inactive' => 'secondary',
                default => 'warning',
              };
            ?>
            <tr>
              <td><?= e($b['borrower_no']) ?></td>
              <td><?= $b['loan_ref_no'] ? e($b['loan_ref_no']) : '&mdash;' ?></td>
              <td><?= e(trim($b['first_name'] . ' ' . $b['last_name'])) ?></td>
              <td><?= e($b['phone']) ?></td>
              <td><?= e($b['id_number']) ?></td>
              <td><?= e($b['branch_name']) ?></td>
              <td><?= e(date('d M Y', strtotime($b['created_at']))) ?></td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($b['status']) ?></span></td>
              <td class="text-end">
                <a href="<?= url('/borrowers/' . $b['id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i></a>
                <a href="<?= url('/borrowers/' . $b['id'] . '/edit') ?>" class="btn btn-sm btn-outline-primary"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/borrowers/' . $b['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirmSubmit(this, 'Remove this borrower?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
