<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
      <h4 class="card-title mb-0">Online Loan Applications</h4>
    </div>

    <?php if (!empty($restrictedToSubmitted)): ?>
      <div class="alert alert-info small mb-3">You can only see applications that are still <strong>Submitted</strong> -- acknowledge each one's receipt below.</div>
    <?php endif; ?>

    <form method="get" action="<?= url('/applications') ?>" class="row g-2 mb-3">
      <?php if (empty($restrictedToSubmitted)): ?>
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <?php foreach (['Submitted', 'Screening', 'Documents Required', 'Approved', 'Rejected', 'Converted to Loan', 'Cancelled'] as $s): ?>
            <option value="<?= $s ?>" <?= ($status ?? '') === $s ? 'selected' : '' ?>><?= $s ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <?php endif; ?>
      <?php if (!empty($branches)): ?>
        <div class="col-md-3">
          <select name="branch_id" class="form-select">
            <option value="">All Branches</option>
            <?php foreach ($branches as $b): ?>
              <option value="<?= (int) $b['id'] ?>" <?= (int) ($selectedBranchId ?? 0) === (int) $b['id'] ? 'selected' : '' ?>><?= e($b['branch_name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
      <?php endif; ?>
      <div class="col-md-2 col-6">
        <label class="form-label small mb-0" for="app-from">Received from</label>
        <input type="date" id="app-from" name="from" class="form-control" value="<?= e($dateFrom ?? '') ?>" max="<?= e(date('Y-m-d')) ?>">
      </div>
      <div class="col-md-2 col-6">
        <label class="form-label small mb-0" for="app-to">to</label>
        <input type="date" id="app-to" name="to" class="form-control" value="<?= e($dateTo ?? '') ?>" max="<?= e(date('Y-m-d')) ?>">
      </div>
      <div class="col-md-3 d-flex align-items-end gap-2">
        <button class="btn btn-outline-secondary" type="submit"><i class="mdi mdi-magnify"></i> Filter</button>
        <?php if (($dateFrom ?? '') !== '' || ($dateTo ?? '') !== '' || ($status ?? '') !== '' || !empty($selectedBranchId)): ?>
          <a class="btn btn-link" href="<?= url('/applications') ?>">Clear</a>
        <?php endif; ?>
      </div>
    </form>
    <?php if (($dateFrom ?? '') !== '' || ($dateTo ?? '') !== ''): ?>
      <p class="small text-muted">
        <?= count($applications) ?> application(s) received
        <?= ($dateFrom ?? '') !== '' ? 'from <strong>' . e(date('d M Y', strtotime($dateFrom))) . '</strong>' : 'up to' ?>
        <?= ($dateTo ?? '') !== '' ? (($dateFrom ?? '') !== '' ? 'to' : '') . ' <strong>' . e(date('d M Y', strtotime($dateTo))) . '</strong>' : '' ?>.
      </p>
    <?php endif; ?>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Application No</th><th>Applicant</th><th>Branch</th><th>Source</th><th>Amount</th><th>Term</th><th>Status</th><th>Submitted</th><th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($applications)): ?>
            <tr><td colspan="9" class="text-center text-muted py-4"><?= (($dateFrom ?? '') !== '' || ($dateTo ?? '') !== '') ? 'No applications were received in that period.' : 'No online applications yet.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($applications as $a): ?>
            <?php
              $badge = match ($a['status']) {
                'Approved', 'Converted to Loan' => 'success',
                'Rejected', 'Cancelled' => 'danger',
                'Screening', 'Documents Required' => 'info',
                default => 'warning',
              };
            ?>
            <tr>
              <td><?= e($a['application_no']) ?></td>
              <td>
                <?= e(trim($a['applicant_first_name'] . ' ' . $a['applicant_last_name'])) ?>
                <?php if ($a['borrower_no']): ?><br><small class="text-muted"><?= e($a['borrower_no']) ?></small><?php endif; ?>
              </td>
              <td><?= e($a['branch_name'] ?? '') ?: '<span class="text-muted">Unassigned</span>' ?></td>
              <td><span class="badge bg-secondary"><?= e($a['source_name'] ?: $a['application_source']) ?></span></td>
              <td><?= format_money($a['requested_amount']) ?></td>
              <td><?= (int) $a['requested_term_months'] ?> mo</td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($a['status']) ?></span></td>
              <td><?= e(date('d M Y', strtotime($a['created_at']))) ?></td>
              <td class="text-end">
                <?php if (Auth::can('applications.view')): ?>
                  <a href="<?= url('/applications/' . $a['id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i></a>
                <?php endif; ?>
                <?php if ($a['status'] === 'Submitted' && Auth::can('applications.acknowledge_receipt')): ?>
                  <form method="post" action="<?= url('/applications/' . $a['id'] . '/acknowledge-receipt') ?>" class="d-inline" onsubmit="return confirm('Send an SMS acknowledging receipt of this application?');">
                    <?= csrf_field() ?>
                    <button type="submit" class="btn btn-sm btn-outline-success"><i class="mdi mdi-message-check"></i> Acknowledge Receipt</button>
                  </form>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
