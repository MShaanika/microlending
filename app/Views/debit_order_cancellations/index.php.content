<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Debit Order Cancellations</h4>
      <a href="<?= url('/debit-orders/0/cancel') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Request Cancellation</a>
    </div>

    <?php
      $bar = [
          'action' => url('/debit-order-cancellations'),
          'search' => ['value' => $search ?? '', 'placeholder' => 'Cancellation no, borrower or loan no'],
          'status' => ['value' => $status ?? '', 'options' => ['Pending', 'Approved', 'Rejected', 'Cancelled']],
          'date' => ['label' => 'Requested', 'from' => $filter['from'] ?? '', 'to' => $filter['to'] ?? ''],
          'amount' => ['label' => 'Amount', 'min' => $filter['min'] ?? '', 'max' => $filter['max'] ?? ''],
          'export' => true,
      ];
      include __DIR__ . '/../partials/list_filter_bar.php';
    ?>

    <div data-list-results>
    <?php $count = count($cancellations); include __DIR__ . '/../partials/list_count.php'; ?>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Cancellation No</th><th>Borrower</th><th>Loan</th><th>Amount</th><th>Status</th><th>Requested</th><th class="text-end">Action</th></tr>
        </thead>
        <tbody>
          <?php if (empty($cancellations)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4"><?= !empty($filtersActive) ? 'Nothing matches your filters.' : 'No cancellation requests yet.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($cancellations as $c): ?>
            <?php
              $badge = match ($c['status']) {
                'Approved' => 'success',
                'Rejected', 'Cancelled' => 'danger',
                default => 'warning',
              };
            ?>
            <tr>
              <td><?= e($c['cancellation_no']) ?></td>
              <td><?= e($c['borrower_name']) ?></td>
              <td><?= e($c['loan_no']) ?: '&mdash;' ?></td>
              <td><?= format_money($c['amount_cancelled']) ?></td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($c['status']) ?></span></td>
              <td><?= e(date('d M Y', strtotime($c['created_at']))) ?></td>
              <td class="text-end">
                <a href="<?= url('/debit-order-cancellations/' . $c['id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i></a>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
