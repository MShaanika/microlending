<?= flash_messages() ?>

<div class="row">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title mb-2"><?= e($commission['loan_no']) ?></h4>
        <p class="text-muted mb-3"><?= e($commission['borrower_name']) ?></p>
        <p class="mb-1">Total Interest: <?= format_money($commission['total_interest_amount']) ?></p>
        <p class="mb-1">Rate: <?= e(rtrim(rtrim(number_format((float) $commission['commission_rate'], 4), '0'), '.')) ?>%</p>
        <p class="mb-1">Total Commission: <strong><?= format_money($commission['total_commission_amount']) ?></strong></p>
        <p class="mb-1">Earned: <span class="text-success"><?= format_money($commission['earned_amount']) ?></span></p>
        <p class="mb-1">Paid: <?= format_money($commission['paid_amount']) ?></p>
        <?php if ((float) $commission['forfeited_amount'] > 0): ?>
          <p class="mb-1">Forfeited: <span class="text-danger"><?= format_money($commission['forfeited_amount']) ?></span></p>
        <?php endif; ?>
        <p class="mb-0">Status: <span class="badge bg-<?= commission_status_badge($commission['status']) ?>"><?= e($commission['status']) ?></span></p>
        <?php if (!empty($commission['ineligibility_reason'])): ?>
          <p class="text-muted small mb-0"><?= e($commission['ineligibility_reason']) ?></p>
        <?php endif; ?>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title mb-3">History</h4>
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr><th>Date</th><th>Type</th><th class="text-end">Amount</th><th>Notes</th></tr>
            </thead>
            <tbody>
              <?php if (empty($entries)): ?>
                <tr><td colspan="4" class="text-center text-muted py-4">No activity yet.</td></tr>
              <?php endif; ?>
              <?php foreach ($entries as $e): ?>
                <tr>
                  <td><?= e(date('d M Y', strtotime($e['created_at']))) ?></td>
                  <td><span class="badge bg-<?= $e['entry_type'] === 'Earned' ? 'success' : ($e['entry_type'] === 'Forfeiture' ? 'danger' : 'info') ?>"><?= e($e['entry_type']) ?></span></td>
                  <td class="text-end"><?= format_money($e['amount']) ?></td>
                  <td><?= e($e['notes'] ?? '') ?></td>
                </tr>
              <?php endforeach; ?>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
