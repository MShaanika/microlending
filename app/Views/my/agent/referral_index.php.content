<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">My Referrals</h4>
      <a href="<?= url('/my/referrals/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> New Referral</a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Application No</th><th>Client</th><th>Amount</th><th>Status</th><th>Submitted</th></tr>
        </thead>
        <tbody>
          <?php if (empty($applications)): ?>
            <tr><td colspan="5" class="text-center text-muted py-4">No referrals submitted yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($applications as $a): ?>
            <?php
              $badge = match ($a['status']) {
                'Approved', 'Converted to Loan' => 'success',
                'Rejected', 'Cancelled' => 'danger',
                'Screening', 'Documents Required' => 'info',
                default => 'warning',
              };
            ?>
            <tr>
              <td><?= e($a['application_no']) ?></td>
              <td><?= e(trim($a['applicant_first_name'] . ' ' . $a['applicant_last_name'])) ?></td>
              <td><?= format_money($a['requested_amount']) ?></td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($a['status']) ?></span></td>
              <td><?= e(date('d M Y', strtotime($a['created_at']))) ?></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
