          <p class="text-muted small">Share this link with a client, or fill it out with them -- any application submitted through it is automatically credited to you.</p>
          <div class="input-group mb-2">
            <input type="text" class="form-control" value="<?= e($referralLink) ?>" readonly id="referralLinkInput">
            <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('referralLinkInput').value)"><i class="mdi mdi-content-copy"></i> Copy</button>
          </div>
        <?php else: ?>
          <p class="text-muted">No referral code is set up on your account yet -- ask an administrator to add one.</p>
        <?php endif; ?>
        <a href="<?= url('/my/referrals/create') ?>" class="btn btn-info waves-effect waves-light w-100 mt-2"><i class="mdi mdi-plus"></i> Submit a Referral Myself</a>
      </div>
    </div>
