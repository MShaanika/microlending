            <p class="text-muted mb-1 small">Outstanding</p>
            <h4 class="text-warning"><?= format_money($totals['outstanding']) ?></h4>
          </div>
        </div>
        <a href="<?= url('/my/commissions') ?>" class="btn btn-outline-info btn-sm mt-2">View All Commissions</a>
        <a href="<?= url('/my/referrals/list') ?>" class="btn btn-outline-secondary btn-sm mt-2">Referral History</a>
