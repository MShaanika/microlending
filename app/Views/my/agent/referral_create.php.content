  var container = document.getElementById('contacts-container');
  var template = document.getElementById('contact-row-template');
  var addBtn = document.getElementById('add-contact-btn');
  var index = 0;

  function addRow() {
    var html = template.innerHTML.replace(/__INDEX__/g, index);
    var wrapper = document.createElement('div');
    wrapper.innerHTML = html;
    var row = wrapper.firstElementChild;
    row.querySelector('.remove-contact-btn').addEventListener('click', function () {
      row.remove();
    });
    container.appendChild(row);
    index++;
  }

  addBtn.addEventListener('click', addRow);
})();

(function () {
  var mergedRadio = document.getElementById('bank-stmt-merged');
  var separateRadio = document.getElementById('bank-stmt-separate');
  var mergedWrap = document.getElementById('bank-stmt-merged-wrap');
  var separateWrap = document.getElementById('bank-stmt-separate-wrap');

  function syncBankStatement() {
    mergedWrap.style.display = mergedRadio.checked ? '' : 'none';
    separateWrap.style.display = separateRadio.checked ? '' : 'none';
  }

  mergedRadio.addEventListener('change', syncBankStatement);
  separateRadio.addEventListener('change', syncBankStatement);
  syncBankStatement();
})();

(function () {
  // This form spans 8 tabs, but the browser's native validation (e.g. the
  // Email field's format check) can only focus/report an invalid field
  // that's actually visible -- one sitting in a tab the agent isn't on
  // makes the browser silently refuse to submit with zero feedback,
  // which just reads as "the button doesn't work." Also, uploading
  // several documents on a slow connection takes a real amount of time
  // with no visual change otherwise, which reads the same way -- so once
  // validation passes, show a spinner instead of leaving the button
  // looking inert while the upload is in flight.
  var form = document.getElementById('referral-form');
  var submitBtn = document.getElementById('referral-submit-btn');
  var submitBtnDefaultHtml = submitBtn.innerHTML;

  submitBtn.addEventListener('click', function (e) {
    e.preventDefault();

    if (!form.checkValidity()) {
      var invalid = form.querySelector(':invalid');
      var pane = invalid ? invalid.closest('.tab-pane') : null;
      if (pane && window.bootstrap) {
        var tabBtn = document.getElementById(pane.id + '-btn');
        if (tabBtn) {
          new bootstrap.Tab(tabBtn).show();
        }
      }
      setTimeout(function () {
        if (invalid) invalid.reportValidity();
      }, 150);
      return;
    }

    if (submitBtn.disabled) {
      return;
    }
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Submitting...';
    form.submit();
  });

  // If the browser restores this page from cache after the agent hits
  // "back" (e.g. to fix something after an error), the button must not
  // still be showing the spinner from the previous attempt.
  window.addEventListener('pageshow', function () {
    submitBtn.disabled = false;
    submitBtn.innerHTML = submitBtnDefaultHtml;
  });
})();
</script>
