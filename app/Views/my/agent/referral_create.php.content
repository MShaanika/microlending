      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">ID Number <span class="text-danger">*</span></label>
          <input type="text" name="applicant_id_number" class="form-control <?= isset($errors['applicant_id_number']) ? 'is-invalid' : '' ?>" value="<?= old('applicant_id_number', $old) ?>">
          <?php if (isset($errors['applicant_id_number'])): ?><div class="invalid-feedback d-block"><?= e($errors['applicant_id_number']) ?></div><?php endif; ?>
