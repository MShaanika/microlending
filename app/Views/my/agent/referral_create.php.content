      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Phone Number <span class="text-danger">*</span></label>
          <input type="tel" name="applicant_phone" class="form-control <?= isset($errors['applicant_phone']) ? 'is-invalid' : '' ?>" value="<?= old('applicant_phone', $old) ?>" placeholder="e.g. 081 234 5678">
