<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Apply for Leave</h4>

    <form method="post" action="<?= url('/my/leave') ?>">
      <?= csrf_field() ?>

      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Leave Type <span class="text-danger">*</span></label>
          <select name="leave_type_id" class="form-select <?= isset($errors['leave_type_id']) ? 'is-invalid' : '' ?>">
            <option value="">Select leave type</option>
            <?php foreach ($leaveTypes as $lt): ?>
              <option value="<?= (int) $lt['id'] ?>" <?= (($old['leave_type_id'] ?? '') == $lt['id']) ? 'selected' : '' ?>><?= e($lt['name']) ?> (<?= (int) $lt['max_days_per_year'] ?> days/yr)</option>
            <?php endforeach; ?>
          </select>
          <?php if (isset($errors['leave_type_id'])): ?><div class="invalid-feedback d-block"><?= e($errors['leave_type_id']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Start Date <span class="text-danger">*</span></label>
          <input type="date" name="start_date" class="form-control <?= isset($errors['start_date']) ? 'is-invalid' : '' ?>" value="<?= old('start_date', $old) ?>">
          <?php if (isset($errors['start_date'])): ?><div class="invalid-feedback d-block"><?= e($errors['start_date']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">End Date <span class="text-danger">*</span></label>
          <input type="date" name="end_date" class="form-control <?= isset($errors['end_date']) ? 'is-invalid' : '' ?>" value="<?= old('end_date', $old) ?>">
          <?php if (isset($errors['end_date'])): ?><div class="invalid-feedback d-block"><?= e($errors['end_date']) ?></div><?php endif; ?>
        </div>
      </div>

      <div class="mb-3">
        <label class="form-label">Reason <span class="text-danger">*</span></label>
        <textarea name="reason" rows="3" class="form-control <?= isset($errors['reason']) ? 'is-invalid' : '' ?>"><?= old('reason', $old) ?></textarea>
        <?php if (isset($errors['reason'])): ?><div class="invalid-feedback d-block"><?= e($errors['reason']) ?></div><?php endif; ?>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Submit Application</button>
      <a href="<?= url('/my/leave') ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
