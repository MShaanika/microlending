<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">My Leave Balance</h4>
      <form method="get" action="<?= url('/my/leave/balance') ?>" class="d-flex gap-2">
        <select name="year" class="form-select form-select-sm" onchange="this.form.submit()">
          <?php for ($y = (int) date('Y') + 1; $y >= (int) date('Y') - 3; $y--): ?>
            <option value="<?= $y ?>" <?= $year === $y ? 'selected' : '' ?>><?= $y ?></option>
          <?php endfor; ?>
        </select>
      </form>
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-bordered mb-0">
        <thead class="table-light">
          <tr><th>Leave Type</th><th class="text-end">Entitlement</th><th class="text-end">Used (<?= $year ?>)</th><th class="text-end">Available</th></tr>
        </thead>
        <tbody>
          <?php if (empty($rows)): ?>
            <tr><td colspan="4" class="text-center text-muted py-4">No leave types configured.</td></tr>
          <?php endif; ?>
          <?php foreach ($rows as $r): ?>
            <tr>
              <td><span class="badge" style="background-color: <?= e($r['leave_type_color']) ?>">&nbsp;</span> <?= e($r['leave_type_name']) ?></td>
              <td class="text-end"><?= $r['total_days'] ?></td>
              <td class="text-end"><?= $r['used_days'] ?></td>
              <td class="text-end fw-bold"><?= $r['available_days'] ?></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
