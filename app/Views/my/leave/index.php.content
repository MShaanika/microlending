<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">My Leave</h4>
      <a href="<?= url('/my/leave/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Apply for Leave</a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Leave Type</th><th>From</th><th>To</th><th>Days</th><th>Reason</th><th>Status</th></tr>
        </thead>
        <tbody>
          <?php if (empty($applications)): ?>
            <tr><td colspan="6" class="text-center text-muted py-4">You have not applied for leave yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($applications as $a):
            $statusBadge = ['Pending' => 'warning', 'Approved' => 'success', 'Rejected' => 'danger'][$a['status']] ?? 'secondary';
          ?>
            <tr>
              <td><span class="badge" style="background-color: <?= e($a['leave_type_color']) ?>">&nbsp;</span> <?= e($a['leave_type_name']) ?></td>
              <td><?= e(date('d M Y', strtotime($a['start_date']))) ?></td>
              <td><?= e(date('d M Y', strtotime($a['end_date']))) ?></td>
              <td><?= (int) $a['total_days'] ?></td>
              <td><?= e($a['reason']) ?></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($a['status']) ?></span></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
