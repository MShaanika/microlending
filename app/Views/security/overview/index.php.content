<script src="<?= asset('assets/libs/apexcharts/dist/apexcharts.min.js') ?>"></script>
<script>
(function () {
  var trendData = <?= json_encode($trend) ?>;
  var pollUrl = <?= json_encode(url('/security/overview/poll')) ?>;
  var threatColors = { NORMAL: 'success', ELEVATED: 'info', HIGH: 'warning', CRITICAL: 'danger' };

  new ApexCharts(document.getElementById('trendChart'), {
    chart: { type: 'bar', height: 300, toolbar: { show: false } },
    series: [{ name: 'Failed Logins', data: trendData.map(function (r) { return parseInt(r.total, 10); }) }],
    xaxis: { categories: trendData.map(function (r) { return r.hour_label; }) },
    colors: ['#ff5c75'],
    dataLabels: { enabled: false },
    plotOptions: { bar: { columnWidth: '45%', borderRadius: 4 } },
  }).render();

  function poll() {
    fetch(pollUrl, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) { return; }
        var s = data.stats;
        document.getElementById('statEventsToday').textContent = s.events_today;
        document.getElementById('statFailedLogins').textContent = s.failed_logins_today;
        document.getElementById('statOpenIncidents').textContent = s.open_incidents;
        document.getElementById('statCriticalIncidents').textContent = s.critical_incidents + ' critical';
        document.getElementById('statActiveBlocks').textContent = s.active_blocks;

        var label = document.getElementById('threatLevelLabel');
        label.textContent = s.threat_level;
        var banner = label.closest('.card');
        Object.values(threatColors).forEach(function (c) { banner.classList.remove('bg-' + c); });
        banner.classList.add('bg-' + (threatColors[s.threat_level] || 'secondary'));
      })
      .catch(function () { /* silent -- a failed poll must never disrupt the page */ });
  }

  setInterval(poll, 45000);
})();
</script>
