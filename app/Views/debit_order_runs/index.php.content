<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Debit Order Runs</h4>
      <a href="<?= url('/debit-order-runs/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> New Run</a>
    </div>

    <?php
      $bar = [
          'action' => url('/debit-order-runs'),
          'search' => ['value' => $search ?? '', 'placeholder' => 'Run no or branch'],
          'status' => ['value' => $status ?? '', 'options' => ['Draft', 'Generated', 'Submitted', 'Cancelled']],
          'date' => ['label' => 'Run date', 'from' => $filter['from'] ?? '', 'to' => $filter['to'] ?? ''],
          'amount' => ['label' => 'Total', 'min' => $filter['min'] ?? '', 'max' => $filter['max'] ?? ''],
          'export' => true,
      ];
      include __DIR__ . '/../partials/list_filter_bar.php';
    ?>

    <div data-list-results>
    <?php $count = count($runs); include __DIR__ . '/../partials/list_count.php'; ?>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Run No</th><th>Branch</th><th>Batch Date</th><th>Mandates</th><th>Total Amount</th><th>Status</th><th>Run Date</th><th class="text-end">Action</th></tr>
        </thead>
        <tbody>
          <?php if (empty($runs)): ?>
            <tr><td colspan="8" class="text-center text-muted py-4"><?= !empty($filtersActive) ? 'Nothing matches your filters.' : 'No debit order runs yet.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($runs as $r): ?>
            <?php
              $badge = match ($r['status']) {
                'Submitted' => 'success',
                'Cancelled' => 'danger',
                default => 'warning',
              };
            ?>
            <tr>
              <td><?= e($r['run_no']) ?></td>
              <td><?= e($r['branch_name']) ?></td>
              <td><?= e($r['debit_month']) ?></td>
              <td><?= (int) $r['total_accounts'] ?></td>
              <td><?= format_money($r['total_amount']) ?></td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($r['status']) ?></span></td>
              <td><?= e(date('d M Y', strtotime($r['run_date']))) ?></td>
              <td class="text-end">
                <a href="<?= url('/debit-order-runs/' . $r['id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i></a>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
