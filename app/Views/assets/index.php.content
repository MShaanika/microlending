    <div class="card kpi-card h-100" style="border-left-color:#2bd67b">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h3 class="kpi-number mb-1"><?= format_money($totals['net_book_value']) ?></h3>
            <span class="text-muted small">Total Net Book Value</span>
          </div>
