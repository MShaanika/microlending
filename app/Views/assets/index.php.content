        <div class="d-flex justify-content-between align-items-start">
          <div>
            <h3 class="kpi-number mb-1"><?= format_money($totals['monthly_charge']) ?></h3>
            <span class="text-muted small">Next Month's Depreciation/Amortization</span>
          </div>
