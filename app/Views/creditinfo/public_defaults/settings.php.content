        </div>
        <div class="col-md-3">
          <label class="form-label small">Removal Fee (N$, excl. VAT)</label>
          <input type="number" step="0.01" name="removal_fee" class="form-control form-control-sm" value="<?= e($settings['removal_fee'] ?? '') ?>">
