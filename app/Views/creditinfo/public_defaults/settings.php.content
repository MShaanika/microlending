<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title">Public Defaults Settings</h4>

    <div class="alert alert-info">
      Creditinfo has confirmed in writing: <strong>"We don't have an API for Public Defaults, we have a user interface option and SFTP too."</strong> This module submits through Creditinfo's own User Interface (fully supported below) -- SFTP is prepared for but not yet implemented, pending Creditinfo's technical specification.
    </div>

    <form method="post" action="<?= url('/creditinfo/public-defaults/settings') ?>">
      <?= csrf_field() ?>

      <h5>Module Status</h5>
      <div class="row g-3 mb-4">
        <div class="col-md-4">
          <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="public_defaults_enabled" name="public_defaults_enabled" <?= ($settings['public_defaults_enabled'] ?? 'off') === 'on' ? 'checked' : '' ?>>
            <label class="form-check-label" for="public_defaults_enabled">Public Defaults Enabled</label>
          </div>
        </div>
        <div class="col-md-8">
          <label class="form-label small">Submission Method</label>
          <input type="text" class="form-control form-control-sm" value="Creditinfo User Interface (Manual)" disabled>
