<?= flash_messages() ?>

<div class="alert alert-info"><strong>Submission Method: Creditinfo User Interface (Manual).</strong> Creditinfo has confirmed in writing there is no REST API for Public Defaults -- every submission below was recorded by a staff member after submitting via Creditinfo's own UI.</div>

<div class="card">
  <div class="card-body">
    <h4 class="card-title">Public Default Compliance</h4>
    <div class="row text-center g-3">
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0"><?= (int) $counts['draft'] ?></div><div class="text-muted small">Draft Requests</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0"><?= (int) $counts['pending_approval'] ?></div><div class="text-muted small">Pending Approval</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0"><?= (int) $counts['approved_awaiting_submission'] ?></div><div class="text-muted small">Approved Awaiting Submission</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0"><?= (int) $counts['active_defaults'] ?></div><div class="text-muted small">Active Defaults</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0"><?= (int) $counts['removal_required'] ?></div><div class="text-muted small">Removal Required</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0"><?= (int) $counts['removal_pending'] ?></div><div class="text-muted small">Removal Requests Pending</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0 text-warning-emphasis"><?= (int) $counts['awaiting_confirmation'] ?></div><div class="text-muted small">Awaiting Confirmation</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0"><?= (int) $disputesBlocking ?></div><div class="text-muted small">Active Disputes</div></div></div>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h4 class="card-title">Recent Creditinfo Submissions</h4>
    <p class="text-muted small mb-2">Every row here is a manual submission event a staff member recorded after actually submitting via Creditinfo's own User Interface -- evidence, not an automated API call.</p>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Time</th><th>Reference</th><th>Direction</th><th>Method</th><th>Creditinfo Reference</th><th>Submitted By</th><th>Evidence</th></tr></thead>
        <tbody>
          <?php foreach ($recentSubmissions as $s): ?>
            <tr>
              <td class="small"><?= e(date('d M H:i', strtotime($s['submitted_at']))) ?></td>
              <td class="small"><?= e($s['listing_reference'] ?? '—') ?></td>
              <td class="small"><?= e(ucfirst($s['direction'])) ?></td>
              <td class="small"><?= $s['method'] === 'sftp' ? 'SFTP' : 'Creditinfo UI' ?></td>
              <td class="small"><?= e($s['creditinfo_reference'] ?? '—') ?></td>
              <td class="small"><?= e($s['submitted_by_name'] ?? '—') ?></td>
              <td class="small"><?= !empty($s['evidence_document']) ? 'Yes' : '—' ?></td>
            </tr>
          <?php endforeach; ?>
          <?php if (empty($recentSubmissions)): ?>
            <tr><td colspan="7" class="text-muted small">No submissions recorded yet.</td></tr>
          <?php endif; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
