<?php
$statusBadge = match (true) {
    in_array($pd['status'], ['Listed'], true) => 'success',
    in_array($pd['status'], ['Rejected', 'Cancelled', 'Removal Rejected'], true) => 'danger',
    in_array($pd['status'], ['Removed'], true) => 'dark',
    in_array($pd['status'], ['Removal Required'], true) => 'warning',
    default => 'secondary',
};
?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1">PUBLIC DEFAULT</h4>
        <p class="text-muted small mb-0">Reference: <strong><?= e($pd['listing_reference']) ?></strong></p>
      </div>
      <span class="badge fs-6 bg-<?= $statusBadge ?>"><?= e($pd['status']) ?></span>
    </div>

    <table class="table table-borderless mt-3" style="max-width: 640px;">
      <tbody>
        <tr><td class="text-muted" style="width:200px;">Borrower</td><td><?= e($pd['borrower_name']) ?> (<?= e($pd['borrower_no']) ?>)</td></tr>
        <tr><td class="text-muted">Loan</td><td><?= e($pd['loan_no']) ?></td></tr>
        <tr><td class="text-muted">Original Amount</td><td>N$<?= number_format((float) $pd['original_amount'], 2) ?></td></tr>
        <tr><td class="text-muted">Outstanding Amount</td><td>N$<?= number_format((float) $pd['outstanding_amount'], 2) ?></td></tr>
        <tr><td class="text-muted">Default Date</td><td><?= e(date('d M Y', strtotime($pd['default_date']))) ?></td></tr>
        <tr><td class="text-muted">Days in Arrears (at listing)</td><td><?= (int) $pd['days_in_arrears_at_listing'] ?></td></tr>
      </tbody>
    </table>

    <div class="d-flex gap-2 flex-wrap mb-3">
      <?php if ($pd['status'] === 'Draft'): ?>
        <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/listing/submit-for-review') ?>">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-primary">Submit for Review</button>
        </form>
      <?php endif; ?>

      <?php if ($pd['status'] === 'Pending Review'): ?>
        <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/listing/approve') ?>">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-success">Approve Listing</button>
        </form>
        <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/listing/reject') ?>" onsubmit="var r = prompt('Reason for rejecting this listing:'); if (!r) { return false; } this.querySelector('[name=comments]').value = r; return true;">
          <?= csrf_field() ?>
          <input type="hidden" name="comments" value="">
          <button type="submit" class="btn btn-outline-danger">Reject Listing</button>
        </form>
      <?php endif; ?>

      <?php if ($pd['status'] === 'Submitted via Creditinfo UI'): ?>
        <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/listing/confirm-listed') ?>" onsubmit="return confirm('Confirm this default now actually appears live on Creditinfo?');">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-success">Confirm Listed</button>
        </form>
      <?php endif; ?>

      <?php if ($pd['status'] === 'Removal Pending Review'): ?>
        <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/removal/approve') ?>">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-success">Approve Removal</button>
        </form>
        <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/removal/reject') ?>" onsubmit="var r = prompt('Reason for rejecting this removal:'); if (!r) { return false; } this.querySelector('[name=comments]').value = r; return true;">
          <?= csrf_field() ?>
          <input type="hidden" name="comments" value="">
          <button type="submit" class="btn btn-outline-danger">Reject Removal</button>
        </form>
      <?php endif; ?>

      <?php if ($pd['status'] === 'Removal Submitted via Creditinfo UI'): ?>
        <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/removal/confirm-removed') ?>" onsubmit="return confirm('Confirm this default no longer appears on Creditinfo?');">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-success">Confirm Removed</button>
        </form>
      <?php endif; ?>

      <?php if (in_array($pd['status'], ['Listed', 'Removal Required', 'Removal Rejected'], true)): ?>
        <a href="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/removal/create') ?>" class="btn btn-outline-warning">Create Removal Request</a>
      <?php endif; ?>

      <?php if (in_array($pd['status'], ['Draft', 'Pending Review', 'Awaiting Manual Submission'], true)): ?>
        <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/cancel') ?>" onsubmit="var r = prompt('Reason for cancelling this listing:'); if (r === null) { return false; } this.querySelector('[name=reason]').value = r; return true;">
          <?= csrf_field() ?>
          <input type="hidden" name="reason" value="">
          <button type="submit" class="btn btn-outline-secondary">Cancel Listing</button>
        </form>
      <?php endif; ?>

      <a href="<?= url('/creditinfo/public-defaults') ?>" class="btn btn-outline-secondary">Back to Dashboard</a>
    </div>

    <?php if ($pd['status'] === 'Awaiting Manual Submission'): ?>
      <div class="alert alert-warning">
        <strong>Awaiting Manual Submission</strong> -- log into Creditinfo's own User Interface and submit this listing there, then record the submission below. There is no automated API call for this (Creditinfo has confirmed none exists for Public Defaults).
      </div>
      <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/listing/record-submission') ?>" enctype="multipart/form-data" class="row g-2 mb-3">
        <?= csrf_field() ?>
        <div class="col-md-3"><input type="text" name="creditinfo_reference" class="form-control form-control-sm" placeholder="Creditinfo reference (if available)"></div>
        <div class="col-md-4"><input type="text" name="notes" class="form-control form-control-sm" placeholder="Notes"></div>
        <div class="col-md-3"><input type="file" name="evidence_document" class="form-control form-control-sm"></div>
        <div class="col-md-2"><button type="submit" class="btn btn-sm btn-warning text-dark w-100">Record Submission</button></div>
      </form>
    <?php endif; ?>

    <?php if ($pd['status'] === 'Awaiting Manual Removal Submission'): ?>
      <div class="alert alert-warning">
        <strong>Awaiting Manual Removal Submission</strong> -- submit the removal via Creditinfo's own User Interface, then record it below.
      </div>
      <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/removal/record-submission') ?>" enctype="multipart/form-data" class="row g-2 mb-3">
        <?= csrf_field() ?>
        <div class="col-md-3"><input type="text" name="creditinfo_reference" class="form-control form-control-sm" placeholder="Creditinfo reference (if available)"></div>
        <div class="col-md-4"><input type="text" name="notes" class="form-control form-control-sm" placeholder="Notes"></div>
        <div class="col-md-3"><input type="file" name="evidence_document" class="form-control form-control-sm"></div>
        <div class="col-md-2"><button type="submit" class="btn btn-sm btn-warning text-dark w-100">Record Submission</button></div>
      </form>
    <?php endif; ?>
  </div>
</div>

