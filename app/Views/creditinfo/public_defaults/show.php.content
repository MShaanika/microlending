<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Creditinfo Submissions</h5>
    <p class="text-muted small">Evidence of every manual (or, once built, SFTP) submission to Creditinfo -- who, when, what reference, and any supporting document.</p>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Date</th><th>Direction</th><th>Method</th><th>Reference</th><th>Submitted By</th><th>Notes</th><th>Evidence</th></tr></thead>
        <tbody>
          <?php foreach ($submissions as $s): ?>
            <tr>
              <td class="small"><?= e(date('d M Y H:i', strtotime($s['submitted_at']))) ?></td>
              <td class="small"><?= e(ucfirst($s['direction'])) ?></td>
              <td class="small"><?= $s['method'] === 'sftp' ? 'SFTP' : 'Creditinfo UI' ?></td>
              <td class="small"><?= e($s['creditinfo_reference'] ?? '—') ?></td>
              <td class="small"><?= e($s['submitted_by_name'] ?? '—') ?></td>
              <td class="small"><?= e($s['notes'] ?? '—') ?></td>
              <td class="small"><?php if (!empty($s['evidence_document'])): ?><a href="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/submissions/' . $s['id'] . '/download') ?>">Download</a><?php else: ?>—<?php endif; ?></td>
            </tr>
          <?php endforeach; ?>
          <?php if (empty($submissions)): ?>
            <tr><td colspan="7" class="text-muted small">No submission recorded yet.</td></tr>
          <?php endif; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Borrower Notice / Evidence</h5>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Date</th><th>Method</th><th>Reference</th><th>Sent By</th><th>Document</th></tr></thead>
        <tbody>
          <?php foreach ($notices as $n): ?>
            <tr>
              <td class="small"><?= $n['notice_date'] ? e(date('d M Y', strtotime($n['notice_date']))) : '—' ?></td>
              <td class="small"><?= e($n['notice_method'] ?? '—') ?></td>
              <td class="small"><?= e($n['notice_reference'] ?? '—') ?></td>
              <td class="small"><?= e($n['notice_sent_by_name'] ?? '—') ?></td>
              <td class="small"><?php if (!empty($n['notice_document'])): ?><a href="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/notices/' . $n['id'] . '/download') ?>">Download</a><?php else: ?>—<?php endif; ?></td>
            </tr>
          <?php endforeach; ?>
          <?php if (empty($notices)): ?>
            <tr><td colspan="5" class="text-muted small">No notice recorded yet.</td></tr>
          <?php endif; ?>
        </tbody>
      </table>
    </div>

    <form method="post" action="<?= url('/creditinfo/public-defaults/' . $pd['id'] . '/notice') ?>" enctype="multipart/form-data" class="row g-2 mt-2">
      <?= csrf_field() ?>
      <div class="col-md-3">
        <select name="notice_method" class="form-select form-select-sm">
          <option value="">— Method —</option>
          <?php foreach (['SMS','Email','Letter','WhatsApp','Hand Delivered','Other'] as $m): ?>
            <option value="<?= e($m) ?>"><?= e($m) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-2"><input type="date" name="notice_date" class="form-control form-control-sm"></div>
      <div class="col-md-3"><input type="text" name="notice_reference" class="form-control form-control-sm" placeholder="Reference"></div>
      <div class="col-md-2"><input type="file" name="notice_document" class="form-control form-control-sm"></div>
      <div class="col-md-2"><button type="submit" class="btn btn-sm btn-outline-primary w-100">Record Notice</button></div>
    </form>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">AUDIT TRAIL</h5>
    <ul class="list-unstyled mb-0">
      <?php foreach ($timeline as $t): ?>
        <li class="mb-2 pb-2 border-bottom">
          <strong><?= e($t['action']) ?></strong>
          <?php if ($t['old_status'] || $t['new_status']): ?><span class="text-muted small">(<?= e($t['old_status'] ?? '—') ?> → <?= e($t['new_status'] ?? '—') ?>)</span><?php endif; ?>
          <br>
          <span class="text-muted small"><?= e($t['actor_name'] ?? 'System') ?> &mdash; <?= e(date('d M Y H:i', strtotime($t['created_at']))) ?></span>
          <?php if ($t['reason']): ?><br><span class="small"><?= e($t['reason']) ?></span><?php endif; ?>
        </li>
      <?php endforeach; ?>
      <?php if (empty($timeline)): ?>
        <li class="text-muted small">No actions recorded yet.</li>
      <?php endif; ?>
    </ul>
  </div>
</div>
