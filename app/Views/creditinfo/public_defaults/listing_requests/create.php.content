<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title">Create Public Default Listing Request</h4>

    <table class="table table-borderless" style="max-width: 560px;">
      <tbody>
        <tr><td class="text-muted" style="width:200px;">Borrower</td><td><?= e($borrower['first_name'] . ' ' . $borrower['last_name']) ?></td></tr>
        <tr><td class="text-muted">Loan</td><td><?= e($loan['loan_no']) ?></td></tr>
        <tr><td class="text-muted">Outstanding Balance</td><td>N$<?= number_format($result['outstanding_balance'], 2) ?></td></tr>
        <tr><td class="text-muted">Days in Arrears</td><td><?= (int) $result['days_in_arrears'] ?></td></tr>
        <tr><td class="text-muted">Eligibility</td><td><span class="badge bg-<?= $result['eligibility_status'] === 'Eligible' ? 'success' : 'warning text-dark' ?>"><?= e($result['eligibility_status']) ?></span></td></tr>
      </tbody>
    </table>

    <?php if (!empty($result['provisional_reasons'])): ?>
      <div class="alert alert-warning small">This listing proceeds under thresholds still <strong>Requires Compliance Confirmation</strong>: <?= e(implode(' ', $result['provisional_reasons'])) ?></div>
    <?php endif; ?>

    <form method="post" action="<?= url('/creditinfo/public-defaults/listings') ?>" enctype="multipart/form-data">
      <?= csrf_field() ?>
      <input type="hidden" name="loan_id" value="<?= (int) $loan['id'] ?>">

      <div class="mb-3">
        <label class="form-label">Listing Reason <span class="text-danger">*</span></label>
        <textarea name="listing_reason" class="form-control <?= isset($errors['listing_reason']) ? 'is-invalid' : '' ?>" rows="3" required><?= old('listing_reason') ?></textarea>
        <?php if (isset($errors['listing_reason'])): ?><div class="invalid-feedback"><?= e($errors['listing_reason']) ?></div><?php endif; ?>
      </div>

      <h6>Borrower Notice / Evidence (item 8 -- optional at this stage, can be added later)</h6>
      <div class="row g-2 mb-3">
        <div class="col-md-4">
          <label class="form-label small">Notice Method</label>
          <select name="notice_method" class="form-select form-select-sm">
            <option value="">— Not yet sent —</option>
            <?php foreach (['SMS','Email','Letter','WhatsApp','Hand Delivered','Other'] as $m): ?>
              <option value="<?= e($m) ?>"><?= e($m) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small">Notice Date</label>
          <input type="date" name="notice_date" class="form-control form-control-sm">
        </div>
        <div class="col-md-3">
          <label class="form-label small">Notice Reference</label>
          <input type="text" name="notice_reference" class="form-control form-control-sm">
        </div>
        <div class="col-md-2">
          <label class="form-label small">Document</label>
          <input type="file" name="notice_document" class="form-control form-control-sm">
        </div>
      </div>

      <button type="submit" class="btn btn-primary">Save as Draft</button>
      <a href="<?= url('/creditinfo/public-defaults/eligibility/' . $loan['id']) ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
