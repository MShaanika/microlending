<?= flash_messages() ?>

<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1"><?= e(ucfirst($direction)) ?> Submission Batches</h4>
        <p class="text-muted small mb-0">Generates the pipe-delimited file Creditinfo requires for a batch of <?= $direction === 'listing' ? 'Awaiting Manual Submission' : 'Awaiting Manual Removal Submission' ?> records. A second person must approve the generated file before it can be downloaded and uploaded to Creditinfo -- there is no automated upload here.</p>
      </div>
      <span class="badge bg-<?= $environment === 'live' ? 'danger' : 'secondary' ?>">Environment: <?= e(strtoupper($environment)) ?></span>
    </div>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <h5 class="card-title">Eligible Records</h5>
    <?php if (empty($eligible)): ?>
      <p class="text-muted small mb-0">No records currently <?= $direction === 'listing' ? 'Awaiting Manual Submission' : 'Awaiting Manual Removal Submission' ?> and not already in an open batch.</p>
    <?php else: ?>
      <form method="post" action="<?= url('/creditinfo/public-defaults/batches/' . $direction . '/generate') ?>" id="generateBatchForm">
        <?= csrf_field() ?>

        <div class="table-responsive mb-3">
          <table class="table table-sm">
            <thead>
              <tr>
                <th><input type="checkbox" id="checkAll" checked></th>
                <th>Reference</th><th>Borrower</th><th>Loan</th><th>Outstanding</th><th>Default Status Category</th>
              </tr>
            </thead>
            <tbody>
              <?php foreach ($eligible as $r): ?>
                <tr>
                  <td><input type="checkbox" name="public_default_ids[]" value="<?= (int) $r['id'] ?>" checked></td>
                  <td><a href="<?= url('/creditinfo/public-defaults/' . $r['id']) ?>" target="_blank"><?= e($r['listing_reference']) ?></a></td>
                  <td><?= e($r['borrower_name']) ?></td>
                  <td><?= e($r['loan_no']) ?></td>
                  <td>N$<?= number_format((float) $r['outstanding_amount'], 2) ?></td>
                  <td><?= e($r['default_status_category'] ?? '—') ?></td>
                </tr>
              <?php endforeach; ?>
            </tbody>
          </table>
        </div>

        <div class="row g-2 align-items-end">
          <div class="col-auto">
            <label class="form-label small">Environment</label><br>
            <div class="btn-group" role="group">
              <input type="radio" class="btn-check" name="environment" id="envTest" value="test" checked>
              <label class="btn btn-outline-secondary btn-sm" for="envTest">Test</label>
              <input type="radio" class="btn-check" name="environment" id="envLive" value="live" <?= $environment !== 'live' ? 'disabled' : '' ?>>
              <label class="btn btn-outline-danger btn-sm" for="envLive">Live</label>
            </div>
            <?php if ($environment !== 'live'): ?>
              <div class="form-text">Live is locked until an administrator switches the Public Defaults environment setting.</div>
            <?php endif; ?>
          </div>
          <div class="col-auto">
            <button type="submit" class="btn btn-primary">Generate Submission File</button>
          </div>
        </div>
      </form>
      <script>
        document.getElementById('checkAll').addEventListener('change', function () {
          document.querySelectorAll('#generateBatchForm input[name="public_default_ids[]"]').forEach(cb => cb.checked = this.checked);
        });
      </script>
    <?php endif; ?>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <h5 class="card-title">Recent Batches</h5>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Reference</th><th>Environment</th><th>Records</th><th>Status</th><th>Generated By</th><th>Generated At</th><th></th></tr></thead>
        <tbody>
          <?php foreach ($batches as $b): ?>
            <?php $badge = match ($b['status']) {
              'Approved', 'Downloaded' => 'info',
              'Marked Submitted' => 'success',
              'Rejected' => 'danger',
              default => 'secondary',
            }; ?>
            <tr>
              <td><a href="<?= url('/creditinfo/public-defaults/batches/' . $direction . '/' . $b['id']) ?>"><?= e($b['batch_reference']) ?></a></td>
              <td><span class="badge bg-<?= $b['environment'] === 'live' ? 'danger' : 'secondary' ?>"><?= e(strtoupper($b['environment'])) ?></span></td>
              <td><?= (int) $b['record_count'] ?></td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($b['status']) ?></span></td>
              <td><?= e($b['generated_by_name'] ?? '—') ?></td>
              <td class="small"><?= e(date('d M Y H:i', strtotime($b['generated_at']))) ?></td>
              <td><a href="<?= url('/creditinfo/public-defaults/batches/' . $direction . '/' . $b['id']) ?>" class="btn btn-sm btn-outline-secondary">View</a></td>
            </tr>
          <?php endforeach; ?>
          <?php if (empty($batches)): ?>
            <tr><td colspan="7" class="text-muted small">No batches generated yet.</td></tr>
          <?php endif; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
