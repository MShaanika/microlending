<?php
$statusBadge = match ($batch['status']) {
    'Approved', 'Downloaded' => 'info',
    'Marked Submitted' => 'success',
    'Rejected' => 'danger',
    default => 'secondary',
};
?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1">SUBMISSION BATCH</h4>
        <p class="text-muted small mb-0">Reference: <strong><?= e($batch['batch_reference']) ?></strong> &middot; <?= e(ucfirst($direction)) ?></p>
      </div>
      <div class="text-end">
        <span class="badge fs-6 bg-<?= $batch['environment'] === 'live' ? 'danger' : 'secondary' ?>"><?= e(strtoupper($batch['environment'])) ?></span>
        <span class="badge fs-6 bg-<?= $statusBadge ?>"><?= e($batch['status']) ?></span>
      </div>
    </div>

    <table class="table table-borderless mt-3" style="max-width: 640px;">
      <tbody>
        <tr><td class="text-muted" style="width:200px;">Filename</td><td><code><?= e($batch['filename']) ?></code></td></tr>
        <tr><td class="text-muted">Records</td><td><?= (int) $batch['record_count'] ?></td></tr>
        <tr><td class="text-muted">Generated By</td><td><?= e($batch['generated_by_name'] ?? '—') ?> — <?= e(date('d M Y H:i', strtotime($batch['generated_at']))) ?></td></tr>
        <tr><td class="text-muted">Reviewed By</td><td><?= $batch['reviewed_by_name'] ? e($batch['reviewed_by_name']) . ' — ' . e(date('d M Y H:i', strtotime($batch['reviewed_at']))) : '—' ?></td></tr>
        <?php if ($batch['review_comments']): ?>
          <tr><td class="text-muted">Review Comments</td><td><?= e($batch['review_comments']) ?></td></tr>
        <?php endif; ?>
        <tr><td class="text-muted">Downloaded By</td><td><?= $batch['downloaded_by_name'] ? e($batch['downloaded_by_name']) . ' — ' . e(date('d M Y H:i', strtotime($batch['downloaded_at']))) : '—' ?></td></tr>
        <tr><td class="text-muted">Marked Submitted By</td><td><?= $batch['marked_submitted_by_name'] ? e($batch['marked_submitted_by_name']) . ' — ' . e(date('d M Y H:i', strtotime($batch['marked_submitted_at']))) : '—' ?></td></tr>
      </tbody>
    </table>

    <div class="d-flex gap-2 flex-wrap mb-3">
      <?php if ($batch['status'] === 'Pending Review'): ?>
        <form method="post" action="<?= url('/creditinfo/public-defaults/batches/' . $direction . '/' . $batch['id'] . '/approve') ?>">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-success">Approve Batch</button>
        </form>
        <form method="post" action="<?= url('/creditinfo/public-defaults/batches/' . $direction . '/' . $batch['id'] . '/reject') ?>" onsubmit="var r = prompt('Reason for rejecting this batch:'); if (!r) { return false; } this.querySelector('[name=comments]').value = r; return true;">
          <?= csrf_field() ?>
          <input type="hidden" name="comments" value="">
          <button type="submit" class="btn btn-outline-danger">Reject Batch</button>
        </form>
      <?php endif; ?>

      <?php if (in_array($batch['status'], ['Approved', 'Downloaded', 'Marked Submitted'], true)): ?>
        <a href="<?= url('/creditinfo/public-defaults/batches/' . $direction . '/' . $batch['id'] . '/download') ?>" class="btn btn-primary">Download File</a>
      <?php endif; ?>

      <?php if (in_array($batch['status'], ['Approved', 'Downloaded'], true)): ?>
        <?php if ($sftpReady): ?>
          <form method="post" action="<?= url('/creditinfo/public-defaults/batches/' . $direction . '/' . $batch['id'] . '/submit-sftp') ?>" onsubmit="return confirm('This uploads <?= e($batch['filename']) ?> directly to Creditinfo\'s SFTP inbound folder right now. Continue?');">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-success">Submit via SFTP</button>
          </form>
        <?php else: ?>
          <button type="button" class="btn btn-success" disabled title="SFTP isn't configured/enabled yet -- set host, username, secret and outbound folder, and switch SFTP on, in Public Defaults Settings.">Submit via SFTP</button>
        <?php endif; ?>
      <?php endif; ?>

      <a href="<?= url('/creditinfo/public-defaults/batches/' . $direction) ?>" class="btn btn-outline-secondary">Back to <?= e(ucfirst($direction)) ?> Batches</a>
    </div>

    <?php if ($batch['status'] === 'Downloaded'): ?>
      <div class="alert alert-warning">
        <strong>Downloaded</strong> -- once you've uploaded <code><?= e($batch['filename']) ?></code> via Creditinfo's own SFTP client, record it below. Every record in this batch will move to "Submitted via Creditinfo UI" (or the removal equivalent) -- confirm each one Listed/Removed individually afterward, same as the manual-UI workflow.
      </div>
      <form method="post" action="<?= url('/creditinfo/public-defaults/batches/' . $direction . '/' . $batch['id'] . '/mark-submitted') ?>" class="row g-2 mb-3">
        <?= csrf_field() ?>
        <div class="col-md-4"><input type="text" name="creditinfo_reference" class="form-control form-control-sm" placeholder="Creditinfo reference (if available)"></div>
        <div class="col-md-5"><input type="text" name="notes" class="form-control form-control-sm" placeholder="Notes"></div>
        <div class="col-md-3"><button type="submit" class="btn btn-sm btn-warning text-dark w-100">Mark Batch Submitted</button></div>
      </form>
    <?php endif; ?>

    <?php if ($batch['status'] === 'Rejected'): ?>
      <div class="alert alert-secondary small mb-0">This batch's records were never removed from their own queue -- they're available to include in a new batch.</div>
    <?php endif; ?>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Records in this Batch (<?= count($items) ?>)</h5>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>#</th><th>Reference</th><th>Borrower</th><th>Loan</th><th>Current Status</th></tr></thead>
        <tbody>
          <?php foreach ($items as $i): ?>
            <tr>
              <td><?= (int) $i['line_number'] ?></td>
              <td><a href="<?= url('/creditinfo/public-defaults/' . $i['public_default_id']) ?>" target="_blank"><?= e($i['listing_reference']) ?></a></td>
              <td><?= e($i['borrower_name']) ?></td>
              <td><?= e($i['loan_no']) ?></td>
              <td><span class="badge bg-secondary"><?= e($i['public_default_status']) ?></span></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Rendered File Preview</h5>
    <p class="text-muted small">Exactly what was written to <code><?= e($batch['filename']) ?></code> -- review this carefully before approving; it is what a checker is approving.</p>
    <pre class="small bg-body-secondary p-2" style="overflow-x:auto; white-space:pre;"><?php foreach ($items as $i): ?><?= e($i['rendered_line']) ?>
<?php endforeach; ?></pre>
  </div>
</div>
