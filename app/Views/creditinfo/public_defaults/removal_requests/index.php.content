<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title">Public Default Removal Requests</h4>

    <form method="get" class="d-flex gap-2 mb-3">
      <select name="status" class="form-select form-select-sm" style="max-width:260px;" onchange="this.form.submit()">
        <option value="">All removal statuses</option>
        <?php foreach (['Removal Required','Removal Pending Review','Awaiting Manual Removal Submission','Removal Submitted via Creditinfo UI','Removed','Removal Rejected'] as $s): ?>
          <option value="<?= e($s) ?>" <?= $status === $s ? 'selected' : '' ?>><?= e($s) ?></option>
        <?php endforeach; ?>
      </select>
    </form>

    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Reference</th><th>Borrower</th><th>Loan</th><th>Reason</th><th>Status</th><th>Requested By</th><th>Requested At</th><th></th></tr></thead>
        <tbody>
          <?php foreach ($result['rows'] as $r): ?>
            <tr>
              <td><a href="<?= url('/creditinfo/public-defaults/' . $r['id']) ?>"><?= e($r['listing_reference']) ?></a></td>
              <td><?= e($r['borrower_name']) ?></td>
              <td><?= e($r['loan_no']) ?></td>
              <td class="small"><?= e($r['removal_reason_category'] ?? '—') ?></td>
              <td><span class="badge bg-secondary"><?= e($r['status']) ?></span></td>
              <td><?= e($r['removal_requested_by_name'] ?? '—') ?></td>
              <td class="small"><?= $r['removal_requested_at'] ? e(date('d M Y', strtotime($r['removal_requested_at']))) : '—' ?></td>
              <td><a href="<?= url('/creditinfo/public-defaults/' . $r['id']) ?>" class="btn btn-sm btn-outline-secondary">View</a></td>
            </tr>
          <?php endforeach; ?>
          <?php if (empty($result['rows'])): ?>
            <tr><td colspan="8" class="text-muted small">No removal requests found.</td></tr>
          <?php endif; ?>
        </tbody>
      </table>
    </div>

    <?php if ($result['totalPages'] > 1): ?>
      <nav><ul class="pagination pagination-sm">
        <?php for ($p = 1; $p <= $result['totalPages']; $p++): ?>
          <li class="page-item <?= $p == ($_GET['page'] ?? 1) ? 'active' : '' ?>"><a class="page-link" href="?page=<?= $p ?>&status=<?= urlencode($status) ?>"><?= $p ?></a></li>
        <?php endfor; ?>
      </ul></nav>
    <?php endif; ?>
  </div>
</div>
