<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <h4 class="card-title">Active Public Defaults Register</h4>
      <a href="<?= url('/creditinfo/public-defaults/register/export?' . http_build_query($filters)) ?>" class="btn btn-outline-secondary btn-sm">Export CSV</a>
    </div>
    <p class="text-muted small">Internal operational records only -- never a raw Creditinfo response (none exists yet; see the compliance dashboard).</p>

    <form method="get" class="row g-2 mb-3">
      <div class="col-auto">
        <select name="status" class="form-select form-select-sm">
          <option value="">All active statuses</option>
          <?php foreach (['Listed','Removal Required','Removal Pending Review','Removal Approved','Awaiting API Removal','Removal Submitted'] as $s): ?>
            <option value="<?= e($s) ?>" <?= ($filters['status'] ?? '') === $s ? 'selected' : '' ?>><?= e($s) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-auto"><input type="number" name="amount_min" class="form-control form-control-sm" placeholder="Amount from" value="<?= e($filters['amount_min'] ?? '') ?>"></div>
      <div class="col-auto"><input type="number" name="amount_max" class="form-control form-control-sm" placeholder="Amount to" value="<?= e($filters['amount_max'] ?? '') ?>"></div>
      <div class="col-auto"><input type="number" name="days_in_arrears_min" class="form-control form-control-sm" placeholder="Min days in arrears" value="<?= e($filters['days_in_arrears_min'] ?? '') ?>"></div>
      <div class="col-auto"><input type="date" name="listed_from" class="form-control form-control-sm" value="<?= e($filters['listed_from'] ?? '') ?>"></div>
      <div class="col-auto"><input type="date" name="listed_to" class="form-control form-control-sm" value="<?= e($filters['listed_to'] ?? '') ?>"></div>
      <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-primary">Filter</button></div>
    </form>

    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Reference</th><th>Borrower</th><th>Loan</th><th>ID Number</th><th>Default Date</th><th>Outstanding</th><th>Listing Date</th><th>Status</th><th>Creditinfo Ref</th><th></th></tr></thead>
        <tbody>
          <?php foreach ($result['rows'] as $r): ?>
            <tr>
              <td><a href="<?= url('/creditinfo/public-defaults/' . $r['id']) ?>"><?= e($r['listing_reference']) ?></a></td>
              <td><?= e($r['borrower_name']) ?></td>
              <td><?= e($r['loan_no']) ?></td>
              <td class="small"><?= e(substr((string) $r['id_number'], 0, 4)) ?>••••••</td>
              <td class="small"><?= e(date('d M Y', strtotime($r['default_date']))) ?></td>
              <td>N$<?= number_format((float) $r['outstanding_amount'], 2) ?></td>
              <td class="small"><?= $r['listed_at'] ? e(date('d M Y', strtotime($r['listed_at']))) : '—' ?></td>
              <td><span class="badge bg-secondary"><?= e($r['status']) ?></span></td>
              <td class="small"><?= e($r['creditinfo_reference'] ?? '—') ?></td>
              <td><a href="<?= url('/creditinfo/public-defaults/' . $r['id']) ?>" class="btn btn-sm btn-outline-secondary">View</a></td>
            </tr>
          <?php endforeach; ?>
          <?php if (empty($result['rows'])): ?>
            <tr><td colspan="10" class="text-muted small">No active public defaults.</td></tr>
          <?php endif; ?>
        </tbody>
      </table>
    </div>

    <?php if ($result['totalPages'] > 1): ?>
      <nav><ul class="pagination pagination-sm">
        <?php for ($p = 1; $p <= $result['totalPages']; $p++): ?>
          <li class="page-item <?= $p == ($_GET['page'] ?? 1) ? 'active' : '' ?>"><a class="page-link" href="?page=<?= $p ?>&<?= http_build_query($filters) ?>"><?= $p ?></a></li>
        <?php endfor; ?>
      </ul></nav>
    <?php endif; ?>
  </div>
</div>
