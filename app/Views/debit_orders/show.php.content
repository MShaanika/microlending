<?= flash_messages() ?>

<?php
  $badge = match ($debitOrder['status']) {
    'Active' => 'success',
    'Cancelled' => 'danger',
    'Suspended' => 'warning',
    default => 'secondary',
  };
?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1">Debit Order <?= e($debitOrder['debit_order_no']) ?></h4>
        <p class="text-muted small mb-0">Loan <?= e($debitOrder['loan_no']) ?> &bull; <?= e($debitOrder['borrower_name']) ?></p>
      </div>
      <span class="badge fs-6 bg-<?= $badge ?>"><?= e($debitOrder['status']) ?></span>
    </div>

    <p class="mb-1 mt-2">
      <strong>Batch Registration:</strong>
      <span class="badge bg-<?= $debitOrder['collexia_status'] === 'Registered' ? 'success' : 'secondary' ?>"><?= e($debitOrder['collexia_status']) ?></span>
      <?php if ($debitOrder['merchant_system_contract_no']): ?>
        <span class="text-muted small">Contract No: <?= e($debitOrder['merchant_system_contract_no']) ?></span>
      <?php endif; ?>
    </p>

    <hr>
    <p class="mb-1"><strong>Bank:</strong> <?= e($debitOrder['bank_name']) ?></p>
    <p class="mb-1"><strong>Account:</strong> <?= e($debitOrder['account_name']) ?: '&mdash;' ?> &mdash; <?= e($debitOrder['account_number']) ?> <?= $debitOrder['branch_code'] ? '(' . e($debitOrder['branch_code']) . ')' : '' ?></p>
    <p class="mb-1"><strong>Debit Day:</strong> <?= (int) $debitOrder['debit_day'] ?> of each month</p>
    <p class="mb-1"><strong>Debit Amount:</strong> <?= format_money($debitOrder['debit_amount']) ?></p>
    <p class="mb-1"><strong>Start Date:</strong> <?= e(date('d M Y', strtotime($debitOrder['start_date']))) ?></p>
    <?php if ($debitOrder['end_date']): ?>
      <p class="mb-1"><strong>End Date:</strong> <?= e(date('d M Y', strtotime($debitOrder['end_date']))) ?></p>
    <?php endif; ?>

    <?php if ($pendingCancellation): ?>
      <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-0">
        <div>
          <strong>Cancellation requested</strong> on <?= e(date('d M Y', strtotime($pendingCancellation['created_at']))) ?> &mdash;
          this mandate is still <strong>Active</strong> until the request below is approved.
        </div>
        <a href="<?= url('/debit-order-cancellations/' . $pendingCancellation['id']) ?>" class="btn btn-sm btn-warning"><i class="mdi mdi-arrow-right"></i> Review &amp; Approve</a>
      </div>
    <?php endif; ?>

    <div class="d-flex gap-2 flex-wrap mt-3">
      <?php if ($editable): ?>
        <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/edit') ?>" class="btn btn-outline-primary"><i class="mdi mdi-pencil"></i> Edit</a>
      <?php endif; ?>
      <?php if ($debitOrder['status'] === 'Active' && !$pendingCancellation): ?>
        <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/cancel') ?>" class="btn btn-outline-danger"><i class="mdi mdi-block-helper"></i> Request Cancellation</a>
      <?php endif; ?>
      <a href="<?= url('/debit-orders') ?>" class="btn btn-outline-secondary">Back to List</a>
    </div>
    <?php if (!$editable && $debitOrder['status'] === 'Active'): ?>
      <p class="text-muted small mt-2 mb-0">This mandate has already been placed, so it can no longer be edited here. Use <strong>Reschedule Installment</strong> below for amount/date changes, or cancel and re-register for bank/account changes.</p>
    <?php endif; ?>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
      <h5 class="card-title mb-0">API Registration</h5>
      <?php
        $apiBadge = match ($debitOrder['collexia_api_status'] ?? 'Not Placed') {
          'Registered' => 'success',
          'Load Pending' => 'warning',
          'Load Failed' => 'danger',
          'Cancelled' => 'dark',
          'Uncertain' => 'warning',
          default => 'secondary',
        };
      ?>
      <span class="badge bg-<?= $apiBadge ?>"><?= e($debitOrder['collexia_api_status'] ?? 'Not Placed') ?></span>
    </div>

    <?php if (!$collexiaConfigured): ?>
      <p class="text-muted small mb-2">
        Not configured yet. <a href="<?= url('/collexia/settings') ?>">Set up API credentials</a> before placing a mandate here.
        The Excel-based batch registration above is unaffected either way.
      </p>
    <?php elseif (!$collexiaEnabled): ?>
      <p class="text-muted small mb-2">
        Configured but disabled. <a href="<?= url('/collexia/settings') ?>">Enable the integration</a> to place mandates through the API.
      </p>
    <?php endif; ?>

    <?php if ($debitOrder['collexia_api_contract_reference']): ?>
      <p class="mb-1 small"><strong>API Contract Reference:</strong> <?= e($debitOrder['collexia_api_contract_reference']) ?></p>
    <?php endif; ?>
    <?php if ($debitOrder['collexia_api_synced_at']): ?>
      <p class="mb-2 small text-muted">Last synced <?= e(date('d M Y H:i', strtotime($debitOrder['collexia_api_synced_at']))) ?></p>
    <?php endif; ?>

    <div class="d-flex gap-2 flex-wrap">
      <?php if (empty($debitOrder['split_enabled'])): ?>
        <?php if (($debitOrder['collexia_api_status'] ?? 'Not Placed') === 'Not Placed'): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/place') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-info btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-cloud-upload"></i> Place Mandate</button>
          </form>
        <?php endif; ?>
        <?php if (in_array($debitOrder['collexia_api_status'] ?? '', ['Load Pending', 'Uncertain'], true)): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/final-fate') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-warning btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-check-circle-outline"></i> Check Final Fate</button>
          </form>
        <?php endif; ?>
        <?php if (in_array($debitOrder['collexia_api_status'] ?? '', ['Registered', 'Load Pending'], true)): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/sync') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-outline-secondary btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-refresh"></i> Sync Status</button>
          </form>
          <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/installments') ?>" class="btn btn-outline-secondary btn-sm <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>"><i class="mdi mdi-calendar-edit"></i> Reschedule Installment</a>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/cancel') ?>" class="d-inline" onsubmit="return confirm('Cancel this mandate? This cancels the whole mandate and every installment under it.');">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-outline-danger btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-block-helper"></i> Cancel Mandate</button>
          </form>
        <?php endif; ?>
      <?php else: ?>
        <?php if ($splitFlags['anyUnsent']): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/place') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-info btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-cloud-upload"></i> Place Mandate</button>
          </form>
        <?php endif; ?>
        <?php if ($splitFlags['anyLoadPending']): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/final-fate') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-warning btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-check-circle-outline"></i> Check Final Fate</button>
          </form>
        <?php endif; ?>
        <?php if ($splitFlags['anyLive']): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/sync') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-outline-secondary btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-refresh"></i> Sync Status</button>
          </form>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/cancel') ?>" class="d-inline" onsubmit="return confirm('Cancel this mandate? This cancels every live split transaction under it.');">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-outline-danger btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-block-helper"></i> Cancel Mandate</button>
          </form>
        <?php endif; ?>
        <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions') ?>" class="btn btn-outline-primary btn-sm"><i class="mdi mdi-call-split"></i> View Split Transactions</a>
      <?php endif; ?>
    </div>

    <?php if (!empty($debitOrder['collexia_api_last_response'])): ?>
      <details class="mt-2">
        <summary class="small text-muted" style="cursor:pointer">Last raw response</summary>
        <pre class="small bg-light p-2 mt-1" style="white-space:pre-wrap"><?= e($debitOrder['collexia_api_last_response']) ?></pre>
      </details>
    <?php endif; ?>

    <?php if (!empty($debitOrder['split_enabled']) && !empty($splitLegs)): ?>
      <hr>
      <h6 class="mb-2">Split Transactions <span class="text-muted small fw-normal">(<?= count($splitLegs) ?> live)</span></h6>
      <p class="text-muted small mb-2">This installment is split into <?= (int) ($splitLegs[0]['total_splits'] ?? count($splitLegs)) ?> transaction(s) -- each collects independently and is tracked separately, but all apply to the same monthly installment.</p>
      <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions') ?>" class="btn btn-sm btn-outline-primary"><i class="mdi mdi-call-split"></i> View All Split Transactions</a>
    <?php endif; ?>
  </div>
</div>
