<?= flash_messages() ?>

<?php
  $badge = match ($debitOrder['status']) {
    'Active' => 'success',
    'Cancelled' => 'danger',
    'Suspended' => 'warning',
    default => 'secondary',
  };
?>
<?php $mode = 'notice'; include VIEW_PATH . '/loans/_collection_check.php'; ?>

<?php if (!empty($outOfStep)): ?>
  <div class="alert alert-danger d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <i class="mdi mdi-alert-octagon-outline"></i>
      <strong>Debit order <?= e($outOfStep['debit_order_no']) ?> no longer matches this loan.</strong>
      <?= e($outOfStep['mandate_stale_note'] ?? 'The loan was rescheduled after the mandate was placed.') ?>
      Collexia is still set to collect the OLD dates and amounts.
    </div>
    <a class="btn btn-sm btn-danger" href="<?= url('/debit-orders/' . (int) $outOfStep['id'] . '/replace') ?>"><i class="mdi mdi-swap-horizontal"></i> Replace mandate</a>
  </div>
<?php endif; ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1">Debit Order <?= e($debitOrder['debit_order_no']) ?></h4>
        <p class="text-muted small mb-0">Loan <?= e($debitOrder['loan_no']) ?> &bull; <?= e($debitOrder['borrower_name']) ?></p>
      </div>
      <span class="badge fs-6 bg-<?= $badge ?>"><?= e($debitOrder['status']) ?></span>
    </div>

    <?php
      // A debit order is registered with Collexia through exactly ONE of
      // two independent mechanisms -- this legacy bulk-file "Debit Order
      // Run" batch (collexia_status), or the real-time EnDO API below
      // (collexia_api_status). They are alternatives, not two steps of one
      // flow, so a mandate placed via the API will correctly show "Not
      // Registered" here forever -- that's expected, not a fault, but easy
      // to misread as "nothing is registered" without this note.
      $usingApiPath = !empty($debitOrder['split_enabled']) || ($debitOrder['collexia_api_status'] ?? 'Not Placed') !== 'Not Placed';
    ?>
    <div class="table-responsive mt-2">
      <table class="table table-sm mb-0">
        <tbody>
          <tr>
            <th style="width:200px;">Batch Registration <span class="text-muted small fw-normal d-block">(legacy bulk-file method)</span></th>
            <td>
              <span class="badge bg-<?= $debitOrder['collexia_status'] === 'Registered' ? 'success' : 'secondary' ?>"><?= e($debitOrder['collexia_status']) ?></span>
              <?php if ($debitOrder['merchant_system_contract_no']): ?>
                <span class="text-muted small ms-2">Contract No: <?= e($debitOrder['merchant_system_contract_no']) ?></span>
              <?php endif; ?>
              <?php if ($usingApiPath && $debitOrder['collexia_status'] !== 'Registered'): ?>
                <div class="text-muted small mt-1">Not used for this mandate -- see <strong>API Registration</strong> below for its real status.</div>
              <?php endif; ?>
            </td>
          </tr>
          <tr><th>Bank</th><td><?= e($debitOrder['bank_name']) ?></td></tr>
          <tr><th>Account</th><td><?= e($debitOrder['account_name']) ?: '&mdash;' ?> &mdash; <?= e($debitOrder['account_number']) ?> <?= $debitOrder['branch_code'] ? '(' . e($debitOrder['branch_code']) . ')' : '' ?></td></tr>
          <tr><th>Debit Day</th><td><?= (int) $debitOrder['debit_day'] ?> of each month</td></tr>
          <tr><th>Debit Amount</th><td><?= format_money($debitOrder['debit_amount']) ?></td></tr>
          <tr><th>Start Date</th><td><?= e(date('d M Y', strtotime($debitOrder['start_date']))) ?></td></tr>
          <?php if ($debitOrder['end_date']): ?>
            <tr><th>End Date</th><td><?= e(date('d M Y', strtotime($debitOrder['end_date']))) ?></td></tr>
          <?php endif; ?>
        </tbody>
      </table>
    </div>

    <?php if ($pendingCancellation): ?>
      <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-0">
        <div>
          <strong>Cancellation requested</strong> on <?= e(date('d M Y', strtotime($pendingCancellation['created_at']))) ?> &mdash;
          this mandate is still <strong>Active</strong> until the request below is approved.
        </div>
        <a href="<?= url('/debit-order-cancellations/' . $pendingCancellation['id']) ?>" class="btn btn-sm btn-warning"><i class="mdi mdi-arrow-right"></i> Review &amp; Approve</a>
      </div>
    <?php endif; ?>

    <div class="d-flex gap-2 flex-wrap mt-3">
      <?php if ($editable): ?>
        <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/edit') ?>" class="btn btn-outline-primary"><i class="mdi mdi-pencil"></i> Edit</a>
      <?php endif; ?>
      <?php if ($debitOrder['status'] === 'Active' && !$pendingCancellation): ?>
        <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/cancel') ?>" class="btn btn-outline-danger"><i class="mdi mdi-block-helper"></i> Request Cancellation</a>
      <?php endif; ?>
      <a href="<?= url('/debit-orders') ?>" class="btn btn-outline-secondary">Back to List</a>
    </div>
    <?php if (!$editable && $debitOrder['status'] === 'Active'): ?>
      <p class="text-muted small mt-2 mb-0">This mandate has already been placed, so it can no longer be edited here. Use <strong>Reschedule Installment</strong> below for amount/date changes, or cancel and re-register for bank/account changes.</p>
    <?php endif; ?>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
      <h5 class="card-title mb-0">API Registration</h5>
      <?php
        $apiBadge = match ($debitOrder['collexia_api_status'] ?? 'Not Placed') {
          'Registered' => 'success',
          'Load Pending' => 'warning',
          'Load Failed' => 'danger',
          'Cancelled' => 'dark',
          'Uncertain' => 'warning',
          'Completed' => 'info',
          'Mixed' => 'warning',
          default => 'secondary',
        };
      ?>
      <span class="badge bg-<?= $apiBadge ?>"><?= e($debitOrder['collexia_api_status'] ?? 'Not Placed') ?></span>
    </div>

    <?php if (!$collexiaConfigured): ?>
      <p class="text-muted small mb-2">
        Not configured yet. <a href="<?= url('/collexia/settings') ?>">Set up API credentials</a> before placing a mandate here.
        The Excel-based batch registration above is unaffected either way.
      </p>
    <?php elseif (!$collexiaEnabled): ?>
      <p class="text-muted small mb-2">
        Configured but disabled. <a href="<?= url('/collexia/settings') ?>">Enable the integration</a> to place mandates through the API.
      </p>
    <?php endif; ?>

    <?php
      $hasApiDetails = !empty($debitOrder['collexia_client_no']) || $debitOrder['collexia_api_contract_reference']
        || !empty($debitOrder['collexia_user_reference']) || $debitOrder['collexia_api_synced_at'];
    ?>
    <?php if ($hasApiDetails): ?>
      <div class="table-responsive mb-2">
        <table class="table table-sm mb-0">
          <tbody>
            <?php if (!empty($debitOrder['collexia_client_no'])): ?>
              <tr><th style="width:260px;" class="small">Collexia Client No</th><td class="small"><?= e($debitOrder['collexia_client_no']) ?></td></tr>
            <?php endif; ?>
            <?php if ($debitOrder['collexia_api_contract_reference']): ?>
              <tr><th class="small">Collexia Contract Reference</th><td class="small"><?= e($debitOrder['collexia_api_contract_reference']) ?></td></tr>
            <?php endif; ?>
            <?php if (!empty($debitOrder['collexia_user_reference'])): ?>
              <tr><th class="small">Collexia Merchant System Contract No</th><td class="small"><?= e($debitOrder['collexia_user_reference']) ?></td></tr>
            <?php endif; ?>
            <?php if ($debitOrder['collexia_api_synced_at']): ?>
              <tr><th class="small">Last Synced</th><td class="small text-muted"><?= e(date('d M Y H:i', strtotime($debitOrder['collexia_api_synced_at']))) ?></td></tr>
            <?php endif; ?>
          </tbody>
        </table>
      </div>
    <?php endif; ?>

    <div class="d-flex gap-2 flex-wrap">
      <?php if (empty($debitOrder['split_enabled'])): ?>
        <?php if (($debitOrder['collexia_api_status'] ?? 'Not Placed') === 'Not Placed'): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/place') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-info btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-cloud-upload"></i> Place Mandate</button>
          </form>
        <?php endif; ?>
        <?php if (in_array($debitOrder['collexia_api_status'] ?? '', ['Load Pending', 'Uncertain'], true)): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/final-fate') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-warning btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-check-circle-outline"></i> Check Final Fate</button>
          </form>
        <?php endif; ?>
        <?php if (in_array($debitOrder['collexia_api_status'] ?? '', ['Registered', 'Load Pending'], true)): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/sync') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-outline-secondary btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-refresh"></i> Sync Status</button>
          </form>
          <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/installments') ?>" class="btn btn-outline-secondary btn-sm <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>"><i class="mdi mdi-calendar-edit"></i> Reschedule Installment</a>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/cancel') ?>" class="d-inline" onsubmit="return confirm('Cancel this mandate? This cancels the whole mandate and every installment under it.');">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-outline-danger btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-block-helper"></i> Cancel Mandate</button>
          </form>
        <?php endif; ?>
      <?php else: ?>
        <?php if ($splitFlags['anyUnsent']): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/place') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-info btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-cloud-upload"></i> Place Mandate</button>
          </form>
        <?php endif; ?>
        <?php if ($splitFlags['anyLoadPending']): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/final-fate') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-warning btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-check-circle-outline"></i> Check Final Fate</button>
          </form>
        <?php endif; ?>
        <?php if ($splitFlags['anyLive']): ?>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/sync') ?>" class="d-inline">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-outline-secondary btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-refresh"></i> Sync Status</button>
          </form>
          <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/collexia/cancel') ?>" class="d-inline" onsubmit="return confirm('Cancel this mandate? This cancels every live split transaction under it.');">
            <?= csrf_field() ?>
            <button type="submit" class="btn btn-outline-danger btn-sm" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-block-helper"></i> Cancel Mandate</button>
          </form>
        <?php endif; ?>
        <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions') ?>" class="btn btn-outline-primary btn-sm"><i class="mdi mdi-call-split"></i> View Split Transactions</a>
      <?php endif; ?>
    </div>

    <?php if (!empty($debitOrder['collexia_api_last_response'])): ?>
      <details class="mt-2">
        <summary class="small text-muted" style="cursor:pointer">Last raw response</summary>
        <pre class="small bg-light p-2 mt-1" style="white-space:pre-wrap"><?= e($debitOrder['collexia_api_last_response']) ?></pre>
      </details>
    <?php endif; ?>

    <?php if (!empty($debitOrder['split_enabled']) && !empty($splitLegs)): ?>
      <hr>
      <h6 class="mb-2">Split Transactions <span class="text-muted small fw-normal">(<?= count($splitLegs) ?> live)</span></h6>
      <p class="text-muted small mb-2">Each split collects independently of its siblings and is tracked separately -- the full breakdown, including which installment each one belongs to, is on the Split Transactions page.</p>
      <div class="d-flex gap-2 flex-wrap">
        <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions') ?>" class="btn btn-sm btn-outline-primary"><i class="mdi mdi-call-split"></i> View All Split Transactions</a>
        <?php if (!empty($splitFlags['hasNextInstallment'])): ?>
          <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/next-installment-splits') ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-calendar-plus"></i> Add Splits for Next Installment</a>
        <?php endif; ?>
      </div>
    <?php endif; ?>

    <?php if (!empty($debitOrder['split_enabled']) && !empty($loanSchedule)): ?>
      <hr>
      <h6 class="mb-2">Installments <span class="text-muted small fw-normal">&mdash; open an installment to see the mandate that carries it</span></h6>
      <?php if (!empty($scheduleDrift)): ?>
        <div class="alert alert-warning py-2 small">
          <strong>The loan has changed since these mandates were placed.</strong> A mandate keeps the amounts it was placed with and does not follow later changes to the loan.
          <ul class="mb-1"><?php foreach ($scheduleDrift as $finding): ?><li><?= e($finding) ?></li><?php endforeach; ?></ul>
          Cancel the mandates and register the loan again so they match.
        </div>
      <?php endif; ?>
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0 align-middle">
          <thead>
            <tr><th>#</th><th>Due Date</th><th>Amount</th><th>Loan Status</th><th>Mandate(s)</th></tr>
          </thead>
          <tbody>
            <?php foreach ($loanSchedule as $row): ?>
              <?php
                $carried = ($carriers ?? [])[(int) $row['id']] ?? [];
                if (!$carried && $row['status'] === 'Paid') {
                    continue;
                }
                $scheduleBadge = match ($row['status']) {
                  'Paid' => 'success',
                  'Partial' => 'info',
                  'In Arrears' => 'danger',
                  'Written Off' => 'dark',
                  default => 'warning',
                };
              ?>
              <tr>
                <td><?= (int) $row['installment_no'] ?></td>
                <td><?= e(date('d M Y', strtotime($row['due_date']))) ?></td>
                <td><?= format_money($row['total_due']) ?></td>
                <td><span class="badge bg-<?= $scheduleBadge ?>"><?= e($row['status']) ?></span></td>
                <td>
                  <?php if (!$carried): ?>
                    <span class="text-muted small">Not placed with Collexia yet</span>
                  <?php else: ?>
                    <?php
                      // One link per MANDATE: parts of a split installment that ride in the
                      // same mandate are totalled under it.
                      $byMandate = [];
                      foreach ($carried as $c) {
                          $key = (int) $c['leg_id'];
                          if (!isset($byMandate[$key])) {
                              $byMandate[$key] = ['split_no' => (int) $c['split_no'], 'amount' => 0.0, 'parts' => 0];
                          }
                          $byMandate[$key]['amount'] += (float) $c['amount'];
                          $byMandate[$key]['parts']++;
                      }
                    ?>
                    <?php if (count($carried) > 1): ?><span class="badge bg-info me-1">split in <?= count($carried) ?></span><?php endif; ?>
                    <?php
                      $stillLive = array_filter($carried, fn ($c) => empty($c['cancelled_at']));
                      $waitingCancel = array_filter($carried, fn ($c) => !empty($c['auto_cancel']) && empty($c['cancelled_at']));
                    ?>
                    <?php if (!$stillLive): ?>
                      <span class="badge bg-secondary me-1" title="Paid by hand; sent with the mandate and cancelled at Collexia automatically, so it is not collected.">paid by hand &middot; cancelled</span>
                    <?php elseif ($waitingCancel): ?>
                      <span class="badge bg-warning text-dark me-1" title="Paid by hand; will be cancelled at Collexia automatically once the mandate is confirmed.">paid by hand &middot; to be cancelled</span>
                    <?php endif; ?>
                    <?php foreach ($byMandate as $m): ?>
                      <a class="btn btn-sm btn-outline-primary py-0" href="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions/' . $m['split_no']) ?>">
                        Mandate <?= $m['split_no'] ?> &middot; <?= format_money($m['amount']) ?><?= $m['parts'] > 1 ? ' (' . $m['parts'] . ' parts)' : '' ?>
                      </a>
                    <?php endforeach; ?>
                  <?php endif; ?>
                </td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    <?php endif; ?>

    <?php if (empty($debitOrder['split_enabled']) && !empty($loanSchedule) && in_array($debitOrder['collexia_api_status'] ?? '', ['Registered', 'Load Pending'], true)): ?>
      <hr>
      <h6 class="mb-2">Installments Covered <span class="text-muted small fw-normal">(<?= count($loanSchedule) ?>)</span></h6>
      <p class="text-muted small mb-2">This one mandate collects every installment below on its own (Frequency: Monthly) -- no second debit order is needed for next month's installment; registering one would double-collect (see the guard above).</p>
      <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
          <thead>
            <tr><th>#</th><th>Due Date</th><th>Amount</th><th>Status</th></tr>
          </thead>
          <tbody>
            <?php foreach ($loanSchedule as $row): ?>
              <?php
                $scheduleBadge = match ($row['status']) {
                  'Paid' => 'success',
                  'Partial' => 'info',
                  'In Arrears' => 'danger',
                  'Written Off' => 'dark',
                  default => 'warning',
                };
              ?>
              <tr>
                <td><?= (int) $row['installment_no'] ?></td>
                <td><?= e(date('d M Y', strtotime($row['due_date']))) ?></td>
                <td><?= format_money($row['total_due']) ?></td>
                <td><span class="badge bg-<?= $scheduleBadge ?>"><?= e($row['status']) ?></span></td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    <?php endif; ?>
  </div>
</div>
