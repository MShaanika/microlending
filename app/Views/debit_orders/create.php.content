          <label class="form-label">Branch Code</label>
          <input type="text" name="branch_code" class="form-control" value="<?= old('branch_code', $old) ?>">
        </div>
        <div class="col-md-4 mb-3 legacy-only">
          <label class="form-label">Debit Day (1-31) <span class="text-danger">*</span></label>
          <input type="number" min="1" max="31" name="debit_day" class="form-control <?= isset($errors['debit_day']) ? 'is-invalid' : '' ?>" value="<?= old('debit_day', $old, (string) $loan['payment_day']) ?>">
