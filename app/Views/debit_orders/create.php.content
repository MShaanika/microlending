            <?php foreach ($accountTypes as $val => $label): ?>
              <option value="<?= (int) $val ?>" <?= (int) old('account_type', $old, '1') === $val ? 'selected' : '' ?>><?= e($label) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
