          <?php if (isset($errors['debit_amount'])): ?><div class="invalid-feedback d-block"><?= e($errors['debit_amount']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-4 mb-3 legacy-only">
          <label class="form-label">Start Date <span class="text-danger">*</span></label>
          <input type="date" id="start_date" name="start_date" min="<?= e(date('Y-m-d')) ?>" data-first-due="<?= e($firstDueDate ?? '') ?>" class="form-control <?= isset($errors['start_date']) ? 'is-invalid' : '' ?>" value="<?= old('start_date', $old, date('Y-m-d')) ?>">
          <?php if (isset($errors['start_date'])): ?><div class="invalid-feedback d-block"><?= e($errors['start_date']) ?></div><?php endif; ?>
          <?php if ($firstDueDate): ?>
            <div class="form-text">Loan's next unpaid installment is due <?= e(date('d M Y', strtotime($firstDueDate))) ?> &mdash; a non-split debit order then collects every remaining installment monthly from this date. Collexia rounds this to the nearest matching Debit Day, so a mismatched Start Date silently shifts the first collection off-schedule. If the resulting collection date falls on a weekend or public holiday, Collexia automatically moves it to the next business day -- it never collects early.</div>
          <?php else: ?>
            <div class="form-text text-warning">No repayment schedule found for this loan yet -- confirm this date manually.</div>
          <?php endif; ?>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Tracking Days (1-14)</label>
          <input type="number" min="1" max="14" name="no_of_days_tracking" class="form-control" value="<?= old('no_of_days_tracking', $old, '3') ?>">
          <div class="form-text">How many days collection is retried before giving up.</div>
        </div>
      </div>

      <div id="per_installment_panel" class="mb-3">
        <?php if (isset($errors['installments'])): ?><div class="alert alert-danger py-2"><?= e($errors['installments']) ?></div><?php endif; ?>
        <?php if (empty($installments)): ?>
          <div class="alert alert-warning">This loan has no unpaid installments left to collect.</div>
        <?php else: ?>
          <?php $tomorrow = date('Y-m-d', strtotime('+1 day')); $posted = (array) ($old['installment_ids'] ?? []); $postedDates = (array) ($old['collection_dates'] ?? []); $postedCounts = (array) ($old['split_counts'] ?? []); $postedAmounts = (array) ($old['split_amounts'] ?? []); ?>
          <div class="fw-semibold mb-1">Installments to collect <span class="text-muted small fw-normal">(none of these has a mandate yet)</span></div>
          <div class="table-responsive">
            <table class="table table-sm align-middle">
              <thead><tr><th style="width:40px"><input type="checkbox" id="inst_all" checked></th><th>#</th><th>Scheduled Date</th><th class="text-end">Amount</th><th>Collect On</th><th>Parts</th><th>Note</th></tr></thead>
              <tbody>
              <?php foreach ($installments as $row): ?>
                <?php
                  $sid = (int) $row['id'];
                  $pastDue = $row['due_date'] < $tomorrow;
                  $defaultDate = $pastDue ? $tomorrow : $row['due_date'];
                  $checked = empty($posted) ? true : in_array((string) $sid, array_map('strval', $posted), true);
                  $dateVal = $postedDates[$sid] ?? $defaultDate;
                  $partCount = max(1, min(10, (int) ($postedCounts[$sid] ?? 1)));
                ?>
                <tr>
                  <td><input type="checkbox" class="inst-check" name="installment_ids[]" value="<?= $sid ?>" <?= $checked ? 'checked' : '' ?>></td>
                  <td><?= (int) $row['installment_no'] ?></td>
                  <td><?= e(date('d M Y', strtotime($row['due_date']))) ?></td>
                  <td class="text-end"><?= format_money((float) $row['outstanding']) ?></td>
                  <td><input type="date" name="collection_dates[<?= $sid ?>]" min="<?= e($tomorrow) ?>" value="<?= e($dateVal) ?>" class="form-control form-control-sm" style="max-width:170px"></td>
                  <td><input type="number" min="1" max="10" name="split_counts[<?= $sid ?>]" value="<?= $partCount ?>" class="form-control form-control-sm part-count" style="max-width:70px" data-sid="<?= $sid ?>" title="Divide this installment into parts, all collected on the same date"></td>
                  <td class="small text-muted"><?= $pastDue ? 'Already due -- moved to the earliest date Collexia accepts' : ($row['status'] === 'Partial' ? 'Partly paid -- only the balance is collected' : 'On schedule') ?></td>
                </tr>
                <tr class="parts-row d-none" id="parts_row_<?= $sid ?>" data-sid="<?= $sid ?>" data-outstanding="<?= e((string) $row['outstanding']) ?>" data-old="<?= e(json_encode(array_map('strval', array_values((array) ($postedAmounts[$sid] ?? []))))) ?>">
                  <td></td>
                  <td colspan="6">
                    <div class="small text-muted mb-1">Parts of installment #<?= (int) $row['installment_no'] ?> &mdash; each part travels in its own mandate together with the same part of the other installments, and all are collected on the date above. <span class="fw-semibold">Remaining to allocate: <span class="parts-remaining">&mdash;</span></span></div>
                    <div class="parts-inputs d-flex flex-wrap gap-2"></div>
                  </td>
                </tr>
              <?php endforeach; ?>
              </tbody>
            </table>
          </div>
          <div class="form-text">All ticked installments are loaded into one Collexia mandate, then each is set to the amount shown and collected on the date in &ldquo;Collect On&rdquo;. Set Parts above 1 to divide an installment: part 1 of every installment goes in one mandate, part 2 in another, and so on, all collected on that installment's date. If a date falls on a weekend or public holiday Collexia moves it to the next business day &mdash; it never collects early.</div>
        <?php endif; ?>
      </div>

      <div id="legacy_split_section">
      <div class="form-check mb-2">
        <input type="checkbox" name="split_enabled" value="1" id="split_enabled" class="form-check-input" <?= old('split_enabled', $old) ? 'checked' : '' ?>>
        <label class="form-check-label" for="split_enabled">Split this installment into multiple transactions</label>
        <div class="form-text">Submits a separate Collexia mandate per split instead of one, all tied to the same monthly installment. All collect &rarr; installment marked Paid; some collect &rarr; Partial; none &rarr; unpaid. Set once here and cannot be changed after registering.</div>
      </div>

      <div id="split_panel" class="border rounded p-3 mb-3 d-none">
        <div class="row align-items-end">
          <div class="col-md-4 mb-2">
            <label class="form-label">Number of Splits (1-10) <span class="text-danger">*</span></label>
            <input type="number" min="1" max="10" id="split_count" name="split_count" class="form-control <?= isset($errors['split_count']) ? 'is-invalid' : '' ?>" value="<?= (int) old('split_count', $old, '2') ?>">
            <?php if (isset($errors['split_count'])): ?><div class="invalid-feedback d-block"><?= e($errors['split_count']) ?></div><?php endif; ?>
          </div>
          <div class="col-md-8 mb-2">
            <span class="fw-semibold">Remaining to allocate: <span id="split_remaining">&mdash;</span></span>
          </div>
        </div>
        <?php if (isset($errors['split_amounts'])): ?><div class="text-danger small mb-2"><?= e($errors['split_amounts']) ?></div><?php endif; ?>
        <div id="split_rows"></div>
      </div>
      </div>

      <button type="submit" name="place_now" value="1" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-send"></i> Register &amp; Send to Collexia</button>
      <button type="submit" class="btn btn-outline-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Register Only</button>
      <a href="<?= url('/loans/' . $loan['id']) ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>

<script>
(function () {
  var enabledCheckbox = document.getElementById('split_enabled');
  var panel = document.getElementById('split_panel');
  var countInput = document.getElementById('split_count');
  var rowsContainer = document.getElementById('split_rows');
  var remainingEl = document.getElementById('split_remaining');
  var amountInput = document.getElementById('debit_amount');
  var oldSplitAmounts = <?= json_encode(array_map('strval', array_values((array) ($old['split_amounts'] ?? [])))) ?>;

  function money(n) {
    return 'N$' + (Math.round(n * 100) / 100).toFixed(2);
  }

  function renderRows() {
    var count = Math.max(1, Math.min(10, parseInt(countInput.value, 10) || 1));
    countInput.value = count;
    rowsContainer.innerHTML = '';
    for (var i = 0; i < count; i++) {
      var row = document.createElement('div');
      row.className = 'row mb-2 align-items-center';
      var value = oldSplitAmounts[i] !== undefined ? oldSplitAmounts[i] : '';
      row.innerHTML =
        '<div class="col-md-3 small text-muted">Split ' + (i + 1) + ' of ' + count + '</div>' +
        '<div class="col-md-4"><input type="number" step="0.01" min="0.01" class="form-control form-control-sm split-amount" name="split_amounts[]" value="' + value + '" required></div>';
      rowsContainer.appendChild(row);
    }
    oldSplitAmounts = [];
    recalcRemaining();
  }

  function recalcRemaining() {
    var total = parseFloat(amountInput.value) || 0;
    var sum = 0;
    rowsContainer.querySelectorAll('.split-amount').forEach(function (el) {
      sum += parseFloat(el.value) || 0;
    });
    var remaining = Math.round((total - sum) * 100) / 100;
    remainingEl.textContent = money(remaining);
    remainingEl.className = Math.abs(remaining) < 0.01 ? 'text-success fw-bold' : 'text-danger fw-bold';
  }

  function togglePanel() {
    if (enabledCheckbox.checked) {
      panel.classList.remove('d-none');
      if (!rowsContainer.children.length) {
        renderRows();
      }
    } else {
      panel.classList.add('d-none');
    }
  }

  enabledCheckbox.addEventListener('change', togglePanel);
  countInput.addEventListener('input', renderRows);
  amountInput.addEventListener('input', recalcRemaining);
  rowsContainer.addEventListener('input', function (e) {
    if (e.target.classList.contains('split-amount')) {
      recalcRemaining();
    }
  });

  if (enabledCheckbox.checked) {
    togglePanel();
  }

  // Warn (don't block) if Start Date is being overridden away from the
  // loan's actual first installment due date -- Collexia rounds an
  // off-schedule start_date to the nearest matching Debit Day rather than
  // rejecting it, so a mismatch here silently registers a mandate that
  // collects on the wrong cycle. See app/Controllers/DebitOrderController.php.
  var startDateInput = document.getElementById('start_date');
  var form = startDateInput ? startDateInput.closest('form') : null;
  if (form && startDateInput && startDateInput.dataset.firstDue) {
    form.addEventListener('submit', function (e) {
      if (document.getElementById('mode_legacy') && document.getElementById('mode_legacy').checked && startDateInput.value !== startDateInput.dataset.firstDue) {
        var ok = confirm(
          'This Start Date (' + startDateInput.value + ') does not match the loan\'s first installment due date (' +
          startDateInput.dataset.firstDue + ').\n\nCollexia will round this to the nearest matching Debit Day, ' +
          'which can register the mandate a full cycle off-schedule.\n\nRegister anyway?'
        );
        if (!ok) {
          e.preventDefault();
        }
      }
    });
  }
  function applyMode() {
    var legacyRadio = document.getElementById('mode_legacy');
    var legacy = !!(legacyRadio && legacyRadio.checked);
    document.querySelectorAll('.legacy-only').forEach(function (el) { el.classList.toggle('d-none', !legacy); });
    document.getElementById('legacy_split_section').classList.toggle('d-none', !legacy);
    document.getElementById('per_installment_panel').classList.toggle('d-none', legacy);
  }
  ['mode_legacy', 'mode_per_installment'].forEach(function (id) {
    var radio = document.getElementById(id);
    if (radio) { radio.addEventListener('change', applyMode); }
  });
  applyMode();

  function moneyFmt(n) { return (Math.round(n * 100) / 100).toFixed(2); }
  function renderParts(sid) {
    var input = document.querySelector('.part-count[data-sid="' + sid + '"]');
    var row = document.getElementById('parts_row_' + sid);
    if (!input || !row) { return; }
    var count = Math.max(1, Math.min(10, parseInt(input.value, 10) || 1));
    input.value = count;
    if (count === 1) { row.classList.add('d-none'); row.querySelector('.parts-inputs').innerHTML = ''; return; }
    var outstanding = parseFloat(row.dataset.outstanding) || 0;
    var box = row.querySelector('.parts-inputs');
    var old = []; try { old = JSON.parse(row.dataset.old || '[]'); } catch (e) {}
    var existing = Array.prototype.map.call(box.querySelectorAll('input'), function (i) { return i.value; });
    var base = Math.floor(outstanding / count * 100) / 100;
    box.innerHTML = '';
    for (var i = 0; i < count; i++) {
      var v = existing.length === count ? existing[i] : (old.length === count ? old[i] : moneyFmt(i === count - 1 ? outstanding - base * (count - 1) : base));
      var el = document.createElement('input');
      el.type = 'number'; el.step = '0.01'; el.min = '0.01'; el.required = true;
      el.name = 'split_amounts[' + sid + '][]'; el.value = v;
      el.className = 'form-control form-control-sm'; el.style.maxWidth = '110px';
      box.appendChild(el);
    }
    row.classList.remove('d-none');
    recalcParts(sid);
  }
  function recalcParts(sid) {
    var row = document.getElementById('parts_row_' + sid);
    if (!row) { return; }
    var outstanding = parseFloat(row.dataset.outstanding) || 0;
    var sum = 0;
    row.querySelectorAll('.parts-inputs input').forEach(function (i) { sum += parseFloat(i.value) || 0; });
    var rem = Math.round((outstanding - sum) * 100) / 100;
    var el = row.querySelector('.parts-remaining');
    el.textContent = 'N$' + moneyFmt(rem);
    el.className = 'parts-remaining ' + (Math.abs(rem) < 0.01 ? 'text-success' : 'text-danger');
  }
  document.querySelectorAll('.part-count').forEach(function (i) {
    i.addEventListener('input', function () { renderParts(i.dataset.sid); });
    renderParts(i.dataset.sid);
  });
  document.querySelectorAll('.parts-row').forEach(function (r) {
    r.addEventListener('input', function (e) { if (e.target.name && e.target.name.indexOf('split_amounts') === 0) { recalcParts(r.dataset.sid); } });
  });

  var allBox = document.getElementById('inst_all');
  if (allBox) {
    allBox.addEventListener('change', function () {
      document.querySelectorAll('.inst-check').forEach(function (c) { c.checked = allBox.checked; });
    });
  }
})();
</script>
