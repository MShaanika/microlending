          <label class="form-label">Bank <span class="text-danger">*</span></label>
          <select name="bank_code" class="form-select <?= isset($errors['bank_code']) ? 'is-invalid' : '' ?>">
            <option value="">Select bank</option>
            <?php foreach ($banks as $code => $name): ?>
              <option value="<?= e($code) ?>" <?= old('bank_code', $old) === $code ? 'selected' : '' ?>><?= e($name) ?></option>
