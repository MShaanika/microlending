    <form method="post" action="<?= url('/debit-orders') ?>">
      <?= csrf_field() ?>
      <input type="hidden" name="loan_id" value="<?= (int) $loan['id'] ?>">

      <?php $mode = (string) old('mode', $old, 'per_installment'); $installments = $installments ?? []; ?>
      <?php if (!empty($collexiaReady)): ?>
        <input type="hidden" name="mode" value="per_installment">
        <div class="alert alert-info py-2 small">Every unpaid installment below is loaded into one Collexia mandate (one per split part) and collected exactly on its schedule date.</div>
