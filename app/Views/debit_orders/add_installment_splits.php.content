<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
      <h4 class="card-title mb-0">Add Splits for Next Installment</h4>
      <a href="<?= url('/debit-orders/' . $debitOrder['id']) ?>" class="btn btn-outline-secondary btn-sm">Back to Debit Order</a>
    </div>
    <p class="text-muted small mb-3">
      <?= e($debitOrder['debit_order_no']) ?> &bull; Installment #<?= (int) $schedule['installment_no'] ?>, due <?= e(date('d M Y', strtotime($schedule['due_date']))) ?>.
      This places new, separate Collexia mandates for just this installment -- the same one mandate this debit order already has for an earlier installment keeps collecting independently.
    </p>

    <form method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/next-installment-splits') ?>">
      <?= csrf_field() ?>
      <div class="row align-items-end">
        <div class="col-md-4 mb-2">
          <label class="form-label">Number of Splits (1-10) <span class="text-danger">*</span></label>
          <input type="number" min="1" max="10" id="split_count" name="split_count" class="form-control <?= isset($errors['split_count']) ? 'is-invalid' : '' ?>" value="<?= (int) old('split_count', $old, '2') ?>">
          <?php if (isset($errors['split_count'])): ?><div class="invalid-feedback d-block"><?= e($errors['split_count']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-8 mb-2">
          <span class="fw-semibold">Installment Amount: <?= format_money((float) $schedule['total_due'] - (float) $schedule['total_paid']) ?></span>
          &mdash; <span class="fw-semibold">Remaining to allocate: <span id="split_remaining">&mdash;</span></span>
        </div>
      </div>
      <?php if (isset($errors['split_amounts'])): ?><div class="text-danger small mb-2"><?= e($errors['split_amounts']) ?></div><?php endif; ?>
      <div id="split_rows" class="mb-3"></div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Add Splits</button>
      <a href="<?= url('/debit-orders/' . $debitOrder['id']) ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>

<script>
(function () {
  var countInput = document.getElementById('split_count');
  var rowsContainer = document.getElementById('split_rows');
  var remainingEl = document.getElementById('split_remaining');
  var installmentTotal = <?= json_encode((float) $schedule['total_due'] - (float) $schedule['total_paid']) ?>;
  var oldSplitAmounts = <?= json_encode(array_map('strval', array_values((array) ($old['split_amounts'] ?? [])))) ?>;

  function money(n) {
    return 'N$' + (Math.round(n * 100) / 100).toFixed(2);
  }

  function renderRows() {
    var count = Math.max(1, Math.min(10, parseInt(countInput.value, 10) || 1));
    countInput.value = count;
    rowsContainer.innerHTML = '';
    for (var i = 0; i < count; i++) {
      var row = document.createElement('div');
      row.className = 'row mb-2 align-items-center';
      var value = oldSplitAmounts[i] !== undefined ? oldSplitAmounts[i] : '';
      row.innerHTML =
        '<div class="col-md-3 small text-muted">Split ' + (i + 1) + ' of ' + count + '</div>' +
        '<div class="col-md-4"><input type="number" step="0.01" min="0.01" class="form-control form-control-sm split-amount" name="split_amounts[]" value="' + value + '" required></div>';
      rowsContainer.appendChild(row);
    }
    oldSplitAmounts = [];
    recalcRemaining();
  }

  function recalcRemaining() {
    var sum = 0;
    rowsContainer.querySelectorAll('.split-amount').forEach(function (el) {
      sum += parseFloat(el.value) || 0;
    });
    var remaining = Math.round((installmentTotal - sum) * 100) / 100;
    remainingEl.textContent = money(remaining);
    remainingEl.className = Math.abs(remaining) < 0.01 ? 'text-success fw-bold' : 'text-danger fw-bold';
  }

  countInput.addEventListener('input', renderRows);
  rowsContainer.addEventListener('input', function (e) {
    if (e.target.classList.contains('split-amount')) {
      recalcRemaining();
    }
  });

  renderRows();
})();
</script>
