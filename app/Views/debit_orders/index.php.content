<?php use App\Models\DebitOrder; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Debit Orders</h4>

    <form method="get" action="<?= url('/debit-orders') ?>" class="row g-2 mb-3 align-items-end">
      <div class="col-md-3">
        <select name="status" class="form-select">
          <option value="">All Statuses</option>
          <?php foreach (['Active', 'Suspended', 'Cancelled', 'Completed'] as $s): ?>
            <option value="<?= $s ?>" <?= ($status ?? '') === $s ? 'selected' : '' ?>><?= $s ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-0">Created From</label>
        <input type="date" name="from_date" class="form-control" value="<?= e($fromDate ?? '') ?>">
      </div>
      <div class="col-md-3">
        <label class="form-label small mb-0">Created To</label>
        <input type="date" name="to_date" class="form-control" value="<?= e($toDate ?? '') ?>">
      </div>
      <div class="col-md-2">
        <button class="btn btn-outline-secondary w-100" type="submit"><i class="mdi mdi-magnify"></i> Filter</button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Debit Order No</th><th>Loan</th><th>Borrower</th><th>Bank</th><th>Amount</th>
            <th>Client No</th><th>Contract Reference</th><th>Merchant System Contract No</th><th>API Status</th>
            <th>Status</th><th>Created</th><th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($debitOrders)): ?>
            <tr><td colspan="12" class="text-center text-muted py-4">No debit orders registered yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($debitOrders as $d): ?>
            <?php
              $badge = match ($d['status']) {
                'Active' => 'success',
                'Cancelled' => 'danger',
                'Suspended' => 'warning',
                default => 'secondary',
              };
              $apiBadge = match ($d['collexia_api_status'] ?? 'Not Placed') {
                'Registered' => 'success',
                'Load Pending' => 'warning',
                'Load Failed' => 'danger',
                'Cancelled' => 'dark',
                'Uncertain' => 'warning',
                'Completed' => 'info',
                'Mixed' => 'warning',
                default => 'secondary',
              };
            ?>
            <tr>
              <td><?= e($d['debit_order_no']) ?></td>
              <td><?= e($d['loan_no']) ?></td>
              <td><?= e($d['borrower_name']) ?></td>
              <td><?= e($d['bank_name']) ?></td>
              <td><?= format_money($d['debit_amount']) ?></td>
              <td class="small"><?= !empty($d['collexia_client_no']) ? e($d['collexia_client_no']) : '&mdash;' ?></td>
              <td class="small"><?= $d['collexia_api_contract_reference'] ? e($d['collexia_api_contract_reference']) : '&mdash;' ?></td>
              <td class="small"><?= !empty($d['collexia_user_reference']) ? e($d['collexia_user_reference']) : '&mdash;' ?></td>
              <td><span class="badge bg-<?= $apiBadge ?>"><?= e($d['collexia_api_status'] ?? 'Not Placed') ?></span></td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($d['status']) ?></span></td>
              <td class="small text-nowrap"><?= e(date('d M Y', strtotime($d['created_at']))) ?></td>
              <td class="text-end">
                <a href="<?= url('/debit-orders/' . $d['id']) ?>" class="btn btn-sm btn-outline-info" title="View"><i class="mdi mdi-eye"></i></a>
                <?php if (!empty($d['split_enabled'])): ?>
                  <a href="<?= url('/debit-orders/' . $d['id'] . '/split-transactions') ?>" class="btn btn-sm btn-outline-primary" title="View Split Transactions"><i class="mdi mdi-call-split"></i></a>
                <?php endif; ?>
                <?php if (DebitOrder::isEditable($d)): ?>
                  <a href="<?= url('/debit-orders/' . $d['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="mdi mdi-pencil"></i></a>
                <?php endif; ?>
                <?php if ($d['status'] === 'Active'): ?>
                  <a href="<?= url('/debit-orders/' . $d['id'] . '/cancel') ?>" class="btn btn-sm btn-outline-danger" title="Request Cancellation"><i class="mdi mdi-block-helper"></i></a>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
