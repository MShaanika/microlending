<style>
  /* Split transactions: the instalments a mandate carries, grouped per loan instalment. */
  .lane-cell { min-width: 330px; }
  .lane-box { max-width: 420px; }
  .lane-toolbar { display: flex; align-items: center; justify-content: space-between; gap: .5rem; margin-bottom: .35rem; }
  .lane-title { font-weight: 600; font-size: .85rem; }
  .lane-summary { font-size: .8rem; color: #5b6b7b; margin-bottom: .5rem; min-height: 1.1rem; }
  .lane-summary.is-ready { color: #0b6b3a; font-weight: 600; }
  .lane-group { border: 1px solid #dbe3ea; border-radius: .4rem; margin-bottom: .5rem; background: #fff; overflow: hidden; }
  .lane-group.is-split { border-left: 4px solid #1e9fd6; }
  .lane-head { display: flex; align-items: center; gap: .5rem; padding: .4rem .6rem; background: #f6f9fb; flex-wrap: wrap; }
  .lane-group.is-whole .lane-head { background: #fff; }
  .lane-inst { font-weight: 600; }
  .lane-date { color: #5b6b7b; font-size: .8rem; }
  .lane-badge { font-size: .68rem; }
  .lane-total { margin-left: auto; font-weight: 600; }
  .lane-part { display: flex; align-items: center; gap: .6rem; margin: 0; padding: .45rem .6rem .45rem 1rem; border-top: 1px solid #eef2f6; cursor: pointer; }
  .lane-part:hover { background: #f3f9fd; }
  .lane-part.is-selected { background: #e3f3fc; }
  .part-checkbox { width: 1.3rem; height: 1.3rem; flex: 0 0 auto; margin: 0; cursor: pointer; accent-color: #1e9fd6; border: 2px solid #5b6b7b; }
  .part-chip { display: inline-block; padding: .1rem .55rem; border-radius: 999px; font-size: .75rem; font-weight: 600; color: #fff; }
  .part-1 { background: #1e9fd6; } .part-2 { background: #7c5cff; } .part-3 { background: #e8871e; } .part-4 { background: #2e9d5b; }
  .part-amt { margin-left: auto; font-weight: 600; }
  .lane-note { font-size: .75rem; color: #7b8996; margin-top: .25rem; }
</style>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-1">
      <div>
        <h4 class="card-title mb-1">Split Transactions</h4>
        <p class="text-muted small mb-0">Debit Order <?= e($debitOrder['debit_order_no']) ?> &bull; Loan <?= e($debitOrder['loan_no']) ?> &bull; <?= e($debitOrder['borrower_name']) ?> &bull; Total <?= format_money($debitOrder['debit_amount']) ?></p>
      </div>
      <a href="<?= url('/debit-orders/' . $debitOrder['id']) ?>" class="btn btn-outline-secondary btn-sm">Back to Debit Order</a>
    </div>

    <form id="merge-form" method="post" action="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions/merge') ?>">
      <?= csrf_field() ?>
      <div id="merge-hidden-fields"></div>

      <div class="d-flex justify-content-end align-items-center mt-3 mb-2<?= empty($mergeableIds) ? ' d-none' : '' ?>">
        <button type="button" id="merge-selected-btn" class="btn btn-outline-primary btn-sm" disabled data-bs-toggle="modal" data-bs-target="#mergeConfirmModal"><i class="mdi mdi-call-merge"></i> Merge Selected</button>
      </div>

      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
          <thead>
            <tr>
              <th style="width:30px;"></th>
              <th>Split</th>
              <th>Installment</th>
              <th>Client No</th>
              <th>Contract Reference</th>
              <th>Merchant System Contract No</th>
              <th>Next Date For Collection</th>
              <th>Collection Day</th>
              <th>Frequency</th>
              <th>Amount</th>
              <th class="text-center">No. Inst.</th>
              <th>Status</th>
              <th>Created</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <?php if (empty($splits)): ?>
              <tr><td colspan="14" class="text-center text-muted py-4">No split transactions found.</td></tr>
            <?php endif; ?>
            <?php foreach ($splits as $s): ?>
              <?php
                $isMergeResult = isset($mergeSources[$s['id']]);
                $statusBadge = match ($s['collexia_api_status']) {
                  'Registered' => 'success',
                  'Load Pending' => 'warning',
                  'Load Failed' => 'danger',
                  'Cancelled' => 'dark',
                  'Uncertain' => 'warning',
                  'Completed' => 'info',
                  default => 'secondary',
                };
                $isMergeable = in_array((int) $s['id'], $mergeableIds, true);
                $collectedDate = $collectedBySplitNo[(int) $s['split_no']] ?? null;
                // A lane = one mandate carrying several loan installments.
                $lane = ($laneInstallments ?? [])[(int) $s['id']] ?? [];
              ?>
              <tr class="<?= $s['merged_into_id'] ? 'text-muted' : '' ?>">
                <td>
                  <?php if ($isMergeable): ?>
                    <input type="checkbox" class="form-check-input split-checkbox" value="<?= (int) $s['id'] ?>" data-split-no="<?= (int) $s['split_no'] ?>" data-amount="<?= e($s['leg_amount']) ?>">
                  <?php endif; ?>
                </td>
                <td>
                  <?php if ($isMergeResult): ?>
                    <span class="badge bg-info">Merged</span> <span class="small text-muted">(from #<?= implode(', #', $mergeSources[$s['id']]) ?>)</span>
                  <?php elseif ($lane): ?>
                    <?php $laneCarriesParts = (bool) array_filter(array_count_values(array_map(fn ($r) => (int) $r['schedule_id'], $lane)), fn ($n) => $n > 1); ?>
                    <?php if ($laneCarriesParts): ?>
                      <strong>Mandate <?= (int) $s['split_no'] ?></strong>
                      <div class="text-muted small">one mandate, split parts inside</div>
                    <?php else: ?>
                      Part <?= (int) $s['split_no'] ?> of <?= (int) $s['total_splits'] ?>
                    <?php endif; ?>
                  <?php else: ?>
                    #<?= (int) ($positionInInstallment[(int) $s['id']] ?? $s['split_no']) ?> of <?= (int) $s['total_splits'] ?>
                  <?php endif; ?>
                </td>
                <td class="small lane-cell">
                  <?php if ($lane): ?>
                    <?php
                      // Parts of one installment can be merged while the mandate has NOT gone to Collexia (nothing to cancel there).
                      $canMergeParts = !$s['merged_into_id'] && in_array($s['collexia_api_status'], ['Not Placed', 'Load Failed'], true)
                        && !array_filter($lane, fn ($r) => $r['applied_at'] !== null);
                      $groups = [];
                      foreach ($lane as $li) {
                        $groups[(int) $li['schedule_id']][] = $li;
                      }
                      $hasSplitParts = (bool) array_filter($groups, fn ($g) => count($g) > 1);
                      $datesPending = (bool) array_filter($lane, fn ($r) => $r['applied_at'] === null);
                    ?>
                    <div class="lane-box">
                      <div class="lane-toolbar">
                        <span class="lane-title"><?= count($lane) ?> installment<?= count($lane) === 1 ? '' : 's' ?> in this mandate</span>
                        <?php if ($canMergeParts && $hasSplitParts): ?>
                          <button type="button" class="btn btn-sm btn-primary merge-parts-btn" disabled data-leg="<?= (int) $s['id'] ?>"
                            data-url="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions/' . (int) $s['split_no'] . '/merge-parts') ?>">
                            <i class="mdi mdi-call-merge"></i> Merge selected parts
                          </button>
                        <?php endif; ?>
                      </div>
                      <?php if ($canMergeParts && $hasSplitParts): ?>
                        <div class="lane-summary" data-leg="<?= (int) $s['id'] ?>">Tick two or more parts of the <strong>same</strong> installment, then merge them into one.</div>
                      <?php elseif ($hasSplitParts): ?>
                        <div class="lane-summary">Parts can only be merged before the mandate is placed with Collexia.</div>
                      <?php endif; ?>

                      <?php foreach ($groups as $parts): ?>
                        <?php
                          $count = count($parts);
                          $groupTotal = round(array_sum(array_map(fn ($r) => (float) $r['planned_amount'], $parts)), 2);
                          $first = $parts[0];
                          $when = date('d M Y', strtotime($first['collexia_date'] ?: $first['planned_date']));
                        ?>
                        <div class="lane-group <?= $count > 1 ? 'is-split' : 'is-whole' ?>">
                          <div class="lane-head">
                            <span class="lane-inst">Installment <?= (int) $first['loan_installment_no'] ?></span>
                            <span class="lane-date"><i class="mdi mdi-calendar-blank-outline"></i> <?= e($when) ?></span>
                            <?php if (!empty($first['cancelled_at'])): ?>
                              <span class="badge bg-secondary lane-badge" title="<?= e((string) ($first['cancel_note'] ?? '')) ?>">Paid by hand &middot; cancelled</span>
                            <?php elseif (!empty($first['auto_cancel'])): ?>
                              <span class="badge bg-warning text-dark lane-badge" title="<?= e((string) ($first['cancel_note'] ?? 'Will be cancelled at Collexia automatically once the mandate is confirmed.')) ?>">Paid by hand &middot; to be cancelled</span>
                            <?php endif; ?>
                            <?php if ($count > 1): ?>
                              <span class="badge bg-info lane-badge">Split in <?= $count ?></span>
                            <?php else: ?>
                              <span class="badge bg-light text-muted border lane-badge">Whole</span>
                            <?php endif; ?>
                            <span class="lane-total"><?= format_money($groupTotal) ?></span>
                          </div>
                          <?php if ($count > 1): ?>
                            <?php foreach ($parts as $idx => $li): ?>
                              <label class="lane-part">
                                <?php if ($canMergeParts): ?>
                                  <input type="checkbox" class="part-checkbox" value="<?= (int) $li['id'] ?>" data-leg="<?= (int) $s['id'] ?>" data-schedule="<?= (int) $li['schedule_id'] ?>" data-amount="<?= e($li['planned_amount']) ?>" data-label="#<?= (int) $li['loan_installment_no'] ?>" aria-label="Select part <?= $idx + 1 ?> of installment <?= (int) $li['loan_installment_no'] ?>">
                                <?php endif; ?>
                                <span class="part-chip part-<?= ($idx % 4) + 1 ?>">Part <?= $idx + 1 ?> of <?= $count ?></span>
                                <span class="part-amt"><?= format_money((float) $li['planned_amount']) ?></span>
                              </label>
                            <?php endforeach; ?>
                          <?php endif; ?>
                        </div>
                      <?php endforeach; ?>

                      <?php if ($datesPending): ?>
                        <div class="lane-note">Collection dates are confirmed with Collexia after the mandate is placed.</div>
                      <?php endif; ?>
                    </div>
                  <?php elseif (!empty($s['installment_no'])): ?>
                    #<?= (int) $s['installment_no'] ?> &bull; <?= e(date('d M Y', strtotime($s['installment_due_date']))) ?>
                  <?php else: ?>
                    &mdash;
                  <?php endif; ?>
                </td>
                <td class="small"><?= !empty($s['collexia_client_no']) ? e($s['collexia_client_no']) : '&mdash;' ?></td>
                <td class="small"><?= $s['collexia_api_contract_reference'] ? e($s['collexia_api_contract_reference']) : '&mdash;' ?></td>
                <td class="small"><?= !empty($s['collexia_user_reference']) ? e($s['collexia_user_reference']) : '&mdash;' ?></td>
                <td>
                  <?php if ($collectedDate): ?>
                    <?= e(date('d M Y', strtotime($collectedDate))) ?>
                  <?php elseif ($lane): ?>
                    <?= e(date('d M Y', strtotime($lane[0]['collexia_date'] ?: $lane[0]['planned_date']))) ?> <span class="small text-muted">(first)</span>
                  <?php elseif (!empty($s['collection_date'])): ?>
                    <?= e(date('d M Y', strtotime($s['collection_date']))) ?> <span class="small text-muted">(planned)</span>
                  <?php else: ?>
                    &mdash;
                  <?php endif; ?>
                </td>
                <td><?= \App\Support\CollexiaV3Codes::collectionDay(!empty($s['collection_date']) ? (int) date('j', strtotime($s['collection_date'])) : (int) $debitOrder['debit_day']) ?></td>
                <td>Monthly</td>
                <td><?= format_money($s['leg_amount']) ?></td>
                <td class="text-center"><?= $lane ? count($lane) : 1 ?></td>
                <td>
                  <span class="badge bg-<?= $statusBadge ?>"><?= e($s['collexia_api_status']) ?></span>
                  <?php if ($s['merged_into_id']): ?>
                    <div class="small text-muted">&rarr; merged into #<?= (int) ($idToSplitNo[$s['merged_into_id']] ?? '?') ?></div>
                  <?php endif; ?>
                </td>
                <td class="small text-muted"><?= e(date('d M Y H:i', strtotime($s['created_at']))) ?></td>
                <td>
                  <?php if (!$s['merged_into_id'] && in_array($s['collexia_api_status'], ['Not Placed', 'Load Failed'], true)): ?>
                    <button type="button" class="btn btn-sm btn-outline-warning retry-placement-btn"
                      data-url="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions/' . (int) $s['split_no'] . '/place') ?>"
                      data-split-no="<?= (int) $s['split_no'] ?>">
                      <i class="mdi mdi-refresh"></i> Retry Placement
                    </button>
                  <?php endif; ?>
                  <?php if (!$s['merged_into_id'] && in_array($s['collexia_api_status'], ['Registered', 'Load Pending'], true)): ?>
                    <a href="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions/' . (int) $s['split_no'] . '/installments') ?>" class="btn btn-sm btn-outline-secondary">
                      <i class="mdi mdi-calendar-edit"></i> Reschedule
                    </a>
                  <?php endif; ?>
                  <?php if ($isMergeResult && $s['collexia_api_status'] === 'Load Failed'): ?>
                    <button type="button" class="btn btn-sm btn-outline-secondary unmerge-btn"
                      data-url="<?= url('/debit-orders/' . $debitOrder['id'] . '/split-transactions/' . (int) $s['split_no'] . '/unmerge') ?>"
                      data-split-no="<?= (int) $s['split_no'] ?>"
                      data-sources="<?= e(implode(', #', $mergeSources[$s['id']])) ?>">
                      <i class="mdi mdi-call-split"></i> Un-merge
                    </button>
                  <?php endif; ?>
                </td>
              </tr>
            <?php endforeach; ?>
          </tbody>
        </table>
      </div>
    </form>

    <!-- Deliberately its own top-level form, not nested inside merge-form
         above -- nested <form> elements are invalid HTML and get silently
         dropped by the browser, which would submit this button into the
         merge form instead (and did, before this was split out). -->
    <form id="retry-placement-form" method="post" action="">
      <?= csrf_field() ?>
    </form>

    <!-- Same reason: its own top-level form. Filled in by the "Merge selected parts" button below. -->
    <form id="merge-parts-form" method="post" action="">
      <?= csrf_field() ?>
      <div id="merge-parts-fields"></div>
    </form>
  </div>
</div>

<!-- Merge confirmation modal -->
<div class="modal fade" id="mergeConfirmModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Confirm Merge</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>The following split transactions will be merged into one:</p>
        <ul id="merge-summary-list" class="mb-2"></ul>
        <p class="fw-bold">Combined amount: <span id="merge-summary-total"></span></p>
        <p class="text-muted small mb-0">Any of these already placed with Collexia will be cancelled there first. A new split transaction is created for the combined amount -- place its mandate separately once you're ready.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="merge-confirm-btn" class="btn btn-primary">Confirm Merge</button>
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var mergeBtn = document.getElementById('merge-selected-btn');
  var confirmBtn = document.getElementById('merge-confirm-btn');
  var summaryList = document.getElementById('merge-summary-list');
  var summaryTotal = document.getElementById('merge-summary-total');
  var hiddenFields = document.getElementById('merge-hidden-fields');
  var form = document.getElementById('merge-form');

  function money(n) {
    return 'N$' + (Math.round(n * 100) / 100).toFixed(2);
  }

  function selectedCheckboxes() {
    return Array.prototype.slice.call(document.querySelectorAll('.split-checkbox:checked'));
  }

  function refreshMergeButton() {
    mergeBtn.disabled = selectedCheckboxes().length < 2;
  }

  document.querySelectorAll('.split-checkbox').forEach(function (cb) {
    cb.addEventListener('change', refreshMergeButton);
  });

  mergeBtn.addEventListener('click', function () {
    var selected = selectedCheckboxes();
    summaryList.innerHTML = '';
    var total = 0;
    selected.forEach(function (cb) {
      var amount = parseFloat(cb.getAttribute('data-amount')) || 0;
      total += amount;
      var li = document.createElement('li');
      li.textContent = 'Split #' + cb.getAttribute('data-split-no') + ' - ' + money(amount);
      summaryList.appendChild(li);
    });
    summaryTotal.textContent = money(total);
  });

  confirmBtn.addEventListener('click', function () {
    hiddenFields.innerHTML = '';
    selectedCheckboxes().forEach(function (cb) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = 'split_ids[]';
      input.value = cb.value;
      hiddenFields.appendChild(input);
    });
    form.submit();
  });

  var retryForm = document.getElementById('retry-placement-form');
  document.querySelectorAll('.retry-placement-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!confirm('Retry placing split #' + btn.getAttribute('data-split-no') + ' with Collexia?')) {
        return;
      }
      retryForm.action = btn.getAttribute('data-url');
      retryForm.submit();
    });
  });

  document.querySelectorAll('.unmerge-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var msg = 'Un-merge split #' + btn.getAttribute('data-split-no') + ' back into split(s) #' + btn.getAttribute('data-sources') + '? '
        + 'This retires the failed combined split and creates fresh, unplaced splits for the original amounts.';
      if (!confirm(msg)) {
        return;
      }
      retryForm.action = btn.getAttribute('data-url');
      retryForm.submit();
    });
  });
})();
</script>

<script>
(function () {
  function money(n) { return 'N$' + (Math.round(n * 100) / 100).toFixed(2); }
  function selectedFor(leg) {
    return Array.prototype.slice.call(document.querySelectorAll('.part-checkbox[data-leg="' + leg + '"]:checked'));
  }
  function refresh(leg) {
    var btn = document.querySelector('.merge-parts-btn[data-leg="' + leg + '"]');
    var summary = document.querySelector('.lane-summary[data-leg="' + leg + '"]');
    document.querySelectorAll('.part-checkbox[data-leg="' + leg + '"]').forEach(function (cb) {
      var row = cb.closest('.lane-part');
      if (row) row.classList.toggle('is-selected', cb.checked);
    });
    if (!btn) return;
    var sel = selectedFor(leg);
    var schedules = {};
    var total = 0;
    sel.forEach(function (cb) { schedules[cb.getAttribute('data-schedule')] = true; total += parseFloat(cb.getAttribute('data-amount')); });
    var sameInstallment = Object.keys(schedules).length === 1;
    var ready = sel.length >= 2 && sameInstallment;
    btn.disabled = !ready;
    btn.title = sel.length >= 2 && !sameInstallment ? 'Select parts of the same installment only' : '';
    if (summary) {
      summary.classList.toggle('is-ready', ready);
      if (ready) {
        summary.textContent = sel.length + ' parts of installment ' + sel[0].getAttribute('data-label').replace('#', '') + ' selected \u2014 they will become one ' + money(total) + ' installment.';
      } else if (sel.length >= 2) {
        summary.textContent = 'Those parts belong to different installments. Select parts of the same installment only.';
      } else {
        summary.textContent = 'Tick two or more parts of the same installment, then merge them into one.';
      }
    }
  }
  document.querySelectorAll('.part-checkbox').forEach(function (cb) {
    cb.addEventListener('change', function () { refresh(cb.getAttribute('data-leg')); });
  });
  document.querySelectorAll('.merge-parts-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var sel = selectedFor(btn.getAttribute('data-leg'));
      if (sel.length < 2) return;
      var total = 0;
      sel.forEach(function (cb) { total += parseFloat(cb.getAttribute('data-amount')); });
      var parts = sel.map(function (cb) { return money(parseFloat(cb.getAttribute('data-amount'))); }).join(' + ');
      var message = 'Merge these parts of installment ' + sel[0].getAttribute('data-label') + ' into one?\n\n'
        + parts + ' = ' + money(total) + '\n\n'
        + 'Nothing has been sent to Collexia yet, and the total to collect does not change.';
      if (!window.confirm(message)) return;
      var fields = document.getElementById('merge-parts-fields');
      fields.innerHTML = '';
      sel.forEach(function (cb) {
        var input = document.createElement('input');
        input.type = 'hidden'; input.name = 'part_ids[]'; input.value = cb.value;
        fields.appendChild(input);
      });
      var form = document.getElementById('merge-parts-form');
      form.action = btn.getAttribute('data-url');
      form.submit();
    });
  });
})();
</script>
