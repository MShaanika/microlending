<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Expenses</h4>
      <a href="<?= url('/expenses/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Capture Expense</a>
    </div>

    <?php
      $bar = [
          'action' => url('/expenses'),
          'search' => ['value' => $search ?? '', 'placeholder' => 'Expense no, supplier or category'],
          'status' => ['value' => $status ?? '', 'options' => ['Draft', 'Pending Approval', 'Approved', 'Paid', 'Rejected', 'Cancelled']],
          'selects' => [['name' => 'category_id', 'label' => 'Category', 'all' => 'All Categories', 'value' => (int) ($categoryId ?? 0) ?: '', 'options' => array_column($categories ?? [], 'category_name', 'id')]],
          'branches' => $branches ?? [], 'branch' => $selectedBranchId ?? null,
          'date' => ['label' => 'Expense date', 'from' => $filter['from'] ?? '', 'to' => $filter['to'] ?? ''],
          'amount' => ['label' => 'Total', 'min' => $filter['min'] ?? '', 'max' => $filter['max'] ?? ''],
          'export' => true,
      ];
      include __DIR__ . '/../partials/list_filter_bar.php';
    ?>

    <div data-list-results>
    <?php $count = count($expenses); include __DIR__ . '/../partials/list_count.php'; ?>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Expense No</th><th>Date</th><th>Category</th><th>Supplier</th><th>Total</th><th>Status</th><th class="text-end">Action</th></tr>
        </thead>
        <tbody>
          <?php if (empty($expenses)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4"><?= !empty($filtersActive) ? 'Nothing matches your filters.' : 'No expenses yet.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($expenses as $e): ?>
            <?php
              $badge = match ($e['status']) {
                'Paid' => 'success',
                'Rejected', 'Cancelled' => 'danger',
                'Approved' => 'info',
                'Pending Approval' => 'warning',
                default => 'secondary',
              };
            ?>
            <tr>
              <td><?= e($e['expense_no']) ?></td>
              <td><?= e(date('d M Y', strtotime($e['expense_date']))) ?></td>
              <td><?= e($e['category_name']) ?></td>
              <td><?= e($e['supplier_name']) ?: '&mdash;' ?></td>
              <td><?= format_money($e['total_amount']) ?></td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($e['status']) ?></span></td>
              <td class="text-end">
                <a href="<?= url('/expenses/' . $e['id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i></a>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
