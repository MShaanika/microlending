<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Employee Reviews</h4>
      <?php if (Auth::can('performance.manage')): ?>
        <a href="<?= url('/performance/employee-reviews/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Schedule Review</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/performance/employee-reviews') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search by employee..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <div class="d-flex gap-2">
        <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
          <?php foreach ([10, 25, 50, 100] as $pp): ?>
            <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
          <?php endforeach; ?>
        </select>
        <div class="dropdown">
          <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="mdi mdi-filter-variant"></i> Filters
          </button>
          <div class="dropdown-menu dropdown-menu-end p-3" style="min-width:260px">
            <div class="mb-2">
              <label class="form-label small">Employee</label>
              <select name="employee_id" class="form-select form-select-sm">
                <option value="">All employees</option>
                <?php foreach ($employees as $emp): ?>
                  <option value="<?= (int) $emp['id'] ?>" <?= (string) $filters['employee_id'] === (string) $emp['id'] ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
                <?php endforeach; ?>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small">Cycle</label>
              <select name="review_cycle_id" class="form-select form-select-sm">
                <option value="">All cycles</option>
                <?php foreach ($cycles as $c): ?>
                  <option value="<?= (int) $c['id'] ?>" <?= (string) $filters['review_cycle_id'] === (string) $c['id'] ? 'selected' : '' ?>><?= e($c['name']) ?></option>
                <?php endforeach; ?>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small">Status</label>
              <select name="status" class="form-select form-select-sm">
                <option value="">All statuses</option>
                <?php foreach ($statuses as $s): ?>
                  <option value="<?= $s ?>" <?= $filters['status'] === $s ? 'selected' : '' ?>><?= $s ?></option>
                <?php endforeach; ?>
              </select>
            </div>
            <button type="submit" class="btn btn-sm btn-info w-100">Apply Filters</button>
          </div>
        </div>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Employee', 'employee', $_GET, $sort, $dir) ?>
            <?= sortable_th('Reviewer', 'reviewer', $_GET, $sort, $dir) ?>
            <?= sortable_th('Cycle', 'review_cycle', $_GET, $sort, $dir) ?>
            <?= sortable_th('Review Date', 'review_date', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($reviews)): ?>
            <tr><td colspan="5" class="text-center text-muted py-4">No employee reviews found.</td></tr>
          <?php endif; ?>
          <?php foreach ($reviews as $r):
            $statusBadge = ['Pending' => 'warning', 'In Progress' => 'info', 'Completed' => 'success', 'Cancelled' => 'dark'][$r['status']] ?? 'secondary';
          ?>
            <tr>
              <td><a href="<?= url('/performance/employee-reviews/' . $r['id']) ?>"><?= e($r['employee_name']) ?></a></td>
              <td><?= e($r['reviewer_name'] ?: '—') ?></td>
              <td><?= e($r['review_cycle_name'] ?: '—') ?></td>
              <td><?= e(date('d M Y', strtotime($r['review_date']))) ?></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($r['status']) ?></span></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($reviews) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
