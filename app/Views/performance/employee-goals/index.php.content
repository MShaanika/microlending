<?php
use App\Core\Auth;
use App\Models\PerformanceEmployeeGoal;
?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Employee Goals</h4>
      <?php if (Auth::can('performance.manage')): ?>
        <a href="<?= url('/performance/employee-goals/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/performance/employee-goals/create') ?>" data-modal-title="New Employee Goal" data-modal-size="lg"><i class="mdi mdi-plus"></i> New Goal</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/performance/employee-goals') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search goals..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <div class="d-flex gap-2">
        <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
          <?php foreach ([10, 25, 50, 100] as $pp): ?>
            <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
          <?php endforeach; ?>
        </select>
        <div class="dropdown">
          <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="mdi mdi-filter-variant"></i> Filters
          </button>
          <div class="dropdown-menu dropdown-menu-end p-3" style="min-width:260px">
            <div class="mb-2">
              <label class="form-label small">Employee</label>
              <select name="employee_id" class="form-select form-select-sm">
                <option value="">All employees</option>
                <?php foreach ($employees as $emp): ?>
                  <option value="<?= (int) $emp['id'] ?>" <?= (string) $filters['employee_id'] === (string) $emp['id'] ? 'selected' : '' ?>><?= e($emp['first_name'] . ' ' . $emp['last_name']) ?></option>
                <?php endforeach; ?>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small">Goal Type</label>
              <select name="goal_type_id" class="form-select form-select-sm">
                <option value="">All goal types</option>
                <?php foreach ($goalTypes as $gt): ?>
                  <option value="<?= (int) $gt['id'] ?>" <?= (string) $filters['goal_type_id'] === (string) $gt['id'] ? 'selected' : '' ?>><?= e($gt['name']) ?></option>
                <?php endforeach; ?>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small">Status</label>
              <select name="status" class="form-select form-select-sm">
                <option value="">All statuses</option>
                <?php foreach ($statuses as $s): ?>
                  <option value="<?= $s ?>" <?= $filters['status'] === $s ? 'selected' : '' ?>><?= $s ?></option>
                <?php endforeach; ?>
              </select>
            </div>
            <button type="submit" class="btn btn-sm btn-info w-100">Apply Filters</button>
          </div>
        </div>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Employee', 'employee', $_GET, $sort, $dir) ?>
            <?= sortable_th('Title', 'title', $_GET, $sort, $dir) ?>
            <?= sortable_th('Goal Type', 'goal_type', $_GET, $sort, $dir) ?>
            <?= sortable_th('Period', 'end_date', $_GET, $sort, $dir) ?>
            <th>Target</th>
            <th>Progress</th>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <?php if (Auth::can('performance.manage')): ?><th class="text-end">Actions</th><?php endif; ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($goals)): ?>
            <tr><td colspan="8" class="text-center text-muted py-4">No employee goals found.</td></tr>
          <?php endif; ?>
          <?php foreach ($goals as $g):
            $statusBadge = ['Not Started' => 'secondary', 'In Progress' => 'info', 'Completed' => 'success', 'Overdue' => 'danger'][$g['status']] ?? 'secondary';
            $pct = PerformanceEmployeeGoal::progressPercentage($g);
          ?>
            <tr>
              <td><?= e($g['employee_name']) ?></td>
              <td><?= e($g['title']) ?></td>
              <td><?= e($g['goal_type_name'] ?: '—') ?></td>
              <td><?= e(date('d M Y', strtotime($g['start_date']))) ?> &ndash; <?= e(date('d M Y', strtotime($g['end_date']))) ?></td>
              <td><?= e($g['target']) ?></td>
              <td style="min-width:140px;">
                <?php if ($pct !== null): ?>
                  <div class="progress" style="height: 16px;">
                    <div class="progress-bar bg-info" style="width: <?= $pct ?>%"><?= $pct ?>%</div>
                  </div>
                <?php else: ?>
                  <?= e($g['progress']) ?>
                <?php endif; ?>
              </td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($g['status']) ?></span></td>
              <?php if (Auth::can('performance.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/performance/employee-goals/' . $g['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary" data-modal-url="<?= url('/performance/employee-goals/' . $g['id'] . '/edit') ?>" data-modal-title="Edit Employee Goal" data-modal-size="lg"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/performance/employee-goals/' . $g['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Delete this goal?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($goals) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
