<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Performance Indicators</h4>
      <?php if (Auth::can('performance.manage')): ?>
        <a href="<?= url('/performance/indicators/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Add Indicator</a>
      <?php endif; ?>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Name</th><th>Category</th><th>Measurement Unit</th><th>Target</th><th>Status</th><?php if (Auth::can('performance.manage')): ?><th></th><?php endif; ?></tr>
        </thead>
        <tbody>
          <?php if (empty($indicators)): ?>
            <tr><td colspan="6" class="text-center text-muted py-4">No performance indicators yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($indicators as $i): ?>
            <tr>
              <td><?= e($i['name']) ?></td>
              <td><?= e($i['category_name'] ?: '—') ?></td>
              <td><?= e($i['measurement_unit'] ?: '—') ?></td>
              <td><?= e($i['target_value'] ?: '—') ?></td>
              <td><span class="badge bg-<?= $i['status'] === 'Active' ? 'success' : 'secondary' ?>"><?= e($i['status']) ?></span></td>
              <?php if (Auth::can('performance.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/performance/indicators/' . $i['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/performance/indicators/' . $i['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Delete this indicator?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
