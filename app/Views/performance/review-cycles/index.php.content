<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Review Cycles</h4>
      <?php if (Auth::can('performance.manage')): ?>
        <a href="<?= url('/performance/review-cycles/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/performance/review-cycles/create') ?>" data-modal-title="Add Review Cycle" data-modal-size="md"><i class="mdi mdi-plus"></i> Add Review Cycle</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/performance/review-cycles') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search review cycles..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
        <?php foreach ([10, 25, 50, 100] as $pp): ?>
          <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
        <?php endforeach; ?>
      </select>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Name', 'name', $_GET, $sort, $dir) ?>
            <th>Frequency</th>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <?php if (Auth::can('performance.manage')): ?><th class="text-end">Actions</th><?php endif; ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($cycles)): ?>
            <tr><td colspan="4" class="text-center text-muted py-4">No review cycles found.</td></tr>
          <?php endif; ?>
          <?php foreach ($cycles as $c): ?>
            <tr>
              <td><a href="<?= url('/performance/review-cycles/' . $c['id']) ?>" data-modal-url="<?= url('/performance/review-cycles/' . $c['id']) ?>" data-modal-title="<?= e($c['name']) ?>" data-modal-size="lg"><?= e($c['name']) ?></a></td>
              <td><?= e($c['frequency']) ?></td>
              <td><span class="badge bg-<?= $c['status'] === 'Active' ? 'success' : 'secondary' ?>"><?= e($c['status']) ?></span></td>
              <?php if (Auth::can('performance.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/performance/review-cycles/' . $c['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary" data-modal-url="<?= url('/performance/review-cycles/' . $c['id'] . '/edit') ?>" data-modal-title="Edit Review Cycle" data-modal-size="md"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/performance/review-cycles/' . $c['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Delete this review cycle?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($cycles) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
