<?php
  $cardDefs = [
      ['new', 'New', '#635bff', 'mdi-bug', ['status' => 'NEW']],
      ['critical', 'Critical', '#9C3B34', 'mdi-alert-octagon', ['severity' => 'Critical']],
      ['unresolved', 'Unresolved', '#ff5c75', 'mdi-alert', []],
      ['today', 'Seen Today', '#f9ab00', 'mdi-clock-fast', []],
  ];
?>

<?= flash_messages() ?>

<div class="row">
  <?php foreach ($cardDefs as [$key, $label, $color, $icon, $linkParams]): ?>
    <div class="col-xl-3 col-lg-6 col-md-6 mb-3">
      <a href="<?= url('/errors' . ($linkParams ? '?' . http_build_query($linkParams) : '')) ?>" class="text-decoration-none">
        <div class="card kpi-card h-100" style="border-left-color:<?= $color ?>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h3 class="kpi-number mb-1"><?= (int) $counts[$key] ?></h3>
                <span class="text-muted small"><?= e($label) ?></span>
              </div>
              <span class="kpi-icon" style="background:<?= $color ?>"><i class="mdi <?= $icon ?>"></i></span>
            </div>
          </div>
        </div>
      </a>
    </div>
  <?php endforeach; ?>
</div>

<?php if (!empty($mostFrequent)): ?>
<div class="card mb-3">
  <div class="card-body">
    <h5 class="card-title">Most Frequent (Unresolved)</h5>
    <ul class="list-unstyled mb-0">
      <?php foreach ($mostFrequent as $mf): ?>
        <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
          <div>
            <span class="badge bg-secondary me-1"><?= (int) $mf['occurrence_count'] ?>x</span>
            <span class="fw-semibold"><?= e($mf['exception_class']) ?></span>
            <span class="text-muted small">&mdash; <?= e(mb_strimwidth($mf['safe_message'], 0, 80, '…')) ?></span>
          </div>
          <a href="<?= url('/errors/' . $mf['id']) ?>" class="btn btn-sm btn-outline-primary">View</a>
        </li>
      <?php endforeach; ?>
    </ul>
  </div>
</div>
<?php endif; ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">All Errors</h4>
    </div>

    <form method="get" action="<?= url('/errors') ?>" class="row g-2 mb-3">
      <div class="col-md-2">
        <select name="module" class="form-select">
          <option value="">All modules</option>
          <?php foreach ($modules as $m): ?>
            <option value="<?= e($m) ?>" <?= $filters['module'] === $m ? 'selected' : '' ?>><?= e($m) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-2">
        <select name="severity" class="form-select">
          <option value="">All severities</option>
          <?php foreach (['Low', 'Medium', 'High', 'Critical'] as $s): ?>
            <option value="<?= $s ?>" <?= $filters['severity'] === $s ? 'selected' : '' ?>><?= $s ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-2">
        <select name="status" class="form-select">
          <option value="">All statuses</option>
          <?php foreach (['NEW', 'INVESTIGATING', 'RESOLVED', 'IGNORED', 'REOPENED'] as $s): ?>
            <option value="<?= $s ?>" <?= $filters['status'] === $s ? 'selected' : '' ?>><?= $s ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-3">
        <input type="text" name="correlation_id" class="form-control" placeholder="Correlation ID..." value="<?= e($filters['correlation_id']) ?>">
      </div>
      <div class="col-12">
        <button type="submit" class="btn btn-outline-secondary btn-sm"><i class="mdi mdi-magnify"></i> Filter</button>
        <a href="<?= url('/errors') ?>" class="btn btn-outline-light btn-sm">Clear</a>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Last Seen</th>
            <th>Exception</th>
            <th>Module</th>
            <th>Occurrences</th>
            <th>Severity</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($errors['rows'])): ?>
            <tr><td colspan="7" class="text-center text-muted py-4">No errors recorded.</td></tr>
          <?php endif; ?>
          <?php foreach ($errors['rows'] as $err):
            $sevBadge = match ($err['severity']) {
              'Critical', 'High' => 'danger',
              'Medium' => 'warning',
              default => 'info',
            };
            $statusBadge = match ($err['status']) {
              'NEW' => 'danger',
              'INVESTIGATING' => 'warning',
              'REOPENED' => 'dark',
              'RESOLVED' => 'success',
              'IGNORED' => 'secondary',
              default => 'secondary',
            };
          ?>
            <tr>
              <td class="text-nowrap"><?= e(date('d M Y H:i', strtotime($err['last_seen_at']))) ?></td>
              <td><?= e($err['exception_class']) ?><div class="text-muted small"><?= e(mb_strimwidth($err['safe_message'], 0, 60, '…')) ?></div></td>
              <td><span class="badge bg-light text-dark"><?= e($err['module'] ?: '—') ?></span></td>
              <td><?= (int) $err['occurrence_count'] ?></td>
              <td><span class="badge bg-<?= $sevBadge ?>"><?= e($err['severity']) ?></span></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($err['status']) ?></span></td>
              <td><a href="<?= url('/errors/' . $err['id']) ?>" class="btn btn-sm btn-outline-primary">View</a></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($errors['rows']) ?> of <?= $errors['total'] ?> result<?= $errors['total'] === 1 ? '' : 's' ?></p>
      <?= pagination_nav((int) ($_GET['page'] ?? 1), $errors['totalPages'], $_GET) ?>
    </div>
  </div>
</div>
