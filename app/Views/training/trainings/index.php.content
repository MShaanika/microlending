<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Trainings</h4>
      <?php if (Auth::can('training.manage')): ?>
        <a href="<?= url('/training/trainings/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Schedule Training</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/training/trainings') ?>" class="row g-2 align-items-end mb-3">
      <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select" onchange="this.form.submit()">
          <option value="">All</option>
          <?php foreach (['Scheduled', 'Ongoing', 'Completed', 'Cancelled'] as $s): ?>
            <option value="<?= e($s) ?>" <?= (($filters['status'] ?? '') === $s) ? 'selected' : '' ?>><?= e($s) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Training Type</label>
        <select name="training_type_id" class="form-select" onchange="this.form.submit()">
          <option value="">All</option>
          <?php foreach ($types as $t): ?>
            <option value="<?= (int) $t['id'] ?>" <?= (($filters['training_type_id'] ?? '') == $t['id']) ? 'selected' : '' ?>><?= e($t['name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label">Department</label>
        <select name="department_id" class="form-select" onchange="this.form.submit()">
          <option value="">All</option>
          <?php foreach ($departments as $d): ?>
            <option value="<?= (int) $d['id'] ?>" <?= (($filters['department_id'] ?? '') == $d['id']) ? 'selected' : '' ?>><?= e($d['department_name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Title</th><th>Type</th><th>Trainer</th><th>Dates</th><th>Department</th><th>Status</th><th></th></tr>
        </thead>
        <tbody>
          <?php if (empty($trainings)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4">No trainings yet.</td></tr>
          <?php endif; ?>
          <?php $statusBadge = ['Scheduled' => 'info', 'Ongoing' => 'warning', 'Completed' => 'success', 'Cancelled' => 'dark']; ?>
          <?php foreach ($trainings as $t): ?>
            <tr>
              <td><a href="<?= url('/training/trainings/' . $t['id']) ?>"><?= e($t['title']) ?></a></td>
              <td><?= e($t['training_type_name'] ?: '—') ?></td>
              <td><?= e($t['trainer_name'] ?: '—') ?></td>
              <td><?= e(date('d M Y', strtotime($t['start_date']))) ?> &ndash; <?= e(date('d M Y', strtotime($t['end_date']))) ?></td>
              <td><?= e($t['department_name'] ?: '—') ?></td>
              <td><span class="badge bg-<?= $statusBadge[$t['status']] ?? 'secondary' ?>"><?= e($t['status']) ?></span></td>
              <td class="text-end">
                <a href="<?= url('/training/trainings/' . $t['id']) ?>" class="btn btn-sm btn-outline-primary"><i class="mdi mdi-eye"></i></a>
                <?php if (Auth::can('training.manage')): ?>
                <a href="<?= url('/training/trainings/' . $t['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-pencil"></i></a>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
