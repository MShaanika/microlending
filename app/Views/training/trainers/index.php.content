<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Trainers</h4>
      <?php if (Auth::can('training.manage')): ?>
        <a href="<?= url('/training/trainers/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Add Trainer</a>
      <?php endif; ?>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Name</th><th>Contact</th><th>Email</th><th>Experience</th><th>Department</th><th>Status</th><?php if (Auth::can('training.manage')): ?><th></th><?php endif; ?></tr>
        </thead>
        <tbody>
          <?php if (empty($trainers)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4">No trainers yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($trainers as $t): ?>
            <tr>
              <td><?= e($t['name']) ?></td>
              <td><?= e($t['contact'] ?: '—') ?></td>
              <td><?= e($t['email'] ?: '—') ?></td>
              <td><?= e($t['experience'] ?: '—') ?></td>
              <td><?= e($t['department_name'] ?: '—') ?></td>
              <td><span class="badge bg-<?= $t['status'] === 'Active' ? 'success' : 'secondary' ?>"><?= e($t['status']) ?></span></td>
              <?php if (Auth::can('training.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/training/trainers/' . $t['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/training/trainers/' . $t['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Delete this trainer?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
