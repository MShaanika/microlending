<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Trainers</h4>
      <?php if (Auth::can('training.manage')): ?>
        <a href="<?= url('/training/trainers/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Add Trainer</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/training/trainers') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search trainers..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
        <?php foreach ([10, 25, 50, 100] as $pp): ?>
          <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
        <?php endforeach; ?>
      </select>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Name', 'name', $_GET, $sort, $dir) ?>
            <th>Contact</th>
            <th>Email</th>
            <th>Experience</th>
            <?= sortable_th('Department', 'department', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <?php if (Auth::can('training.manage')): ?><th class="text-end">Actions</th><?php endif; ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($trainers)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4">No trainers found.</td></tr>
          <?php endif; ?>
          <?php foreach ($trainers as $t): ?>
            <tr>
              <td><?= e($t['name']) ?></td>
              <td><?= e($t['contact'] ?: '—') ?></td>
              <td><?= e($t['email'] ?: '—') ?></td>
              <td><?= e($t['experience'] ?: '—') ?></td>
              <td><?= e($t['department_name'] ?: '—') ?></td>
              <td><span class="badge bg-<?= $t['status'] === 'Active' ? 'success' : 'secondary' ?>"><?= e($t['status']) ?></span></td>
              <?php if (Auth::can('training.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/training/trainers/' . $t['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/training/trainers/' . $t['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Delete this trainer?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($trainers) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
