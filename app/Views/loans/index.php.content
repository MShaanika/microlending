<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
      <h4 class="card-title mb-0">Loans</h4>
      <a href="<?= url('/loans/create') ?>" class="btn btn-info waves-effect waves-light">
        <i class="mdi mdi-plus"></i> New Loan
      </a>
    </div>

    <?php
      $bar = [
          'action' => url('/loans'),
          'search' => ['value' => $search ?? '', 'placeholder' => 'Loan no, borrower, ID number or phone'],
          'status' => ['value' => $status ?? '', 'options' => ['Draft','Pending Approval','Approved','Active','Completed','Denied','Written Off','Cancelled','Recovered - Closed','Arrear','Bad Debt','Bad Debt Recovery']],
          'branches' => $branches ?? [], 'branch' => $selectedBranchId ?? null,
          'date' => ['label' => 'Start date', 'from' => $filter['from'] ?? '', 'to' => $filter['to'] ?? ''],
          'amount' => ['label' => 'Principal', 'min' => $filter['min'] ?? '', 'max' => $filter['max'] ?? ''],
          'export' => true,
      ];
      include __DIR__ . '/../partials/list_filter_bar.php';
    ?>

    <div data-list-results>
    <?php $count = count($loans); include __DIR__ . '/../partials/list_count.php'; ?>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Loan No</th>
            <th>Borrower</th>
            <th>Product</th>
            <th>Principal</th>
            <th>Installment</th>
            <th>Term</th>
            <th>Start</th>
            <th>Status</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($loans)): ?>
            <tr><td colspan="9" class="text-center text-muted py-4"><?= !empty($filtersActive) ? 'No loans match your filters.' : 'No loans found.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($loans as $loan): ?>
            <?php
              $badge = match ($loan['loan_status']) {
                'Active', 'Current', 'Released' => 'success',
                'Completed', 'Recovered - Closed' => 'primary',
                'Denied', 'Written Off', 'Cancelled' => 'danger',
                'Approved' => 'info',
                default => 'warning',
              };
            ?>
            <tr>
              <td><?= e($loan['loan_no']) ?></td>
              <td><?= e($loan['borrower_name']) ?></td>
              <td><?= e($loan['product_name']) ?></td>
              <td>
                <?php $topupCount = (int) ($loan['topup_count'] ?? 0); ?>
                <?= format_money($topupCount > 0 ? $loan['combined_principal'] : $loan['principal_amount']) ?>
                <?php if ($topupCount > 0): ?>
                  <span class="badge bg-info" title="This loan has been topped up. The amount shown is the original loan plus its top-ups, combined."><?= $topupCount ?> top-up<?= $topupCount === 1 ? '' : 's' ?></span>
                <?php elseif (!empty($loan['topup_of_loan_id'])): ?>
                  <span class="badge bg-secondary" title="A top-up. Once released it is shown inside its original loan; it appears on its own here while it awaits release, or when you search for it.">top-up</span>
                <?php endif; ?>
              </td>
              <td><?= format_money($topupCount > 0 ? $loan['combined_installment'] : $loan['installment_amount']) ?></td>
              <td><?= (int) $loan['term_months'] ?> mo</td>
              <td><?= !empty($loan['start_date']) ? e(date('d M Y', strtotime($loan['start_date']))) : '' ?></td>
              <td>
                <span class="badge bg-<?= $badge ?>"><?= e($loan['loan_status']) ?></span>
                <?php if (!empty($loan['is_in_arrears'])): ?>
                  <span class="badge bg-danger" title="Has an overdue, unpaid installment">In Arrears</span>
                <?php endif; ?>
                <?php if (!empty($loan['bad_debt_status']) && in_array($loan['bad_debt_status'], ['Open', 'Provisioned'], true)): ?>
                  <span class="badge bg-dark">Bad Debt</span>
                <?php elseif (($loan['bad_debt_status'] ?? null) === 'Under Recovery'): ?>
                  <span class="badge bg-warning">Bad Debt Recovery</span>
                <?php endif; ?>
              </td>
              <td class="text-end">
                <a href="<?= url('/loans/' . $loan['id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i></a>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
