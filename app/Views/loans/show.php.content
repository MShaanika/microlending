              <?= !empty($disbursement['encr_checked_at']) ? '<span class="text-muted small">(checked ' . e(date('d M Y H:i', strtotime($disbursement['encr_checked_at']))) . ')</span>' : '' ?></p>
          <?php endif; ?>
