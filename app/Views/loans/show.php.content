            <div class="alert alert-<?= $encrState === 'Failed' ? 'danger' : ($encrState === 'Not Sent' ? 'warning' : 'light') ?> py-2 px-3 small mb-2"><?= e($disbursement['encr_last_message']) ?></div>
          <?php endif; ?>
          <?php if (\App\Core\Auth::can('loans.release')): ?>
            <div class="d-flex gap-2 flex-wrap">
              <?php if ($encrState === 'Not Sent'): ?>
                <form method="post" action="<?= url('/loans/' . $loan['id'] . '/encr/retry') ?>" onsubmit="return confirmSubmit(this, 'Send this payout to Collexia now? The same reference is re-used, so it cannot be paid twice.');">
                  <?= csrf_field() ?>
                  <button class="btn btn-warning btn-sm"><i class="mdi mdi-send"></i> Retry payout</button>
                </form>
              <?php elseif ($encrState !== 'Completed'): ?>
                <form method="post" action="<?= url('/loans/' . $loan['id'] . '/encr/check') ?>">
                  <?= csrf_field() ?>
                  <button class="btn btn-outline-info btn-sm"><i class="mdi mdi-refresh"></i> Check payout status</button>
                </form>
              <?php endif; ?>
            </div>
          <?php endif; ?>
        </div>
      </div>
    <?php endif; ?>

<?php if (!empty($combined)): ?>
<?php
  $cTotalDue = array_sum(array_column($combined['tranches'], 'schedule_due'));
  $cTotalPaid = array_sum(array_column($combined['tranches'], 'schedule_paid'));
  $cPrincipal = array_sum(array_column($combined['tranches'], 'principal_amount'));
  $cPayable = array_sum(array_column($combined['tranches'], 'total_payable'));
  $cInstallment = array_sum(array_column($combined['tranches'], 'installment_amount'));
?>
<div class="card mb-3" id="combined">
  <div class="card-body">
    <h4 class="card-title"><i class="mdi mdi-layers-outline me-1"></i> Combined with top-ups</h4>
    <p class="text-muted small">This loan and its top-ups, added together. Each part keeps its own schedule and accounting; nothing here changes them.</p>
    <div class="table-responsive">
      <table class="table table-sm align-middle no-datatable">
        <thead><tr><th>Loan</th><th>Status</th><th class="text-end">Principal</th><th class="text-end">Total payable</th><th class="text-end">Installment</th><th class="text-end">Collected</th><th class="text-end">Outstanding</th></tr></thead>
        <tbody>
          <?php foreach ($combined['tranches'] as $t): ?>
            <tr>
              <td><a href="<?= url('/loans/' . $t['id']) ?>"><?= e($t['loan_no']) ?></a><?= (int) $t['id'] === (int) $loan['id'] ? ' <span class="badge bg-secondary">this loan</span>' : ($t['topup_of_loan_id'] ? ' <span class="badge bg-info">top-up</span>' : '') ?></td>
              <td><?= e($t['loan_status']) ?></td>
              <td class="text-end"><?= format_money($t['principal_amount']) ?></td>
              <td class="text-end"><?= format_money($t['total_payable']) ?></td>
              <td class="text-end"><?= format_money($t['installment_amount']) ?></td>
              <td class="text-end"><?= format_money($t['schedule_paid']) ?></td>
              <td class="text-end"><?= format_money($t['schedule_due'] - $t['schedule_paid']) ?></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
        <tfoot>
          <tr class="fw-bold"><td colspan="2">Combined</td><td class="text-end"><?= format_money($cPrincipal) ?></td><td class="text-end"><?= format_money($cPayable) ?></td><td class="text-end"><?= format_money($cInstallment) ?></td><td class="text-end"><?= format_money($cTotalPaid) ?></td><td class="text-end"><?= format_money($cTotalDue - $cTotalPaid) ?></td></tr>
        </tfoot>
      </table>
    </div>

    <h6 class="mt-3">Combined repayment schedule</h6>
    <div class="table-responsive">
      <table class="table table-sm table-bordered align-middle no-datatable">
        <thead><tr><th>Due date</th><th>Loan</th><th>#</th><th class="text-end">Due</th><th class="text-end">Paid</th><th>Status</th></tr></thead>
        <tbody>
          <?php
            $byDate = [];
            foreach ($combined['schedule'] as $r) { $byDate[$r['due_date']][] = $r; }
            ksort($byDate);
          ?>
          <?php foreach ($byDate as $date => $rows): ?>
            <?php foreach ($rows as $r): ?>
              <tr>
                <td><?= e($date) ?></td>
                <td><?= e($r['loan_no']) ?></td>
                <td><?= (int) $r['installment_no'] ?></td>
                <td class="text-end"><?= format_money($r['total_due']) ?></td>
                <td class="text-end"><?= format_money($r['total_paid']) ?></td>
                <td><?= e(schedule_status_label($r)) ?></td>
              </tr>
            <?php endforeach; ?>
            <?php if (count($rows) > 1): ?>
              <tr class="table-light fw-semibold"><td colspan="3" class="text-end">Total due on <?= e($date) ?></td><td class="text-end"><?= format_money(array_sum(array_column($rows, 'total_due'))) ?></td><td class="text-end"><?= format_money(array_sum(array_column($rows, 'total_paid'))) ?></td><td></td></tr>
            <?php endif; ?>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
<?php endif; ?>

    <div class="card">
      <div class="card-body">
        <h4 class="card-title">Amortization Schedule</h4>
        <div class="table-responsive">
          <table class="table table-sm table-hover">
            <thead>
              <tr>
                <th>#</th><th>Due Date</th><th>Opening Balance</th><th>Principal</th><th>Interest</th><th>Penalty Interest</th><th>Fees</th><th>Total Due</th><th>Paid</th><th>Closing Balance</th><th>Status</th>
              </tr>
            </thead>
            <tbody>
              <?php foreach ($schedule as $row): ?>
                <?php
                  $rowBadge = match (schedule_status_label($row)) {
                    'Rescheduled' => 'secondary',
                    'Paid' => 'success',
                    'Partial' => 'info',
                    'In Arrears' => 'danger',
                    'Written Off' => 'dark',
                    default => 'warning',
                  };
                ?>
                <tr>
                  <td><?= (int) $row['installment_no'] ?></td>
                  <td><?= e($row['due_date']) ?></td>
                  <td><?= format_money($row['opening_balance']) ?></td>
                  <td><?= format_money($row['principal_due']) ?></td>
                  <td><?= format_money($row['interest_due']) ?></td>
                  <td><?= format_money($row['penalty_due']) ?></td>
                  <td><?= format_money($row['fees_due']) ?></td>
                  <td><?= format_money($row['total_due']) ?></td>
                  <td><?= format_money($row['total_paid']) ?></td>
                  <td><?= format_money($row['closing_balance']) ?></td>
                  <td><span class="badge bg-<?= $rowBadge ?>"><?= e(schedule_status_label($row)) ?></span></td>
                </tr>
              <?php endforeach; ?>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<?php if (!empty($statusHistory)): ?>
<div class="row">
  <div class="col-12">
    <div class="card">
      <div class="card-body">
        <h4 class="card-title"><i class="mdi mdi-timeline-clock me-1"></i> Status History</h4>
        <ul class="list-unstyled mb-0">
          <?php foreach ($statusHistory as $h): ?>
            <li class="mb-2 pb-2 border-bottom">
              <strong><?= e($h['new_status']) ?></strong>
              by <?= e($h['changed_by_name'] ?: '—') ?>
              <span class="text-muted small"> &mdash; <?= e(date('d M Y H:i', strtotime($h['changed_at']))) ?></span>
              <?php if ($h['notes']): ?><br><span class="text-muted"><?= e($h['notes']) ?></span><?php endif; ?>
            </li>
          <?php endforeach; ?>
        </ul>
      </div>
    </div>
  </div>
</div>
<?php endif; ?>
