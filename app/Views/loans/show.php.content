            <?php if ($latestTopupReversible): ?>
              <form method="post" action="<?= url('/loan-topups/' . $latestTopup['id'] . '/reverse') ?>" onsubmit="return confirmSubmit(this, 'Reverse this top-up? The incremental journal will be reversed and the loan restored to its principal, schedule and term from before the top-up.');">
                <?= csrf_field() ?>
