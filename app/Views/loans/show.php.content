              <label class="form-label small mb-0">Reference No</label>
              <input type="text" name="reference_no" class="form-control form-control-sm" maxlength="100">
              <div class="form-text">Shown in the Cash Book and General Journal. Leave blank to use the loan number.</div>
            </div>
            <?php if (!empty($encrOffer)): ?>
              <div class="border rounded p-2 mb-2">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="pay_via_encr" value="1" id="payViaEncr" <?= $encrOffer['ok'] ? '' : 'disabled' ?>>
                  <label class="form-check-label small" for="payViaEncr"><strong>Pay out through Collexia EnCr</strong></label>
                </div>
                <?php if ($encrOffer['ok']): ?>
                  <div class="form-text mb-0">Pays <?= format_money($loan['principal_amount']) ?> to <?= e($encrOffer['text']) ?>. EnCr generates its own reference, and that reference is what the Cash Book and General Journal show. Leave unticked to disburse the usual way.</div>
                <?php else: ?>
                  <div class="form-text text-danger mb-0">Not available for this borrower: <?= e($encrOffer['text']) ?></div>
                <?php endif; ?>
              </div>
              <script>
                (function () {
                  var box = document.getElementById('payViaEncr');
                  var ref = document.getElementById('manualReferenceBox');
                  if (!box || !ref) return;
                  var sync = function () {
                    ref.style.display = box.checked ? 'none' : '';
                    if (box.checked) { ref.querySelector('input').value = ''; }
                  };
                  box.addEventListener('change', sync);
                  sync();
                })();
              </script>
            <?php endif; ?>
            <button class="btn btn-info btn-sm w-100" type="submit">Confirm Release</button>
          </form>
        </div>
        <?php endif; ?>
