<?= flash_messages() ?>

<?php
  $badge = match ($loan['loan_status']) {
    'Active', 'Current', 'Released' => 'success',
    'Completed', 'Recovered - Closed' => 'primary',
    'Denied', 'Written Off', 'Cancelled' => 'danger',
    'Approved' => 'info',
    default => 'warning',
  };
  $paymentStatusBadge = $loan['payment_status'] === 'In Arrears' ? 'danger' : 'success';
  $collectionStatusBadge = match ($loan['collection_status']) {
    'Arrears Recovery' => 'warning',
    'Recovery Arrangement' => 'info',
    default => 'secondary',
  };
  $creditStatusBadge = match ($loan['credit_status']) {
    'Watchlist' => 'warning',
    'Non-Performing' => 'danger',
    'Impaired' => 'dark',
    default => 'success',
  };
  $totalPaid = array_sum(array_column($schedule, 'total_paid'));
  $totalDue = array_sum(array_column($schedule, 'total_due'));

  // A loan with released top-ups reads as ONE loan: the headline figures below add the original and its top-ups together.
  $isCombined = !empty($combined);
  $headPrincipal = (float) $loan['principal_amount'];
  $headInterest = (float) $loan['interest_amount'];
  $headFee = (float) $loan['admin_fee'];
  $headPayable = (float) $loan['total_payable'];
  $headInstallment = (float) $loan['installment_amount'];
  $headMaturity = $loan['maturity_date'];
  if ($isCombined) {
      $headPrincipal = $headInterest = $headFee = $headPayable = $headInstallment = 0.0;
      foreach ($combined['tranches'] as $tr) {
          $headPrincipal += (float) $tr['principal_amount'];
          $headInterest += (float) $tr['interest_amount'];
          $headFee += (float) $tr['admin_fee'];
          $headPayable += (float) $tr['total_payable'];
          // the monthly instalment is what is still being paid: a finished part no longer adds to it
          if (round((float) $tr['schedule_due'] - (float) $tr['schedule_paid'], 2) > 0) {
              $headInstallment += (float) $tr['installment_amount'];
          }
          if (strcmp((string) $tr['maturity_date'], (string) $headMaturity) > 0) {
              $headMaturity = $tr['maturity_date'];
          }
      }
      $totalPaid = array_sum(array_column($combined['tranches'], 'schedule_paid'));
      $totalDue = array_sum(array_column($combined['tranches'], 'schedule_due'));
  }
?>

<?php if (!empty($outOfStep)): ?>
  <div class="alert alert-danger d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
      <i class="mdi mdi-alert-octagon-outline"></i>
      <strong>Debit order <?= e($outOfStep['debit_order_no']) ?> no longer matches this loan.</strong>
      <?= e($outOfStep['mandate_stale_note'] ?? 'The loan was rescheduled after the mandate was placed.') ?>
      Collexia is still set to collect the OLD dates and amounts.
    </div>
    <a class="btn btn-sm btn-danger" href="<?= url('/debit-orders/' . (int) $outOfStep['id'] . '/replace') ?>"><i class="mdi mdi-swap-horizontal"></i> Replace mandate</a>
  </div>
<?php endif; ?>

<?php $mode = 'notice'; include VIEW_PATH . '/loans/_collection_check.php'; ?>

<div class="row">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
          <h4 class="card-title mb-0"><?= e($loan['loan_no']) ?></h4>
          <span class="badge bg-<?= $badge ?>"><?= e($loan['loan_status']) ?></span>
        </div>
        <div class="mb-2">
          <span class="badge bg-<?= $paymentStatusBadge ?>" title="Payment Status"><?= e($loan['payment_status']) ?></span>
          <?php if ($loan['payment_status'] === 'In Arrears'): ?>
            <span class="badge bg-secondary" title="Aging Bucket"><?= e($loan['aging_bucket']) ?></span>
          <?php endif; ?>
          <span class="badge bg-<?= $collectionStatusBadge ?>" title="Collection Status"><?= e($loan['collection_status']) ?></span>
          <span class="badge bg-<?= $creditStatusBadge ?>" title="Credit Status"><?= e($loan['credit_status']) ?></span>
        </div>
        <p class="text-muted mb-3"><?= e($loan['product_name']) ?> &middot; <?= e($loan['plan_name']) ?></p>

        <p class="mb-1 text-muted small">Created by <?= e($loan['created_by_name'] ?: '—') ?> on <?= e(date('d M Y H:i', strtotime($loan['created_at']))) ?></p>
        <?php if ($loan['approved_by']): ?>
          <p class="mb-1 text-muted small">Approved by <?= e($loan['approved_by_name'] ?: '—') ?> on <?= e(date('d M Y H:i', strtotime($loan['approved_at']))) ?></p>
        <?php endif; ?>
        <?php if ($loan['denied_by']): ?>
          <p class="mb-1 text-muted small">Denied by <?= e($loan['denied_by_name'] ?: '—') ?> on <?= e(date('d M Y H:i', strtotime($loan['denied_at']))) ?><?= $loan['denial_reason'] ? ' — ' . e($loan['denial_reason']) : '' ?></p>
        <?php endif; ?>
        <?php if ($loan['released_by']): ?>
          <p class="mb-3 text-muted small">Released by <?= e($loan['released_by_name'] ?: '—') ?> on <?= e(date('d M Y H:i', strtotime($loan['released_at']))) ?></p>
        <?php endif; ?>

        <p class="mb-1"><strong>Borrower:</strong> <a href="<?= url('/borrowers/' . $loan['borrower_id']) ?>"><?= e($loan['borrower_name']) ?></a></p>
        <?php if ($isCombined): ?>
          <p class="mb-2"><span class="badge bg-info"><i class="mdi mdi-layers-outline"></i> Combined with <?= count($combined['tranches']) - 1 ?> top-up<?= count($combined['tranches']) - 1 === 1 ? '' : 's' ?></span>
            <a href="#combined" class="small">see the breakdown</a></p>
        <?php endif; ?>
        <p class="mb-1"><strong>Amount Borrowed:</strong> <?= format_money($headPrincipal) ?></p>
        <?php if ($namfisaLevy > 0 && !$isCombined): ?>
          <p class="mb-1 ps-3 text-muted small">+ NAMFISA Levy: <?= format_money($namfisaLevy) ?></p>
        <?php endif; ?>
        <?php if ($dutyStamp > 0 && !$isCombined): ?>
          <p class="mb-1 ps-3 text-muted small">+ Duty Stamp: <?= format_money($dutyStamp) ?></p>
        <?php endif; ?>
        <?php if (($namfisaLevy > 0 || $dutyStamp > 0) && !$isCombined): ?>
          <p class="mb-1"><strong>Opening Principal Balance:</strong> <?= format_money($loan['principal_amount'] + $namfisaLevy + $dutyStamp) ?></p>
        <?php endif; ?>
        <p class="mb-1"><strong>Interest (<?= e($loan['interest_method']) ?>):</strong> <?= format_money($headInterest) ?></p>
        <p class="mb-1"><strong>Admin Fee:</strong> <?= format_money($headFee) ?></p>
        <p class="mb-1"><strong>Total Payable:</strong> <?= format_money($headPayable) ?></p>
        <p class="mb-1"><strong>Installment:</strong> <?= format_money($headInstallment) ?> / month<?= $isCombined ? ' <span class="text-muted small">(all parts together)</span>' : '' ?></p>
        <p class="mb-1"><strong>Term:</strong> <?= (int) $loan['term_months'] ?> months</p>
        <p class="mb-1"><strong>Penalty Rate:</strong> <?= format_money($loan['penalty_rate']) ?>% per month (if overdue)</p>
        <p class="mb-1"><strong>Start:</strong> <?= e($loan['start_date']) ?> &rarr; <strong>Maturity:</strong> <?= e($headMaturity) ?></p>
        <?php
          $firstDueRow = null;
          foreach ($schedule as $scheduleRow) {
              if ($firstDueRow === null || strcmp((string) $scheduleRow['due_date'], (string) $firstDueRow['due_date']) < 0) {
                  $firstDueRow = $scheduleRow;
              }
          }
          $firstDueGapDays = $firstDueRow ? (int) ((strtotime((string) $firstDueRow['due_date']) - strtotime((string) $loan['start_date'])) / 86400) : 0;
        ?>
        <?php if ($firstDueRow): ?>
          <p class="mb-1"><strong>First payment due:</strong> <?= e($firstDueRow['due_date']) ?>
            <?php if ($firstDueGapDays > 35): ?>
              <span class="badge bg-warning text-dark" title="The first payment falls well after the loan's start date. Check this is intended before approving."><i class="mdi mdi-alert-outline"></i> <?= $firstDueGapDays ?> days after start</span>
            <?php endif; ?>
          </p>
        <?php endif; ?>
        <p class="mb-1"><strong>Collected so far:</strong> <?= format_money($totalPaid) ?> / <?= format_money($totalDue) ?></p>
        <p class="mb-3"><strong>Current Outstanding Balance:</strong> <?= format_money($totalDue - $totalPaid) ?></p>

        <?php if (!empty($originalLoan)): ?>
