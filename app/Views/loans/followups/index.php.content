<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-1">Loan Questions</h4>
    <p class="text-muted mb-2">
      The loans of the online applications are approved and managed in the old loan system, but Creditinfo needs to know about them. Please answer the questions below,
      one at a time. Every answer is saved with your name. A question you are not sure about comes back in a couple of days.
    </p>
    <div class="d-flex gap-3 flex-wrap">
      <span class="badge bg-primary fs-6"><?= count($cards) ?> to answer now</span>
      <span class="badge bg-light text-dark fs-6"><?= (int) $waiting ?> waiting for a later date</span>
    </div>
  </div>
</div>

<?php if (!$cards): ?>
  <div class="alert alert-success mt-3 mb-0">Nothing to answer right now. Thank you.</div>
<?php endif; ?>

<?php foreach ($cards as $c): ?>
  <?php
    $f = $c['f']; $q = $c['q'];
    $name = trim($f['applicant_first_name'] . ' ' . ($f['applicant_middle_name'] ?? '') . ' ' . $f['applicant_last_name']);
    $post = url('/loans/followups/' . $f['id'] . '/answer');
    $asked = (float) ($f['requested_amount'] ?? 0);
    $termAsked = (int) ($f['requested_term_months'] ?? 1);
  ?>
  <div class="card mt-3 <?= $q['attention'] ? 'border-danger' : '' ?>">
    <div class="card-body">
      <div class="d-flex justify-content-between flex-wrap gap-2">
        <div>
          <h5 class="mb-0"><?= e($name) ?> <span class="text-muted small">&mdash; <?= e($f['application_no']) ?></span></h5>
          <div class="text-muted small">
            Applied <?= e(date('d M Y', strtotime($f['applied_at']))) ?> for N$ <?= number_format($asked, 2, '.', ' ') ?> over <?= $termAsked ?> month(s)
            &middot; phone <?= e($f['applicant_phone'] ?? '') ?>
            <?php if ($f['approved_amount'] !== null): ?> &middot; approved N$ <?= number_format((float) $f['approved_amount'], 2, '.', ' ') ?><?php endif; ?>
          </div>
        </div>
        <div class="d-flex gap-2 align-items-start">
          <?php if ($q['attention']): ?><span class="badge bg-danger">Asked <?= (int) $f['ask_count'] ?> times &mdash; please settle it</span><?php endif; ?>
          <a class="btn btn-sm btn-outline-secondary" href="<?= url('/loans/followups/' . $f['id']) ?>">History</a>
        </div>
      </div>

      <hr>
      <p class="fw-bold mb-2"><?= e($q['text']) ?></p>

      <?php if (in_array($q['key'], ['approved', 'plans', 'disbursed'], true)): ?>
        <form method="post" action="<?= $post ?>" class="d-flex gap-2 flex-wrap">
          <?= csrf_field() ?>
          <input type="hidden" name="question" value="<?= e($q['key']) ?>">
          <button type="submit" name="answer" value="Yes" class="btn btn-success">Yes</button>
          <button type="submit" name="answer" value="No" class="btn btn-outline-danger">No</button>
          <?php if ($q['key'] !== 'disbursed'): ?><button type="submit" name="answer" value="Not sure" class="btn btn-outline-secondary">Not sure</button><?php endif; ?>
        </form>

      <?php elseif ($q['key'] === 'amount'): ?>
        <form method="post" action="<?= $post ?>" class="row g-2 align-items-end">
          <?= csrf_field() ?>
          <input type="hidden" name="question" value="amount">
          <div class="col-md-3"><label class="form-label small mb-0">Amount approved (N$)</label>
            <input type="text" inputmode="decimal" name="amount" class="form-control" value="<?= e((string) (int) $asked) ?>" required></div>
          <div class="col-md-2"><label class="form-label small mb-0">Months</label>
            <select name="term" class="form-select">
              <?php for ($m = 1; $m <= 12; $m++): ?><option value="<?= $m ?>" <?= $m === $termAsked ? 'selected' : '' ?>><?= $m ?></option><?php endfor; ?>
            </select></div>
          <div class="col-md-3"><button type="submit" class="btn btn-primary">Save</button></div>
        </form>

      <?php elseif ($q['key'] === 'payout'): ?>
        <form method="post" action="<?= $post ?>" class="row g-2 align-items-end">
          <?= csrf_field() ?>
          <input type="hidden" name="question" value="payout">
          <div class="col-md-3"><label class="form-label small mb-0">Date paid out</label>
            <input type="date" name="paid_out" class="form-control" max="<?= e(date('Y-m-d')) ?>" required></div>
          <div class="col-md-3"><label class="form-label small mb-0">Client's pay day (day of the month)</label>
            <input type="number" name="pay_day" class="form-control" min="1" max="31" value="<?= e((string) ($f['application_pay_day'] ?? '')) ?>" required></div>
          <div class="col-md-3"><button type="submit" class="btn btn-primary">Save</button></div>
        </form>

      <?php elseif ($q['key'] === 'instalment'): ?>
        <?php $inst = null; foreach ($c['instalments'] as $x) { if ((int) $x['id'] === (int) $q['instalment_id']) { $inst = $x; } } ?>
        <form method="post" action="<?= url('/loans/followups/' . $f['id'] . '/instalments/' . $q['instalment_id']) ?>" class="row g-2 align-items-end">
          <?= csrf_field() ?>
          <div class="col-md-2"><label class="form-label small mb-0">Did they pay?</label>
            <select name="answer" class="form-select" required>
              <option value="Yes">Yes, in full</option><option value="Partly">Partly</option><option value="No">No</option>
            </select></div>
          <div class="col-md-3"><label class="form-label small mb-0">Amount received this time (N$) &mdash; leave empty if the whole instalment</label>
            <input type="text" inputmode="decimal" name="amount" class="form-control" value=""></div>
          <div class="col-md-3"><label class="form-label small mb-0">Date it was received</label>
            <input type="date" name="paid_on" class="form-control" value="<?= e(date('Y-m-d')) ?>" max="<?= e(date('Y-m-d')) ?>"></div>
          <div class="col-md-2"><button type="submit" class="btn btn-primary">Save</button></div>
        </form>
        <?php if ($inst): ?><div class="text-muted small mt-2">Answer by <?= e(date('d M Y', strtotime($flow->answerByDate($inst['due_date'])))) ?>.</div><?php endif; ?>
      <?php endif; ?>

      <?php if (!in_array($q['key'], ['instalment'], true) && $f['disbursed'] !== 'Yes'): ?>
        <form method="post" action="<?= url('/loans/followups/' . $f['id'] . '/ignore') ?>" class="mt-3 d-flex gap-2 align-items-center flex-wrap"
              onsubmit="return confirm('Close this application? It will not be asked about or reported.');">
          <?= csrf_field() ?>
          <input type="text" name="reason" class="form-control form-control-sm" style="max-width:260px" placeholder="Why (test, duplicate...)">
          <button type="submit" class="btn btn-sm btn-link text-muted">This is not a real loan - close it</button>
        </form>
      <?php endif; ?>
    </div>
  </div>
<?php endforeach; ?>
