<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1"><?= e(trim($app['applicant_first_name'] . ' ' . $app['applicant_last_name'])) ?> <span class="text-muted small">&mdash; <?= e($f['application_no']) ?></span></h4>
        <div class="text-muted small">Applied <?= e(date('d M Y', strtotime($app['created_at']))) ?> for N$ <?= number_format((float) $app['requested_amount'], 2, '.', ' ') ?> over <?= (int) $app['requested_term_months'] ?> month(s)</div>
      </div>
      <span class="badge fs-6 bg-<?= $f['status'] === 'Open' ? 'primary' : 'secondary' ?>"><?= e($f['status']) ?><?= $f['closed_reason'] ? ' - ' . e($f['closed_reason']) : '' ?></span>
    </div>
    <dl class="row mt-3 mb-0">
      <dt class="col-sm-3">Approved</dt><dd class="col-sm-9"><?= e($f['approved'] ?? 'not answered') ?><?= $f['approved'] === 'No' && $f['plans_to_approve'] ? ' (planning to approve: ' . e($f['plans_to_approve']) . ')' : '' ?></dd>
      <dt class="col-sm-3">Amount approved</dt><dd class="col-sm-9"><?= $f['approved_amount'] !== null ? 'N$ ' . number_format((float) $f['approved_amount'], 2, '.', ' ') . ' over ' . (int) $f['term_months'] . ' month(s)' : '-' ?></dd>
      <dt class="col-sm-3">Paid out</dt><dd class="col-sm-9"><?= e($f['disbursed'] ?? 'not answered') ?><?= $f['disbursed_on'] ? ' on ' . e($f['disbursed_on']) : '' ?></dd>
      <dt class="col-sm-3">Client's pay day</dt><dd class="col-sm-9"><?= $f['pay_day'] !== null ? 'day ' . (int) $f['pay_day'] : '-' ?></dd>
    </dl>
  </div>
</div>

<?php if ($instalments): ?>
<div class="card mt-3"><div class="card-body">
  <h5 class="card-title">Instalments</h5>
  <div class="table-responsive"><table class="table table-sm no-datatable">
    <thead><tr><th>No</th><th>Due</th><th>Expected (N$)</th><th>Paid so far (N$)</th><th>Payments received</th><th>Status</th></tr></thead>
    <tbody>
    <?php foreach ($instalments as $i): ?>
      <tr>
        <td><?= (int) $i['instalment_no'] ?></td>
        <td><?= e($i['due_date']) ?></td>
        <td><?= number_format((float) $i['expected_amount'], 2, '.', ' ') ?></td>
        <td><?= $i['paid_amount'] !== null ? number_format((float) $i['paid_amount'], 2, '.', ' ') : '-' ?></td>
        <td><?php foreach ($payments[(int) $i['id']] ?? [] as $p): ?><div class="small"><?= e(date('d M Y', strtotime($p['paid_on']))) ?>: N$ <?= number_format((float) $p['amount'], 2, '.', ' ') ?></div><?php endforeach; ?><?= empty($payments[(int) $i['id']]) ? '-' : '' ?></td>
        <td><?= $flow->settled($i) ? '<span class="badge bg-success">Paid</span>' : ($i['due_date'] < date('Y-m-d') ? '<span class="badge bg-warning text-dark">Not paid yet</span>' : '<span class="badge bg-light text-dark">Not due yet</span>') ?></td>
      </tr>
    <?php endforeach; ?>
    </tbody>
  </table></div>
</div></div>
<?php endif; ?>

<div class="card mt-3"><div class="card-body">
  <h5 class="card-title">Answers given</h5>
  <?php if (!$answers): ?><p class="text-muted mb-0">No answers yet.</p><?php endif; ?>
  <ul class="list-unstyled mb-0">
    <?php foreach ($answers as $a): ?>
      <li class="mb-1"><span class="text-muted small"><?= e(date('d M Y H:i', strtotime($a['created_at']))) ?> &middot; <?= e($a['user_name'] ?? 'system') ?></span><br><?= e($a['answer']) ?></li>
    <?php endforeach; ?>
  </ul>
</div></div>
<div class="mt-3 d-flex gap-2 flex-wrap">
  <a href="<?= url('/loans/followups') ?>" class="btn btn-outline-secondary btn-sm">Back to the questions</a>
  <?php if (!empty($canReopen)): ?>
    <form method="post" action="<?= url('/loans/followups/' . $f['id'] . '/reopen') ?>" onsubmit="return confirm('Start this loan again from the amount question? The instalments are worked out again.');">
      <?= csrf_field() ?>
      <button type="submit" class="btn btn-outline-danger btn-sm">A wrong amount, term, date or pay day was entered - start again</button>
    </form>
  <?php endif; ?>
</div>
