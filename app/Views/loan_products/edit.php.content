<?= flash_messages() ?>
<?php
/** @var array $product @var array $old @var array $errors */
$v = static fn (string $k) => e((string) ($old[$k] ?? $product[$k] ?? ''));
$err = static fn (string $k) => isset($errors[$k]) ? '<div class="invalid-feedback d-block">' . e($errors[$k]) . '</div>' : '';
$cls = static fn (string $k) => isset($errors[$k]) ? 'is-invalid' : '';
?>
<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-1">Edit Loan Product <span class="badge bg-secondary"><?= e($product['product_code']) ?></span></h4>
    <p class="text-muted">
      Changing the amount or term limits applies to loans created <strong>from now on</strong>. Existing loans, their schedules and balances are never changed.
      Interest rates, fees and the interest method belong to each plan and are not edited here.
    </p>

    <form method="post" action="<?= url('/loan-products/' . (int) $product['id']) ?>">
      <?= csrf_field() ?>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Product Name <span class="text-danger">*</span></label>
          <input type="text" name="product_name" class="form-control <?= $cls('product_name') ?>" value="<?= $v('product_name') ?>">
          <?= $err('product_name') ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Interest Method</label>
          <input type="text" class="form-control" value="<?= e($product['interest_method']) ?>" disabled>
        </div>
        <div class="col-md-12 mb-3">
          <label class="form-label">Description</label>
          <textarea name="description" class="form-control" rows="2"><?= $v('description') ?></textarea>
        </div>

        <div class="col-md-3 mb-3">
          <label class="form-label">Min Amount <span class="text-danger">*</span></label>
          <input type="number" step="0.01" min="0" name="min_amount" class="form-control <?= $cls('min_amount') ?>" value="<?= $v('min_amount') ?>">
          <?= $err('min_amount') ?>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Max Amount <span class="text-danger">*</span></label>
          <input type="number" step="0.01" min="0" name="max_amount" class="form-control <?= $cls('max_amount') ?>" value="<?= $v('max_amount') ?>">
          <?= $err('max_amount') ?>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Min Term (months) <span class="text-danger">*</span></label>
          <input type="number" min="1" name="min_term_months" class="form-control <?= $cls('min_term_months') ?>" value="<?= $v('min_term_months') ?>">
          <?= $err('min_term_months') ?>
        </div>
        <div class="col-md-3 mb-3">
          <label class="form-label">Max Term (months) <span class="text-danger">*</span></label>
          <input type="number" min="1" name="max_term_months" class="form-control <?= $cls('max_term_months') ?>" value="<?= $v('max_term_months') ?>">
          <?= $err('max_term_months') ?>
        </div>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Changes</button>
      <a href="<?= url('/loan-products') ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
