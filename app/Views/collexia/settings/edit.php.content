<?php
$statusBadge = [
    'Not Configured' => 'bg-secondary',
    'Partially Configured' => 'bg-secondary',
    'Awaiting Security Configuration' => 'bg-warning',
    'Ready for UAT' => 'bg-info',
    'Enabled' => 'bg-success',
    'Disabled' => 'bg-warning',
][$status] ?? 'bg-secondary';
?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Collexia EnDO</h4>
      <?php if ($canManage): ?>
        <a href="<?= url('/collexia/settings/manage') ?>" class="btn btn-outline-secondary btn-sm">
          <i class="mdi mdi-key-variant"></i> Manage / Update Credentials
        </a>
      <?php endif; ?>
    </div>

    <table class="table table-borderless mb-0" style="max-width: 480px;">
      <tbody>
        <tr>
          <td class="text-muted">UAT Status</td>
          <td><span class="badge <?= $statusBadge ?>"><?= e($status) ?></span></td>
        </tr>
        <tr>
          <td class="text-muted">Security Configuration</td>
          <td><?= in_array($status, ['Ready for UAT', 'Enabled', 'Disabled'], true) ? 'Active' : 'Incomplete' ?></td>
        </tr>
        <tr>
          <td class="text-muted">Environment</td>
          <td>UAT</td>
        </tr>
        <tr>
          <td class="text-muted">Integration</td>
          <td><?= $enabled ? 'Enabled' : 'Disabled' ?></td>
        </tr>
      </tbody>
    </table>

    <p class="text-muted small mt-3 mb-0">
      Credentials are configured separately and never shown here.
      <?php if (!$canManage): ?>Contact a system administrator to change them.<?php endif; ?>
    </p>
  </div>
</div>
