<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Loan Reschedules</h4>

    <?php
      $bar = [
          'action' => url('/reschedules'),
          'search' => ['value' => $search ?? '', 'placeholder' => 'Reschedule no, loan no or borrower'],
          'status' => ['value' => $status ?? '', 'options' => ['Pending', 'Approved', 'Rejected', 'Implemented', 'Cancelled']],
          'date' => ['label' => 'Requested', 'from' => $filter['from'] ?? '', 'to' => $filter['to'] ?? ''],
          'amount' => ['label' => 'New installment', 'min' => $filter['min'] ?? '', 'max' => $filter['max'] ?? ''],
          'export' => true,
      ];
      include __DIR__ . '/../partials/list_filter_bar.php';
    ?>

    <div data-list-results>
    <?php $count = count($reschedules); include __DIR__ . '/../partials/list_count.php'; ?>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Reschedule No</th><th>Loan</th><th>Borrower</th><th>Old Term</th><th>New Term</th><th>New Installment</th><th>Status</th><th>Requested</th><th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($reschedules)): ?>
            <tr><td colspan="9" class="text-center text-muted py-4"><?= !empty($filtersActive) ? 'Nothing matches your filters.' : 'No reschedule requests yet.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($reschedules as $r): ?>
            <?php
              $badge = match ($r['status']) {
                'Implemented' => 'success',
                'Rejected', 'Cancelled' => 'danger',
                'Approved' => 'info',
                default => 'warning',
              };
            ?>
            <tr>
              <td><?= e($r['reschedule_no']) ?></td>
              <td><?= e($r['loan_no']) ?></td>
              <td><?= e($r['borrower_name']) ?></td>
              <td><?= (int) $r['old_term_months'] ?> mo</td>
              <td><?= (int) $r['new_term_months'] ?> mo</td>
              <td><?= format_money($r['new_installment_amount']) ?></td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($r['status']) ?></span></td>
              <td><?= e(date('d M Y', strtotime($r['request_date']))) ?></td>
              <td class="text-end">
                <a href="<?= url('/reschedules/' . $r['id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i></a>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
