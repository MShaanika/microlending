<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-1">CPL Settings</h4>
    <p class="text-muted small">
      Configuration for the Bank of Namibia CPLv1.1 credit bureau extract. Every value below is editable
      here rather than hardcoded, so a correction from Creditinfo never requires a deploy.
    </p>

    <form method="post" action="<?= url('/reports/cpl-export/settings') ?>">
      <?= csrf_field() ?>

      <h5>Bureau Identification</h5>
      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <label class="form-label small">Supplier Reference Number</label>
          <input type="text" name="supplier_reference_number" class="form-control form-control-sm" maxlength="10" value="<?= e($settings['supplier_reference_number'] ?? '') ?>" placeholder="Issued by the bureaus">
        </div>
        <div class="col-md-5">
          <label class="form-label small">Trading Name</label>
          <input type="text" name="trading_name" class="form-control form-control-sm" maxlength="60" value="<?= e($settings['trading_name'] ?? '') ?>">
        </div>
        <div class="col-md-2">
          <label class="form-label small">Recipient</label>
          <input type="text" name="recipient" class="form-control form-control-sm" maxlength="7" value="<?= e($settings['recipient'] ?? 'ALL') ?>">
        </div>
        <div class="col-md-2">
          <label class="form-label small">CPL Version</label>
          <input type="text" name="cpl_version" class="form-control form-control-sm" maxlength="2" value="<?= e($settings['cpl_version'] ?? '06') ?>">
        </div>
      </div>

      <h5>Submission</h5>
      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <label class="form-label small">Submission Environment</label>
          <select name="submission_environment" class="form-select form-select-sm">
            <option value="uat" <?= ($settings['submission_environment'] ?? 'uat') === 'uat' ? 'selected' : '' ?>>UAT / Test (T702)</option>
            <option value="production" <?= ($settings['submission_environment'] ?? '') === 'production' ? 'selected' : '' ?>>Production / Live (L702)</option>
          </select>
        </div>
        <div class="col-md-3">
          <label class="form-label small">Agreed Billing Date (day of month)</label>
          <input type="number" min="1" max="31" name="agreed_billing_date" class="form-control form-control-sm" value="<?= e($settings['agreed_billing_date'] ?? '') ?>" placeholder="Not yet agreed">
        </div>
        <div class="col-md-6">
          <label class="form-label small">Monthly Submission Deadline Rule</label>
          <input type="text" name="monthly_submission_deadline_rule" class="form-control form-control-sm" value="<?= e($settings['monthly_submission_deadline_rule'] ?? '') ?>">
        </div>
      </div>

      <h5 class="mb-1">Account Type Mapping <span class="badge <?= ($settings['account_type_mapping_confirmed'] ?? 'no') === 'yes' ? 'bg-success' : 'bg-warning text-dark' ?>"><?= ($settings['account_type_mapping_confirmed'] ?? 'no') === 'yes' ? 'Confirmed' : 'Pending Bureau Confirmation' ?></span></h5>
      <p class="text-muted small mb-3">
        The CPL specification defines M as a one-month personal loan and P as a personal loan over a term
        greater than one month. This is applied automatically below, but has not yet been confirmed in
        writing with Creditinfo/the supplier for this book -- the export continues to run against the
        documented default while confirmation is pending.
      </p>
      <div class="row g-3 mb-2">
        <div class="col-md-3">
          <label class="form-label small">One-Month Loan Account Type</label>
          <input type="text" name="account_type_one_month" class="form-control form-control-sm" maxlength="1" value="<?= e($settings['account_type_one_month'] ?? 'M') ?>">
        </div>
        <div class="col-md-3">
          <label class="form-label small">Multi-Month Loan Account Type</label>
          <input type="text" name="account_type_multi_month" class="form-control form-control-sm" maxlength="1" value="<?= e($settings['account_type_multi_month'] ?? 'P') ?>">
        </div>
        <div class="col-md-6 d-flex align-items-end">
          <div class="form-check">
            <input type="checkbox" class="form-check-input" id="account_type_mapping_confirmed" name="account_type_mapping_confirmed" <?= ($settings['account_type_mapping_confirmed'] ?? 'no') === 'yes' ? 'checked' : '' ?>>
            <label class="form-check-label" for="account_type_mapping_confirmed">Creditinfo/supplier has confirmed this mapping in writing</label>
          </div>
        </div>
      </div>

      <h5 class="mb-1">SFTP Submission</h5>
      <p class="text-muted small mb-3">
        CPL files go through the same Creditinfo SFTP account Public Defaults already uses (confirmed by
        Creditinfo's own reply to a CPL file sent through that channel) -- host/username/password are
        configured once, in Public Defaults Settings, not duplicated here. Leave the directory blank to
        reuse Public Defaults' own outbound folder.
      </p>
      <div class="row g-3 mb-2">
        <div class="col-md-6">
          <label class="form-label small">Remote Directory (blank = same as Public Defaults)</label>
          <input type="text" name="sftp_directory" class="form-control form-control-sm" value="<?= e($settings['sftp_directory'] ?? '') ?>" placeholder="In">
        </div>
        <div class="col-md-6 d-flex align-items-end">
          <div class="form-check">
            <input type="checkbox" class="form-check-input" id="sftp_submission_enabled" name="sftp_submission_enabled" <?= ($settings['sftp_submission_enabled'] ?? 'off') === 'on' ? 'checked' : '' ?>>
            <label class="form-check-label" for="sftp_submission_enabled">Enable "Submit via SFTP" on approved CPL batches</label>
          </div>
        </div>
      </div>

      <h5 class="mb-1 mt-4">Automatic Submission (daily and monthly files)</h5>
      <p class="text-muted small mb-3">
        The on/off switch is on the CPL Dashboard (it needs a confirmation). These settings tune it.
        Changing the submission environment, the live SFTP switch, the SFTP folder, the Supplier Reference Number, the recipient or any of the automatic
        settings below needs the CPL approval permission; every such change is recorded with the old and the new value, and a change of the destination
        revokes the standing approval of the automatic submission (switching it off).
      </p>
      <div class="row g-3 mb-2">
        <div class="col-md-3">
          <label class="form-label small">Send the monthly file on working day number</label>
          <input type="number" min="1" max="15" name="cpl_monthly_send_day" class="form-control form-control-sm" value="<?= e($settings['cpl_monthly_send_day'] ?? '3') ?>">
          <div class="form-text">3 = the third working day of the month after the month end.</div>
        </div>
        <div class="col-md-5">
          <label class="form-label small">Applicants left out of every automatic file (test applicants), one full name per line</label>
          <textarea name="cpl_auto_excluded_names" rows="3" class="form-control form-control-sm" placeholder="First Last"><?= e($settings['cpl_auto_excluded_names'] ?? '') ?></textarea>
        </div>
        <div class="col-md-4">
          <label class="form-label small">Also e-mail these user ids (comma separated, optional)</label>
          <input type="text" name="cpl_auto_alert_user_ids" class="form-control form-control-sm" value="<?= e($settings['cpl_auto_alert_user_ids'] ?? '') ?>" placeholder="e.g. 3, 7">
          <div class="form-text">Everybody who may use the CPL reports is e-mailed already.</div>
        </div>
        <div class="col-md-6">
          <label class="form-label small">Public address used in the alert e-mails (optional)</label>
          <input type="url" name="cpl_public_base_url" class="form-control form-control-sm" maxlength="200" value="<?= e($settings['cpl_public_base_url'] ?? '') ?>" placeholder="https://your-domain.example/app">
          <div class="form-text">The links in the automatic-submission e-mails start with this. Left empty, the address in the system configuration is used.</div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary mt-3">Save Settings</button>
    </form>
  </div>
</div>
