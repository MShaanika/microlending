<?= flash_messages() ?>

<?php if (!$accountTypeMappingConfirmed): ?>
  <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><strong>Account Type mapping (M/P) is pending bureau confirmation.</strong> The export applies the documented default (1-month loan = M, all other terms = P) but this has not yet been confirmed in writing with Creditinfo/the supplier.</div>
    <a href="<?= url('/reports/cpl-export/settings') ?>" class="btn btn-sm btn-outline-dark">Settings</a>
  </div>
<?php endif; ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <h4 class="card-title mb-1">Credit Bureau (CPL) Export</h4>
      <a href="<?= url('/reports/cpl-export/settings') ?>" class="btn btn-sm btn-outline-secondary">Settings</a>
    </div>
    <p class="text-muted small">
      Generates the monthly Bank of Namibia CPLv1.1 fixed-width extract (account types M &amp; P only) for
      submission to the credit bureaus. Until a Supplier Reference Number has been issued by the bureaus,
      the file is not valid for submission -- set it once in Settings above.
    </p>

    <form method="get" action="<?= url('/reports/cpl-export/download/PLACEHOLDER') ?>" class="row g-3 mt-2" id="cpl-export-form">
      <div class="col-md-3">
        <label class="form-label">Month End Date</label>
        <input type="date" name="month_end" id="month_end" class="form-control" value="<?= e($lastMonthEnd) ?>" required>
      </div>
      <div class="col-md-3">
        <label class="form-label">Supplier Reference Number</label>
        <input type="text" name="supplier_ref" class="form-control" maxlength="10" value="<?= e($supplierRef) ?>" placeholder="From Settings">
      </div>
      <div class="col-md-4">
        <label class="form-label">Trading Name</label>
        <input type="text" name="trading_name" class="form-control" maxlength="60" value="<?= e($tradingName) ?>">
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-info waves-effect waves-light w-100">
          <i class="mdi mdi-file-download"></i> Download
        </button>
      </div>
    </form>
  </div>
</div>

<script>
document.getElementById('cpl-export-form').addEventListener('submit', function (e) {
  var monthEnd = document.getElementById('month_end').value;
  if (!monthEnd) {
    return;
  }
  this.action = this.action.replace('PLACEHOLDER', monthEnd);
});
</script>
