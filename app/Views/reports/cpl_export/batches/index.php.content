<?= flash_messages() ?>

<?php if (!$accountTypeMappingConfirmed): ?>
  <div class="alert alert-warning d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div><strong>Account Type mapping (M/P) is pending bureau confirmation.</strong> Batches are generated using the documented default.</div>
    <a href="<?= url('/reports/cpl-export/settings') ?>" class="btn btn-sm btn-outline-dark">Settings</a>
  </div>
<?php endif; ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <h4 class="card-title mb-1">CPL Dashboard</h4>
      <div class="d-flex gap-2">
        <a href="<?= url('/reports/cpl-export/settings') ?>" class="btn btn-sm btn-outline-secondary">Settings</a>
        <a href="<?= url('/reports/cpl-export') ?>" class="btn btn-sm btn-outline-secondary">Direct Export (Legacy)</a>
      </div>
    </div>
    <p class="text-muted small">
      Preparing a batch snapshots every eligible loan for the month, validates it against the CPLv1.1
      specification, and requires a second person's approval before the extract file can be generated.
      Nothing is transmitted to the credit bureaus from here.
    </p>

    <form method="post" action="<?= url('/reports/cpl-export/batches/generate') ?>" class="row g-2 mt-2">
      <?= csrf_field() ?>
      <div class="col-md-3">
        <input type="date" name="month_end" class="form-control" value="<?= e($lastMonthEnd) ?>" required>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary w-100">Prepare / Refresh Batch</button>
      </div>
    </form>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Recent Batches</h5>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Month End</th><th>Status</th><th>Records</th><th>Blocking Errors</th><th>Warnings</th><th>Generated By</th><th></th></tr></thead>
        <tbody>
          <?php foreach ($batches as $b): ?>
            <?php
              $statusBadge = match ($b['status']) {
                  'Approved' => 'success', 'Rejected' => 'danger',
                  'Pending Approval' => 'info', 'Ready for Review' => 'primary',
                  'Submitted' => 'dark', default => 'secondary',
              };
            ?>
            <tr>
              <td><a href="<?= url('/reports/cpl-export/batches/' . $b['id']) ?>"><?= e(date('F Y', strtotime($b['month_end']))) ?></a></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($b['status']) ?></span></td>
              <td><?= (int) $b['total_records'] ?></td>
              <td class="<?= $b['blocking_error_count'] > 0 ? 'text-danger fw-bold' : '' ?>"><?= (int) $b['blocking_error_count'] ?></td>
              <td class="<?= $b['warning_count'] > 0 ? 'text-warning-emphasis' : '' ?>"><?= (int) $b['warning_count'] ?></td>
              <td class="small"><?= e($b['generated_by_name'] ?? '—') ?></td>
              <td><a href="<?= url('/reports/cpl-export/batches/' . $b['id']) ?>" class="btn btn-sm btn-outline-secondary">View</a></td>
            </tr>
          <?php endforeach; ?>
          <?php if (empty($batches)): ?>
            <tr><td colspan="7" class="text-muted small">No batches prepared yet.</td></tr>
          <?php endif; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
