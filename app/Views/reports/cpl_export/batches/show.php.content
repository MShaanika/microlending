<?= flash_messages() ?>

<?php
  $statusBadge = match ($batch['status']) {
      'Approved' => 'success', 'Rejected' => 'danger',
      'Pending Approval' => 'info', 'Ready for Review' => 'primary',
      'Submitted' => 'dark', default => 'secondary',
  };
  $ready = $batch['blocking_error_count'] == 0;
?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1">CPL Batch &mdash; <?= e(date('F Y', strtotime($batch['month_end']))) ?></h4>
        <p class="text-muted small mb-0">Generated by <?= e($batch['generated_by_name'] ?? '—') ?> on <?= e(date('d M Y H:i', strtotime($batch['generated_at']))) ?></p>
      </div>
      <span class="badge fs-6 bg-<?= $statusBadge ?>"><?= e($batch['status']) ?></span>
    </div>

    <div class="row text-center g-3 mt-2">
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0"><?= (int) $batch['total_records'] ?></div><div class="text-muted small">Accounts Expected</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0"><?= (int) $counts['Valid'] ?></div><div class="text-muted small">Ready</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0 text-danger"><?= (int) $batch['blocking_error_count'] ?></div><div class="text-muted small">Blocking Errors</div></div></div>
      <div class="col-6 col-md-3"><div class="border rounded p-3"><div class="h3 mb-0 text-warning-emphasis"><?= (int) $batch['warning_count'] ?></div><div class="text-muted small">Warnings</div></div></div>
    </div>

    <div class="alert <?= $ready ? 'alert-success' : 'alert-danger' ?> mt-3 mb-3">
      <strong>STATUS: <?= $ready ? 'READY FOR REVIEW' : 'NOT READY FOR SUBMISSION' ?></strong>
      <?php if (!$ready): ?> &mdash; resolve every blocking error below, then Prepare / Refresh the batch again.<?php endif; ?>
    </div>

    <div class="d-flex gap-2 flex-wrap">
      <form method="post" action="<?= url('/reports/cpl-export/batches/generate') ?>">
        <?= csrf_field() ?>
        <input type="hidden" name="month_end" value="<?= e($batch['month_end']) ?>">
        <button type="submit" class="btn btn-outline-secondary btn-sm" <?= !in_array($batch['status'], ['Draft', 'Ready for Review'], true) ? 'disabled' : '' ?>>Revalidate</button>
      </form>

      <?php if ($batch['status'] === 'Ready for Review'): ?>
        <form method="post" action="<?= url('/reports/cpl-export/batches/' . $batch['id'] . '/submit-for-approval') ?>" onsubmit="return confirm('Submit this batch for approval?');">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-primary btn-sm">Submit for Approval</button>
        </form>
      <?php endif; ?>

      <?php if ($batch['status'] === 'Pending Approval'): ?>
        <form method="post" action="<?= url('/reports/cpl-export/batches/' . $batch['id'] . '/approve') ?>" onsubmit="return confirm('Approve this batch? This generates the extract file.');">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-success btn-sm">Approve</button>
        </form>
        <form method="post" action="<?= url('/reports/cpl-export/batches/' . $batch['id'] . '/reject') ?>" onsubmit="var r = prompt('Reason for rejecting this batch:'); if (!r) { return false; } this.querySelector('[name=comments]').value = r; return true;">
          <?= csrf_field() ?>
          <input type="hidden" name="comments" value="">
          <button type="submit" class="btn btn-outline-danger btn-sm">Reject</button>
        </form>
      <?php endif; ?>

      <?php if ($batch['status'] === 'Approved'): ?>
        <a href="<?= url('/reports/cpl-export/batches/' . $batch['id'] . '/download') ?>" class="btn btn-info btn-sm"><i class="mdi mdi-file-download"></i> Download Extract</a>
      <?php endif; ?>

      <a href="<?= url('/reports/cpl-export/batches') ?>" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
    </div>
  </div>
</div>

<?php if (!empty($errorRecords)): ?>
<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title text-danger">Data Quality Worklist &mdash; Blocking Errors (<?= count($errorRecords) ?>)</h5>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Loan</th><th>Borrower</th><th>Issues</th><th></th></tr></thead>
        <tbody>
          <?php foreach ($errorRecords as $r): ?>
            <?php $messages = json_decode($r['validation_messages'], true) ?: []; ?>
            <tr>
              <td><?= e($r['loan_no']) ?></td>
              <td><?= e($r['first_name'] . ' ' . $r['last_name']) ?> (<?= e($r['borrower_no']) ?>)</td>
              <td class="small">
                <?php foreach ($messages as $m): ?>
                  <?php if ($m['severity'] === 'BLOCKING'): ?>
                    <div class="text-danger"><?= e($m['message']) ?></div>
                  <?php endif; ?>
                <?php endforeach; ?>
              </td>
              <td><a href="<?= url('/borrowers/' . $r['borrower_id']) ?>" class="btn btn-sm btn-outline-dark">Open Borrower</a></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
<?php endif; ?>

<?php if (!empty($warningRecords)): ?>
<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title text-warning-emphasis">Warnings (<?= count($warningRecords) ?>)</h5>
    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Loan</th><th>Borrower</th><th>Issues</th></tr></thead>
        <tbody>
          <?php foreach ($warningRecords as $r): ?>
            <?php $messages = json_decode($r['validation_messages'], true) ?: []; ?>
            <tr>
              <td><?= e($r['loan_no']) ?></td>
              <td><?= e($r['first_name'] . ' ' . $r['last_name']) ?> (<?= e($r['borrower_no']) ?>)</td>
              <td class="small">
                <?php foreach ($messages as $m): ?>
                  <?php if ($m['severity'] === 'WARNING'): ?>
                    <div class="text-warning-emphasis"><?= e($m['message']) ?></div>
                  <?php endif; ?>
                <?php endforeach; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
<?php endif; ?>

<?php if ($batch['status'] === 'Rejected' && !empty($batch['rejection_reason'])): ?>
<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Rejection Reason</h5>
    <p class="mb-0"><?= e($batch['rejection_reason']) ?></p>
    <p class="text-muted small mb-0">Rejected by <?= e($batch['rejected_by_name'] ?? '—') ?> on <?= e(date('d M Y H:i', strtotime($batch['rejected_at']))) ?></p>
  </div>
</div>
<?php endif; ?>
