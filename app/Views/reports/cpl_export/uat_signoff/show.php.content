<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1">CPL <?= e($batch['batch_type']) ?> Sign-off Test &mdash; <?= e($batch['month_end']) ?></h4>
        <p class="text-muted small mb-0">Synthetic UAT test data only -- built from Creditinfo's own approved test National IDs, never a real borrower or loan.</p>
      </div>
      <span class="badge fs-6 bg-<?= $batch['blocking_error_count'] > 0 ? 'danger' : 'success' ?>"><?= $batch['blocking_error_count'] > 0 ? 'NOT READY' : 'READY' ?></span>
    </div>

    <div class="row text-center g-3 mt-2">
      <div class="col-4"><div class="border rounded p-3"><div class="h4 mb-0"><?= (int) $batch['total_records'] ?></div><div class="text-muted small">Records</div></div></div>
      <div class="col-4"><div class="border rounded p-3"><div class="h4 mb-0 text-danger"><?= (int) $batch['blocking_error_count'] ?></div><div class="text-muted small">Blocking Errors</div></div></div>
      <div class="col-4"><div class="border rounded p-3"><div class="h4 mb-0 text-warning-emphasis"><?= (int) $batch['warning_count'] ?></div><div class="text-muted small">Warnings</div></div></div>
    </div>

    <div class="mt-3 d-flex gap-2 flex-wrap">
      <a href="<?= url('/reports/cpl-export/uat-signoff/' . $batch['id'] . '/download') ?>" class="btn btn-info btn-sm"><i class="mdi mdi-file-download"></i> Download Test File</a>
      <a href="<?= url('/reports/cpl-export/uat-signoff') ?>" class="btn btn-outline-secondary btn-sm">Back to Sign-off Dashboard</a>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Validation Results</h5>
    <?php foreach ($testRecords as $i => $r): ?>
      <div class="border rounded p-2 mb-2">
        <div class="d-flex justify-content-between">
          <strong><?= e($r['fields']['account_no'] ?? ('Record ' . ($i + 1))) ?></strong>
          <span class="badge bg-<?= $r['status'] === 'Valid' ? 'success' : ($r['status'] === 'Warning' ? 'warning text-dark' : 'danger') ?>"><?= e($r['status']) ?></span>
        </div>
        <?php if (!empty($r['issues'])): ?>
          <ul class="small mb-0 mt-1">
            <?php foreach ($r['issues'] as $issue): ?>
              <li class="<?= $issue['severity'] === 'BLOCKING' ? 'text-danger' : ($issue['severity'] === 'WARNING' ? 'text-warning-emphasis' : 'text-muted') ?>">
                [<?= e($issue['severity']) ?>] <?= e($issue['message']) ?>
              </li>
            <?php endforeach; ?>
          </ul>
        <?php else: ?>
          <p class="small text-muted mb-0 mt-1">No issues found.</p>
        <?php endif; ?>
      </div>
    <?php endforeach; ?>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Submission Result</h5>
    <p class="text-muted small">
      Record the outcome only once Creditinfo has actually processed this file and returned a load/result
      confirmation. A file being uploaded is not by itself an accepted outcome.
    </p>

    <?php if (!empty($batch['submission_outcome'])): ?>
      <p class="mb-1"><strong>Current outcome:</strong>
        <span class="badge bg-<?= $batch['submission_outcome'] === 'Accepted' ? 'success' : (in_array($batch['submission_outcome'], ['Rejected', 'Partially Rejected'], true) ? 'danger' : 'warning text-dark') ?>"><?= e($batch['submission_outcome']) ?></span>
      </p>
      <?php if (!empty($batch['submission_notes'])): ?><p class="small mb-1"><?= e($batch['submission_notes']) ?></p><?php endif; ?>
      <p class="text-muted small">Recorded <?= e(date('d M Y H:i', strtotime($batch['submission_recorded_at']))) ?></p>
    <?php endif; ?>

    <form method="post" action="<?= url('/reports/cpl-export/uat-signoff/' . $batch['id'] . '/record-outcome') ?>" class="row g-2 mt-2">
      <?= csrf_field() ?>
      <div class="col-md-4">
        <select name="submission_outcome" class="form-select form-select-sm" required>
          <option value="">Select outcome</option>
          <option value="Awaiting Load Report">Submitted -- Awaiting Load Report</option>
          <option value="Accepted">Accepted</option>
          <option value="Rejected">Rejected</option>
          <option value="Partially Rejected">Partially Rejected</option>
        </select>
      </div>
      <div class="col-md-5">
        <input type="text" name="notes" class="form-control form-control-sm" placeholder="Load report reference / rejection reason">
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-sm btn-primary w-100">Record Outcome</button>
      </div>
    </form>
  </div>
</div>
