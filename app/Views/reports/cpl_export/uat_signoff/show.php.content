<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1">CPL <?= e($batch['batch_type']) ?> Sign-off Test &mdash; <?= e($batch['month_end']) ?></h4>
        <p class="text-muted small mb-0">Synthetic UAT test data only -- built from Creditinfo's own approved test National IDs, never a real borrower or loan.</p>
      </div>
      <span class="badge fs-6 bg-<?= $batch['blocking_error_count'] > 0 ? 'danger' : 'success' ?>"><?= $batch['blocking_error_count'] > 0 ? 'NOT READY' : 'READY' ?></span>
    </div>

    <div class="row text-center g-3 mt-2">
      <div class="col-4"><div class="border rounded p-3"><div class="h4 mb-0"><?= (int) $batch['total_records'] ?></div><div class="text-muted small">Records</div></div></div>
      <div class="col-4"><div class="border rounded p-3"><div class="h4 mb-0 text-danger"><?= (int) $batch['blocking_error_count'] ?></div><div class="text-muted small">Blocking Errors</div></div></div>
      <div class="col-4"><div class="border rounded p-3"><div class="h4 mb-0 text-warning-emphasis"><?= (int) $batch['warning_count'] ?></div><div class="text-muted small">Warnings</div></div></div>
    </div>

    <div class="mt-3 d-flex gap-2 flex-wrap">
      <a href="<?= url('/reports/cpl-export/uat-signoff/' . $batch['id'] . '/download') ?>" class="btn btn-info btn-sm"><i class="mdi mdi-file-download"></i> Download Test File</a>
      <a href="<?= url('/reports/cpl-export/uat-signoff') ?>" class="btn btn-outline-secondary btn-sm">Back to Sign-off Dashboard</a>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Validation Results</h5>
    <?php foreach ($testRecords as $i => $r): ?>
      <div class="border rounded p-2 mb-2">
        <div class="d-flex justify-content-between">
          <strong><?= e($r['fields']['account_no'] ?? ('Record ' . ($i + 1))) ?></strong>
          <span class="badge bg-<?= $r['status'] === 'Valid' ? 'success' : ($r['status'] === 'Warning' ? 'warning text-dark' : 'danger') ?>"><?= e($r['status']) ?></span>
        </div>
        <?php if (!empty($r['issues'])): ?>
          <ul class="small mb-0 mt-1">
            <?php foreach ($r['issues'] as $issue): ?>
              <li class="<?= $issue['severity'] === 'BLOCKING' ? 'text-danger' : ($issue['severity'] === 'WARNING' ? 'text-warning-emphasis' : 'text-muted') ?>">
                [<?= e($issue['severity']) ?>] <?= e($issue['message']) ?>
              </li>
            <?php endforeach; ?>
          </ul>
        <?php else: ?>
          <p class="small text-muted mb-0 mt-1">No issues found.</p>
        <?php endif; ?>
      </div>
    <?php endforeach; ?>
  </div>
</div>

<?php
  $alreadyUploaded = !empty($upload['uploaded_at']);
  // A result somebody recorded (Rejected, say) also means a file went to Creditinfo before, even without our upload note.
  $recordedOutcome = (string) ($upload['recorded_outcome'] ?? '');
  $sentBefore = $alreadyUploaded || $recordedOutcome !== '';
  $uploadedWhen = $alreadyUploaded ? date('d M Y \a\t H:i', strtotime($upload['uploaded_at'])) : '';
  $unclearNote = (string) ($upload['unclear_note'] ?? '');
  $replaces = 'Uploading it again replaces that file on Creditinfo\'s server and sets the result back to Awaiting Load Report. Only do this if Creditinfo asked for it. Continue?';
  $confirmText = $unclearNote !== ''
    ? 'The last upload of ' . $upload['filename'] . ' ended unclear: Creditinfo may already have it. Ask Creditinfo first. Upload it again anyway?'
    : ($alreadyUploaded
      ? $upload['filename'] . ' was already uploaded on ' . $uploadedWhen . '. ' . $replaces
      : ($recordedOutcome !== ''
        ? 'A result is already recorded for this file (' . $recordedOutcome . '). ' . $replaces
        : 'Send ' . $upload['filename'] . ' (' . (int) $upload['record_count'] . ' test records) to Creditinfo now? Destination: ' . $upload['destination'] . '. A file with the same name there is replaced. Once sent it cannot be taken back.'));
  $isRepeat = $alreadyUploaded && str_contains((string) $upload['uploaded_note'], ' Earlier result: ');
  $mailText = $alreadyUploaded
    ? "Subject: " . $upload['trading_name'] . " (" . $upload['supplier_ref'] . ") - CPL " . $upload['kind'] . " sign-off test file uploaded\n\n"
      . "Hi,\n\n"
      . "We have uploaded the CPL " . $upload['kind'] . " sign-off test file to the Creditinfo SFTP server on " . $uploadedWhen . ".\n\n"
      . "File: " . $upload['filename'] . "\n"
      . "Records: " . (int) $upload['record_count'] . " (the approved test IDs only)\n"
      . "Supplier reference number: " . $upload['supplier_ref'] . "\n\n"
      . ($isRepeat ? "This replaces the file we sent earlier, so please load this one.\n\n" : '')
      . "Please load it and send us the load report.\n\n"
      . "Regards,\n" . $upload['trading_name']
    : '';
?>
<div class="card mt-3" id="send-to-creditinfo">
  <div class="card-body">
    <h5 class="card-title">Send to Creditinfo</h5>
    <p class="text-muted small">
      Uploads this test file to the Creditinfo SFTP server, using the connection saved in
      <a href="<?= url('/creditinfo/public-defaults/settings') ?>">Public Defaults Settings</a>.
      It is always sent as a <strong>T702 (test)</strong> file and holds only the test IDs Creditinfo approved,
      never a real borrower. After uploading, a ready-made message for your Creditinfo contacts appears here.
      Sending a file does not mean Creditinfo accepted it: record Creditinfo's answer under Submission Result below.
    </p>

    <?php if (!empty($upload['filename'])): ?>
      <dl class="row small mb-2">
        <dt class="col-sm-3">File name</dt>
        <dd class="col-sm-9"><code><?= e($upload['filename']) ?></code> (<?= (int) $upload['record_count'] ?> records)</dd>
        <?php if ($upload['destination'] !== ''): ?>
          <dt class="col-sm-3">Destination</dt>
          <dd class="col-sm-9"><?= e($upload['destination']) ?></dd>
        <?php endif; ?>
      </dl>
    <?php endif; ?>

    <?php if ($unclearNote !== ''): ?>
      <div class="alert alert-danger small py-2"><strong>The last upload attempt ended unclear.</strong> <?= e($unclearNote) ?></div>
    <?php endif; ?>

    <?php if ($alreadyUploaded): ?>
      <div class="alert alert-info small py-2"><strong>Already uploaded.</strong> <?= e($upload['uploaded_note']) ?></div>
    <?php endif; ?>

    <?php if (($upload['hold'] ?? null) === 'recent'): ?>
      <p class="small text-muted mb-0">The Upload button comes back in a couple of minutes, in case you need it. Do not send this file again unless Creditinfo asks you to.</p>
    <?php elseif (($upload['hold'] ?? null) === 'accepted'): ?>
      <div class="alert alert-success small mb-0"><strong>Accepted by Creditinfo.</strong> This test file does not need to be sent again.</div>
    <?php elseif ($upload['can_upload']): ?>
      <form method="post" action="<?= url('/reports/cpl-export/uat-signoff/' . $batch['id'] . '/upload-sftp') ?>" onsubmit="<?= e('return confirm(' . json_encode($confirmText, JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_SLASHES) . ');') ?>">
        <?= csrf_field() ?>
        <button type="submit" class="btn btn-primary btn-sm" data-busy-label="Uploading..."><i class="mdi mdi-cloud-upload"></i> <?= $sentBefore ? 'Upload again' : 'Upload to Creditinfo' ?></button>
      </form>
    <?php else: ?>
      <div class="alert alert-warning small mb-0"><strong>Cannot upload yet.</strong> <?= e($upload['problem']) ?></div>
    <?php endif; ?>

    <?php if ($alreadyUploaded): ?>
      <div class="mt-3">
        <label class="form-label small fw-semibold" for="uatUploadMail">Message to send to your Creditinfo contacts</label>
        <textarea id="uatUploadMail" class="form-control form-control-sm" rows="9" readonly><?= e($mailText) ?></textarea>
        <button type="button" class="btn btn-outline-secondary btn-sm mt-2"
          onclick="var b = this, t = document.getElementById('uatUploadMail'); t.focus(); t.select(); var ok = function () { b.textContent = 'Copied'; }; var fb = function () { var r = false; try { r = document.execCommand('copy'); } catch (e) {} b.textContent = r ? 'Copied' : 'Select the text and press Ctrl+C'; }; if (navigator.clipboard &amp;&amp; navigator.clipboard.writeText) { navigator.clipboard.writeText(t.value).then(ok, fb); } else { fb(); }">Copy message</button>
      </div>
    <?php endif; ?>
  </div>
</div>

<div class="card mt-3">
  <div class="card-body">
    <h5 class="card-title">Submission Result</h5>
    <p class="text-muted small">
      Record the outcome only once Creditinfo has actually processed this file and returned a load/result
      confirmation. A file being uploaded is not by itself an accepted outcome.
    </p>

    <?php if (!empty($batch['submission_outcome'])): ?>
      <p class="mb-1"><strong>Current outcome:</strong>
        <span class="badge bg-<?= $batch['submission_outcome'] === 'Accepted' ? 'success' : (in_array($batch['submission_outcome'], ['Rejected', 'Partially Rejected'], true) ? 'danger' : 'warning text-dark') ?>"><?= e($batch['submission_outcome']) ?></span>
      </p>
      <?php if (!empty($batch['submission_notes'])): ?><p class="small mb-1"><?= e($batch['submission_notes']) ?></p><?php endif; ?>
      <p class="text-muted small">Recorded <?= e(date('d M Y H:i', strtotime($batch['submission_recorded_at']))) ?></p>
    <?php endif; ?>

    <form method="post" action="<?= url('/reports/cpl-export/uat-signoff/' . $batch['id'] . '/record-outcome') ?>" class="row g-2 mt-2">
      <?= csrf_field() ?>
      <div class="col-md-4">
        <select name="submission_outcome" class="form-select form-select-sm" aria-label="Result from Creditinfo" required>
          <option value="">Select outcome</option>
          <option value="Awaiting Load Report">Submitted -- Awaiting Load Report</option>
          <option value="Accepted">Accepted</option>
          <option value="Rejected">Rejected</option>
          <option value="Partially Rejected">Partially Rejected</option>
        </select>
      </div>
      <div class="col-md-5">
        <input type="text" name="notes" class="form-control form-control-sm" placeholder="Load report reference / rejection reason" aria-label="Load report reference or rejection reason">
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-sm btn-primary w-100">Record Outcome</button>
      </div>
    </form>
  </div>
</div>
