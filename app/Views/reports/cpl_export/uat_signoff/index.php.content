<?= flash_messages() ?>

<?php
  $badgeFor = function (string $status) {
      return match (true) {
          in_array($status, ['PASSED', 'ACCEPTED', 'READY FOR SIGN-OFF'], true) => 'success',
          in_array($status, ['TESTED - FAILED', 'REJECTED'], true) => 'danger',
          in_array($status, ['NOT CONFIGURED', 'NOT READY'], true) => 'secondary',
          in_array($status, ['WAITING FOR AUTHENTICATION', 'CONFIGURED', 'READY TO TEST', 'READY', 'SUBMITTED'], true) => 'warning text-dark',
          default => 'secondary',
      };
  };
?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-1">CREDITINFO INTEGRATION SIGN-OFF</h4>
    <p class="text-muted small">
      Creditinfo will only sign off this integration once the CBS API is working successfully, a CPL Daily
      file has been accepted, and a CPL Monthly file has been accepted. A file being generated, validated,
      or even submitted does not by itself mean Creditinfo accepted it -- ACCEPTED is only ever set here
      after a human records Creditinfo's own load/result confirmation.
    </p>

    <div class="alert alert-<?= $overall === 'READY FOR SIGN-OFF' ? 'success' : 'secondary' ?> fs-6 fw-bold text-center">
      CREDITINFO SIGN-OFF: <?= e($overall) ?>
    </div>
  </div>
</div>

<div class="row mt-3">
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title">CBS API</h5>
        <table class="table table-sm">
          <tbody>
            <tr><td>CBS Authentication</td><td class="text-end"><span class="badge bg-<?= $badgeFor($authStatus) ?>"><?= e($authStatus) ?></span></td></tr>
            <tr><td>Smart Individual Search <div class="text-muted small">/search/smart/individual</div></td><td class="text-end"><span class="badge bg-<?= $badgeFor($searchStatus) ?>"><?= e($searchStatus) ?></span></td></tr>
            <tr><td>Report Generation <div class="text-muted small">/reports/custom (CreditinfoReportPlus)</div></td><td class="text-end"><span class="badge bg-<?= $badgeFor($reportStatus) ?>"><?= e($reportStatus) ?></span></td></tr>
            <tr><td>PDF Retrieval <div class="text-muted small">/reports/pdf</div></td><td class="text-end"><span class="badge bg-<?= $badgeFor($pdfStatus) ?>"><?= e($pdfStatus) ?></span></td></tr>
          </tbody>
        </table>
        <?php if ($authStatus === 'NOT CONFIGURED'): ?>
          <p class="text-muted small mb-0">No live call can be attempted until Client ID, Client Secret, Auth URL and API Base URL are entered in <a href="<?= url('/creditinfo/settings/manage') ?>">Creditinfo Settings</a>.</p>
        <?php endif; ?>
        <a href="<?= url('/creditinfo/settings') ?>" class="btn btn-sm btn-outline-secondary mt-2">Creditinfo Settings / UAT Test Centre</a>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-body">
        <h5 class="card-title">CPL Sign-off Files</h5>
        <table class="table table-sm">
          <tbody>
            <tr><td>CPL Daily File</td><td class="text-end"><span class="badge bg-<?= $badgeFor($dailyStatus) ?>"><?= e($dailyStatus) ?></span></td></tr>
            <tr><td>CPL Monthly File</td><td class="text-end"><span class="badge bg-<?= $badgeFor($monthlyStatus) ?>"><?= e($monthlyStatus) ?></span></td></tr>
          </tbody>
        </table>

        <form method="post" action="<?= url('/reports/cpl-export/uat-signoff/generate-daily') ?>" class="d-inline">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-sm btn-primary">Generate CPL Daily Test File</button>
        </form>
        <form method="post" action="<?= url('/reports/cpl-export/uat-signoff/generate-monthly') ?>" class="d-inline">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-sm btn-primary">Generate CPL Monthly Test File</button>
        </form>

        <div class="mt-3">
          <?php if ($latestDailyBatch): ?>
            <a href="<?= url('/reports/cpl-export/uat-signoff/' . $latestDailyBatch['id']) ?>" class="d-block small">Latest Daily test: <?= e($latestDailyBatch['month_end']) ?> &rarr;</a>
          <?php endif; ?>
          <?php if ($latestMonthlyBatch): ?>
            <a href="<?= url('/reports/cpl-export/uat-signoff/' . $latestMonthlyBatch['id']) ?>" class="d-block small">Latest Monthly test: <?= e($latestMonthlyBatch['month_end']) ?> &rarr;</a>
          <?php endif; ?>
        </div>
      </div>
    </div>
  </div>
</div>
