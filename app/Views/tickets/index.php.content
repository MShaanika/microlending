<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
      <h4 class="card-title mb-0">Support Tickets</h4>
      <a href="<?= url('/tickets/create') ?>" class="btn btn-info waves-effect waves-light">
        <i class="mdi mdi-plus"></i> Raise Ticket
      </a>
    </div>

    <?php
      $bar = [
          'action' => url('/tickets'),
          'search' => ['value' => $search ?? '', 'placeholder' => 'Ticket no or subject'],
          'status' => ['value' => $status ?? '', 'options' => ['Open', 'In Progress', 'Resolved', 'Closed']],
          'date' => ['label' => 'Raised', 'from' => $filter['from'] ?? '', 'to' => $filter['to'] ?? ''],
          'export' => true,
      ];
      include __DIR__ . '/../partials/list_filter_bar.php';
    ?>

    <div data-list-results>
    <?php $count = count($tickets); include __DIR__ . '/../partials/list_count.php'; ?>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Ticket No</th><th>Branch</th><th>Subject</th><th>Priority</th><th>Raised By</th><th>Assigned To</th><th>Status</th><th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($tickets)): ?>
            <tr><td colspan="8" class="text-center text-muted py-4"><?= !empty($filtersActive) ? 'Nothing matches your filters.' : 'No tickets found.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($tickets as $t): ?>
            <?php
              $statusBadge = match ($t['status']) {
                'Open' => 'danger',
                'In Progress' => 'warning',
                'Resolved' => 'info',
                default => 'secondary',
              };
              $priorityBadge = match ($t['priority']) {
                'Urgent' => 'danger',
                'High' => 'warning',
                'Medium' => 'info',
                default => 'secondary',
              };
            ?>
            <tr>
              <td><?= e($t['ticket_no']) ?></td>
              <td><?= e($t['branch_name'] ?? '—') ?></td>
              <td><?= e($t['subject']) ?></td>
              <td><span class="badge bg-<?= $priorityBadge ?>"><?= e($t['priority']) ?></span></td>
              <td><?= e($t['raised_by_name'] ?? '—') ?></td>
              <td><?= e($t['assigned_to_name'] ?? '—') ?></td>
              <td><span class="badge bg-<?= $statusBadge ?>"><?= e($t['status']) ?></span></td>
              <td class="text-end">
                <a href="<?= url('/tickets/' . $t['id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i></a>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
