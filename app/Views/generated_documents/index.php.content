<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Generated Documents</h4>
      <a href="<?= url('/letters/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Generate Letter</a>
    </div>
    <p class="text-muted small">Every document generated across the system &mdash; Letters, Loan Reschedules, Debit Order Cancellations, Applications and Refund Claims.</p>

    <?php
      $bar = [
          'action' => url('/generated-documents'),
          'search' => ['value' => $search ?? '', 'placeholder' => 'Document no, title or borrower'],
          'status' => ['value' => $status ?? '', 'options' => ['Draft', 'Generated', 'Sent', 'Signed', 'Cancelled']],
          'selects' => [['name' => 'source_module', 'label' => 'Source', 'all' => 'All Sources', 'value' => $sourceModule ?? '', 'options' => array_combine($sourceModules ?? [], $sourceModules ?? [])]],
          'branches' => $branches ?? [], 'branch' => $selectedBranchId ?? null,
          'date' => ['label' => 'Generated', 'from' => $filter['from'] ?? '', 'to' => $filter['to'] ?? ''],
          'export' => true,
      ];
      include __DIR__ . '/../partials/list_filter_bar.php';
    ?>

    <div data-list-results>
    <?php $count = count($documents); include __DIR__ . '/../partials/list_count.php'; ?>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Document No</th><th>Title</th><th>Source</th><th>Related To</th><th>Status</th><th>Generated</th><th>By</th><th class="text-end">Action</th></tr>
        </thead>
        <tbody>
          <?php if (empty($documents)): ?>
            <tr><td colspan="8" class="text-center text-muted py-4"><?= !empty($filtersActive) ? 'Nothing matches your filters.' : 'No documents match this filter.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($documents as $d): ?>
            <?php
              $badge = match ($d['status']) {
                'Generated', 'Sent', 'Signed' => 'success',
                'Cancelled' => 'danger',
                default => 'warning',
              };
            ?>
            <tr>
              <td><?= e($d['document_no']) ?></td>
              <td><?= e($d['document_title']) ?></td>
              <td><span class="badge bg-secondary"><?= e($d['source_module']) ?: 'n/a' ?></span></td>
              <td>
                <?php if ($d['borrower_id']): ?>
                  <a href="<?= url('/borrowers/' . $d['borrower_id']) ?>"><?= e($d['borrower_name']) ?: 'Borrower #' . $d['borrower_id'] ?></a>
                <?php elseif ($d['loan_id']): ?>
                  <a href="<?= url('/loans/' . $d['loan_id']) ?>">Loan #<?= (int) $d['loan_id'] ?></a>
                <?php else: ?>
                  <span class="text-muted">&mdash;</span>
                <?php endif; ?>
              </td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($d['status']) ?></span></td>
              <td><?= $d['generated_at'] ? e(date('d M Y H:i', strtotime($d['generated_at']))) : '&mdash;' ?></td>
              <td class="text-muted small"><?= e($d['generated_by_name'] ?: '—') ?></td>
              <td class="text-end">
                <?php if ($d['file_path']): ?>
                  <a href="<?= url('/generated-documents/' . $d['id'] . '/download') ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-download"></i> Download</a>
                <?php else: ?>
                  <span class="text-muted small">Not ready</span>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
