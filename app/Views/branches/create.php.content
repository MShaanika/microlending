<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Add Branch</h4>

    <form method="post" action="<?= url('/branches') ?>">
      <?= csrf_field() ?>

      <div class="mb-3">
        <label class="form-label">Branch Name <span class="text-danger">*</span></label>
        <input type="text" name="branch_name" class="form-control <?= isset($errors['branch_name']) ? 'is-invalid' : '' ?>" value="<?= old('branch_name', $old) ?>">
        <?php if (isset($errors['branch_name'])): ?><div class="invalid-feedback d-block"><?= e($errors['branch_name']) ?></div><?php endif; ?>
      </div>

      <div class="mb-3">
        <label class="form-label">Branch Code</label>
        <input type="text" name="branch_code" class="form-control <?= isset($errors['branch_code']) ? 'is-invalid' : '' ?>" value="<?= old('branch_code', $old) ?>" placeholder="e.g. HO, WHK">
        <?php if (isset($errors['branch_code'])): ?><div class="invalid-feedback d-block"><?= e($errors['branch_code']) ?></div><?php endif; ?>
      </div>

      <div class="mb-3">
        <label class="form-label">Phone</label>
        <input type="text" name="phone" class="form-control" value="<?= old('phone', $old) ?>">
      </div>

      <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" value="<?= old('email', $old) ?>">
      </div>

      <div class="mb-3">
        <label class="form-label">Address</label>
        <textarea name="address" class="form-control" rows="3"><?= old('address', $old) ?></textarea>
      </div>

      <button type="submit" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Branch</button>
      <a href="<?= url('/branches') ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
