<?php use App\Core\Auth; ?>

<?= flash_messages() ?>

<?php if (Auth::can('retention.manage')): ?>
<div class="card mb-3">
  <div class="card-body">
    <h4 class="card-title">Place a Legal Hold</h4>
    <p class="text-muted small">A record under hold is never deleted by a retention run, even once it's past its normal retention period.</p>
    <form method="post" action="<?= url('/retention/holds') ?>" class="row g-2">
      <?= csrf_field() ?>
      <div class="col-md-3">
        <input type="text" name="resource_table" class="form-control" placeholder="Table (e.g. idempotency_keys)" required>
      </div>
      <div class="col-md-2">
        <input type="number" name="resource_id" class="form-control" placeholder="Record ID" required>
      </div>
      <div class="col-md-5">
        <input type="text" name="reason" class="form-control" placeholder="Reason (required)" required>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100"><i class="mdi mdi-lock"></i> Place Hold</button>
      </div>
    </form>
  </div>
</div>
<?php endif; ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h4 class="card-title mb-0">Legal Holds</h4>
      <a href="<?= url('/retention') ?>" class="btn btn-outline-secondary btn-sm">Back to Policies</a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Table</th>
            <th>Record</th>
            <th>Reason</th>
            <th>Placed</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($holds)): ?>
            <tr><td colspan="6" class="text-center text-muted py-4">No legal holds on record.</td></tr>
          <?php endif; ?>
          <?php foreach ($holds as $h): ?>
            <tr>
              <td><code><?= e($h['resource_table']) ?></code></td>
              <td>#<?= (int) $h['resource_id'] ?></td>
              <td><?= e($h['reason']) ?></td>
              <td class="text-nowrap"><?= e(date('d M Y H:i', strtotime($h['placed_at']))) ?> by <?= e($h['placed_by_name']) ?></td>
              <td>
                <?php if ($h['is_active']): ?>
                  <span class="badge bg-danger">Active</span>
                <?php else: ?>
                  <span class="badge bg-secondary">Released</span>
                  <div class="text-muted small">by <?= e($h['released_by_name'] ?: '—') ?>: <?= e($h['release_reason']) ?></div>
                <?php endif; ?>
              </td>
              <td>
                <?php if ($h['is_active'] && Auth::can('retention.manage')): ?>
                  <form method="post" action="<?= url('/retention/holds/' . $h['id'] . '/release') ?>" class="d-flex gap-1" onsubmit="return confirm('Release this legal hold?');">
                    <?= csrf_field() ?>
                    <input type="text" name="reason" class="form-control form-control-sm" placeholder="Release reason">
                    <button type="submit" class="btn btn-sm btn-outline-success">Release</button>
                  </form>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
