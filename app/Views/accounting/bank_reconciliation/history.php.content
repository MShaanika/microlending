<?= flash_messages() ?>

<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <h4 class="card-title mb-0">Bank Reconciliation History</h4>
      <a href="<?= url('/accounting/bank-reconciliation') ?>" class="btn btn-outline-secondary btn-sm"><i class="mdi mdi-arrow-left"></i> Back to Reconciliation</a>
    </div>

    <form method="get" class="row g-3 mt-2">
      <div class="col-md-3">
        <label class="form-label">Bank Account</label>
        <select name="bank_account_id" class="form-select">
          <option value="">All Bank Accounts</option>
          <?php foreach ($bankAccounts as $ba): ?>
            <option value="<?= (int) $ba['id'] ?>" <?= $filters['bank_account_id'] === (int) $ba['id'] ? 'selected' : '' ?>>
              <?= e($ba['bank_name'] . ' - ' . $ba['account_name'] . ' (' . $ba['account_number'] . ')') ?>
            </option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label">From Date</label>
        <input type="date" name="from_date" class="form-control" value="<?= e($filters['from_date']) ?>">
      </div>
      <div class="col-md-2">
        <label class="form-label">To Date</label>
        <input type="date" name="to_date" class="form-control" value="<?= e($filters['to_date']) ?>">
      </div>
      <div class="col-md-3">
        <label class="form-label">Matched By</label>
        <select name="matched_by" class="form-select">
          <option value="">All Users</option>
          <?php foreach ($matchers as $m): ?>
            <option value="<?= (int) $m['id'] ?>" <?= $filters['matched_by'] === (int) $m['id'] ? 'selected' : '' ?>><?= e($m['name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-2 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100"><i class="mdi mdi-filter"></i> Filter</button>
      </div>
    </form>
  </div>
</div>

<div class="row mb-3">
  <div class="col-md-4">
    <div class="alert alert-info mb-0">
      <b>Total Matches</b><br>
      <span class="fs-5"><?= number_format($totalMatches) ?></span>
    </div>
  </div>
  <div class="col-md-4">
    <div class="alert alert-success mb-0">
      <b>Total Matched Amount</b><br>
      <span class="fs-5"><?= format_money($totalAmount) ?></span>
    </div>
  </div>
  <div class="col-md-4">
    <div class="alert alert-warning mb-0">
      <b>Last Match Date</b><br>
      <span class="fs-5"><?= $lastMatchDate ? e(date('d/m/Y H:i', strtotime($lastMatchDate))) : '&mdash;' ?></span>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Matched Date</th>
            <th>Bank Account</th>
            <th>Bank Date</th>
            <th>Bank Reference</th>
            <th>Description</th>
            <th class="text-end">Matched Amount</th>
            <th>Journal No</th>
            <th>Type</th>
            <th>Matched By</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($matches)): ?>
            <tr><td colspan="9" class="text-center text-muted py-4">No reconciliation history found.</td></tr>
          <?php endif; ?>
          <?php foreach ($matches as $m): ?>
            <tr>
              <td><?= e(date('d/m/Y H:i', strtotime($m['reconciled_at']))) ?></td>
              <td><?= e(trim($m['bank_name'] . ' - ' . $m['bank_account_name'] . ' - ' . $m['account_number'], ' -')) ?></td>
              <td><?= e(date('d/m/Y', strtotime($m['transaction_date']))) ?></td>
              <td><strong><?= e($m['bank_reference'] ?: '-') ?></strong></td>
              <td><?= e($m['bank_description']) ?></td>
              <td class="text-end"><?= format_money($m['matched_amount']) ?></td>
              <td>
                <?php if ($m['journal_id']): ?>
                  <a href="<?= url('/accounting/journals/' . (int) $m['journal_id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i> <?= e($m['journal_no']) ?></a>
                <?php else: ?>
                  &mdash;
                <?php endif; ?>
              </td>
              <td><?= e($m['reconciliation_status']) ?></td>
              <td><?= e($m['matched_by_name'] ?? '-') ?></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
