<?= flash_messages() ?>

<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1">Write-Off <?= e($writeOff['write_off_no']) ?></h4>
        <p class="text-muted small mb-0">Loan <?= e($writeOff['loan_no']) ?> &bull; <?= e($writeOff['borrower_name']) ?></p>
      </div>
      <span class="badge fs-6 bg-<?= $writeOff['status'] === 'Posted' ? 'success' : ($writeOff['status'] === 'Pending' ? 'secondary' : 'info') ?>"><?= e($writeOff['status']) ?></span>
    </div>

    <div class="row text-center my-3">
      <div class="col-md-3">
        <div class="p-3 border rounded">
          <div class="text-muted small">Outstanding</div>
          <div class="fs-5 fw-bold"><?= e(format_money($writeOff['outstanding_balance'])) ?></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="p-3 border rounded">
          <div class="text-muted small">Provision Used</div>
          <div class="fs-5 fw-bold"><?= e(format_money($writeOff['provision_amount'])) ?></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="p-3 border rounded">
          <div class="text-muted small">Net Write-Off</div>
          <div class="fs-5 fw-bold"><?= e(format_money($writeOff['net_write_off_amount'])) ?></div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="p-3 border rounded border-success">
          <div class="text-muted small">Recovered So Far</div>
          <div class="fs-5 fw-bold"><?= e(format_money($totalRecovered)) ?></div>
        </div>
      </div>
    </div>

    <p><strong>Reason:</strong> <?= e($writeOff['reason']) ?></p>
    <p class="text-muted small">Write-off date: <?= e(date('d M Y', strtotime($writeOff['write_off_date']))) ?></p>

    <div class="d-flex gap-2 flex-wrap">
      <?php if ($writeOff['status'] === 'Pending'): ?>
        <form method="post" action="<?= url('/accounting/loan-write-offs/' . $writeOff['id'] . '/approve') ?>" onsubmit="return confirmSubmit(this, 'Approve this write-off?');">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-success waves-effect waves-light"><i class="mdi mdi-check"></i> Approve</button>
        </form>
      <?php elseif ($writeOff['status'] === 'Approved'): ?>
        <form method="post" action="<?= url('/accounting/loan-write-offs/' . $writeOff['id'] . '/post') ?>" onsubmit="return confirmSubmit(this, 'Post this write-off? This will create a journal entry and mark the loan as written off.');">
          <?= csrf_field() ?>
          <button type="submit" class="btn btn-danger waves-effect waves-light"><i class="mdi mdi-content-save"></i> Post Write-Off</button>
        </form>
      <?php elseif ($writeOff['status'] === 'Posted'): ?>
        <a href="<?= url('/accounting/journals/' . $writeOff['journal_id']) ?>" class="btn btn-outline-primary"><i class="mdi mdi-book-open-variant"></i> View Journal</a>
        <a href="<?= url('/accounting/loan-write-offs/' . $writeOff['id'] . '/recoveries/create') ?>" class="btn btn-info waves-effect waves-light"><i class="mdi mdi-receipt"></i> Record Recovery</a>
      <?php endif; ?>
      <a href="<?= url('/accounting/loan-write-offs') ?>" class="btn btn-outline-secondary">Back to List</a>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <h4 class="card-title"><i class="mdi mdi-history me-1"></i> Approval History</h4>
    <ul class="list-unstyled mb-0">
      <li class="mb-2 pb-2 border-bottom">
        <strong>Requested</strong>
        by <?= e($writeOff['requested_by_name'] ?: '—') ?>
        <span class="text-muted small"> &mdash; <?= e(date('d M Y H:i', strtotime($writeOff['created_at']))) ?></span>
      </li>
      <?php if ($writeOff['approved_by']): ?>
        <li class="mb-2 pb-2 border-bottom">
          <strong>Approved</strong>
          by <?= e($writeOff['approved_by_name'] ?: '—') ?>
          <span class="text-muted small"> &mdash; <?= e(date('d M Y H:i', strtotime($writeOff['approved_at']))) ?></span>
        </li>
      <?php endif; ?>
      <?php if ($writeOff['posted_by']): ?>
        <li class="mb-2 pb-2 border-bottom">
          <strong>Posted</strong>
          by <?= e($writeOff['posted_by_name'] ?: '—') ?>
          <span class="text-muted small"> &mdash; <?= e(date('d M Y H:i', strtotime($writeOff['posted_at']))) ?></span>
        </li>
      <?php endif; ?>
    </ul>
  </div>
</div>

<?php if (!empty($recoveries)): ?>
<div class="card">
  <div class="card-body">
    <h4 class="card-title"><i class="mdi mdi-cash-multiple me-1"></i> Recoveries</h4>
    <div class="table-responsive">
      <table class="table table-sm table-hover align-middle">
        <thead><tr><th>Recovery No.</th><th>Date</th><th class="text-end">Amount</th><th>Reference</th><th>Recorded By</th></tr></thead>
        <tbody>
          <?php foreach ($recoveries as $r): ?>
            <tr>
              <td><?= e($r['recovery_no']) ?></td>
              <td><?= e(date('d M Y', strtotime($r['recovery_date']))) ?></td>
              <td class="text-end"><?= format_money($r['recovered_amount']) ?></td>
              <td><?= e($r['reference_no'] ?: '—') ?></td>
              <td><?= e($r['posted_by_name'] ?: '—') ?></td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
<?php endif; ?>
