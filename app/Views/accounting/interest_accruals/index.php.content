<?= flash_messages() ?>

<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h4 class="card-title mb-1">Interest Accruals</h4>
        <p class="text-muted small mb-0">Recognizes each installment's interest as income the moment its due date arrives, rather than waiting for it to be collected. Posted straight to Interest Income against an Interest Receivable. Payments and the daily cron also trigger this automatically -- use this screen to run it ahead of either, or to catch up after a missed day.</p>
      </div>
      <form method="get" action="<?= url('/accounting/interest-accruals/preview') ?>" class="d-flex gap-2 align-items-end">
        <div>
          <label class="form-label small mb-0">As of date</label>
          <input type="date" name="as_of_date" class="form-control form-control-sm" value="<?= e(date('Y-m-d')) ?>">
        </div>
        <button type="submit" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-calculator"></i> Run Accrual</button>
      </form>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <h5 class="card-title">Past Accrual Runs</h5>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead><tr><th>Due Date</th><th>Installments Accrued</th><th class="text-end">Total Interest</th><th class="text-end">Action</th></tr></thead>
        <tbody>
          <?php if (empty($runs)): ?>
            <tr><td colspan="4" class="text-center text-muted py-4">No interest accrual runs posted yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($runs as $run): ?>
            <tr>
              <td><?= e($run['accrual_date']) ?></td>
              <td><?= (int) $run['installment_count'] ?></td>
              <td class="text-end"><?= e(format_money($run['total_interest'])) ?></td>
              <td class="text-end">
                <a href="<?= url('/accounting/interest-accruals/runs/' . $run['accrual_date']) ?>" class="btn btn-sm btn-outline-primary"><i class="mdi mdi-eye"></i> View</a>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
