<?php
use App\Core\Auth;

$platformMeta = [
    'google_analytics' => ['icon' => 'mdi-google', 'color' => '#f9ab00'],
    'facebook' => ['icon' => 'mdi-facebook', 'color' => '#1877f2'],
    'instagram' => ['icon' => 'mdi-instagram', 'color' => '#e1306c'],
    'linkedin' => ['icon' => 'mdi-linkedin', 'color' => '#0a66c2'],
];
?>
<?= flash_messages() ?>

<div class="d-flex justify-content-between align-items-center mb-3">
  <p class="text-muted mb-0">Log periodic numbers for each platform below to build up the trend charts shown on the Dashboard.</p>
  <?php if (Auth::can('social_analytics.manage')): ?>
    <a href="<?= url('/settings/social-analytics') ?>" class="btn btn-outline-secondary btn-sm"><i class="mdi mdi-cog"></i> Platform Settings</a>
  <?php endif; ?>
</div>

<div class="row">
<?php foreach ($platforms as $platform):
    $meta = $platformMeta[$platform['platform']] ?? ['icon' => 'mdi-chart-line', 'color' => '#635bff'];
    $chartId = 'chart_' . $platform['platform'];
?>
  <div class="col-lg-6 mb-4">
    <div class="card h-100">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <h5 class="card-title mb-0">
            <i class="mdi <?= $meta['icon'] ?>" style="color: <?= $meta['color'] ?>"></i>
            <?= e($platform['display_name']) ?>
          </h5>
          <?php if ((int) $platform['is_enabled'] === 1): ?>
            <span class="badge bg-success">Enabled</span>
          <?php else: ?>
            <span class="badge bg-secondary">Not enabled</span>
          <?php endif; ?>
        </div>

        <?php if ((int) $platform['is_enabled'] !== 1): ?>
          <div class="alert alert-light border text-muted small mb-0">
            Not enabled yet.
            <?php if (Auth::can('social_analytics.manage')): ?>
              <a href="<?= url('/settings/social-analytics') ?>">Enable it in Settings</a> to start logging entries.
            <?php else: ?>
              Ask an administrator to enable it in Settings.
            <?php endif; ?>
          </div>
        <?php else: ?>

          <?php if (!empty($platform['handle_or_property'])): ?>
            <p class="text-muted small mb-2"><?= e($platform['handle_or_property']) ?></p>
          <?php endif; ?>

          <?php if (count($platform['trend']) > 1): ?>
            <div id="<?= $chartId ?>" class="mb-3"></div>
          <?php else: ?>
            <div class="text-muted small mb-3">Add at least 2 entries to see a trend chart.</div>
          <?php endif; ?>

          <?php if (Auth::can('social_analytics.manage')): ?>
          <form method="post" action="<?= url('/social-analytics/' . $platform['id'] . '/entries') ?>" class="border rounded p-2 mb-3">
            <?= csrf_field() ?>
            <div class="row g-2 align-items-end">
              <div class="col-md-3">
                <label class="form-label small mb-0">Date</label>
                <input type="date" name="entry_date" class="form-control form-control-sm" value="<?= e($today) ?>" max="<?= e($today) ?>" required>
              </div>
              <div class="col-md-3">
                <label class="form-label small mb-0"><?= e($platform['metric_1_label']) ?></label>
                <input type="number" step="0.01" name="metric_1" class="form-control form-control-sm" value="0" required>
              </div>
              <div class="col-md-3">
                <label class="form-label small mb-0"><?= e($platform['metric_2_label']) ?></label>
                <input type="number" step="0.01" name="metric_2" class="form-control form-control-sm" value="0" required>
              </div>
              <div class="col-md-3">
                <label class="form-label small mb-0"><?= e($platform['metric_3_label']) ?></label>
                <input type="number" step="0.01" name="metric_3" class="form-control form-control-sm" value="0" required>
              </div>
            </div>
            <div class="mt-2">
              <button type="submit" class="btn btn-sm btn-info waves-effect waves-light"><i class="mdi mdi-content-save"></i> Save Entry</button>
              <span class="text-muted small ms-2">Re-saving the same date updates that entry.</span>
            </div>
          </form>
          <?php endif; ?>

          <?php if (empty($platform['recent_entries'])): ?>
            <div class="text-muted small">No entries logged yet.</div>
          <?php else: ?>
            <div class="table-responsive">
              <table class="table table-sm table-hover align-middle">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th><?= e($platform['metric_1_label']) ?></th>
                    <th><?= e($platform['metric_2_label']) ?></th>
                    <th><?= e($platform['metric_3_label']) ?></th>
                    <?php if (Auth::can('social_analytics.manage')): ?><th></th><?php endif; ?>
                  </tr>
                </thead>
                <tbody>
                <?php foreach ($platform['recent_entries'] as $entry): ?>
                  <tr>
                    <td><?= e(date('d M Y', strtotime($entry['entry_date']))) ?></td>
                    <td><?= number_format((float) $entry['metric_1'], 2) ?></td>
                    <td><?= number_format((float) $entry['metric_2'], 2) ?></td>
                    <td><?= number_format((float) $entry['metric_3'], 2) ?></td>
                    <?php if (Auth::can('social_analytics.manage')): ?>
                    <td>
                      <form method="post" action="<?= url('/social-analytics/entries/' . $entry['id'] . '/delete') ?>" onsubmit="return confirm('Delete this entry?');">
                        <?= csrf_field() ?>
                        <button type="submit" class="btn btn-sm btn-link text-danger p-0"><i class="mdi mdi-delete"></i></button>
                      </form>
                    </td>
                    <?php endif; ?>
                  </tr>
                <?php endforeach; ?>
                </tbody>
              </table>
            </div>
          <?php endif; ?>

        <?php endif; ?>
      </div>
    </div>
  </div>
<?php endforeach; ?>
</div>

<script src="<?= asset('assets/libs/apexcharts/dist/apexcharts.min.js') ?>"></script>
<script>
(function () {
<?php foreach ($platforms as $platform):
    if ((int) $platform['is_enabled'] !== 1 || count($platform['trend']) <= 1) {
        continue;
    }
    $meta = $platformMeta[$platform['platform']] ?? ['color' => '#635bff'];
    $chartId = 'chart_' . $platform['platform'];
    $trend = $platform['trend'];
?>
  new ApexCharts(document.getElementById('<?= $chartId ?>'), {
    chart: { type: 'area', height: 220, toolbar: { show: false } },
    series: [{ name: '<?= e($platform['metric_1_label']) ?>', data: <?= json_encode(array_map(fn ($r) => (float) $r['metric_1'], $trend)) ?> }],
    xaxis: { categories: <?= json_encode(array_map(fn ($r) => date('d M', strtotime($r['entry_date'])), $trend)) ?> },
    colors: ['<?= $meta['color'] ?>'],
    dataLabels: { enabled: false },
    stroke: { curve: 'smooth', width: 2 },
    legend: { show: false },
  }).render();
<?php endforeach; ?>
})();
</script>
