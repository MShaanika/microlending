<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
      <h4 class="card-title mb-0">Borrower Loan Requests</h4>
    </div>

    <?php
      $bar = [
          'action' => url('/loan-requests'),
          'search' => ['value' => $search ?? '', 'placeholder' => 'Request no, borrower, phone or purpose'],
          'status' => ['value' => $status ?? '', 'options' => ['Pending', 'Approved', 'Rejected', 'Converted to Application', 'Cancelled']],
          'date' => ['label' => 'Submitted', 'from' => $filter['from'] ?? '', 'to' => $filter['to'] ?? ''],
          'amount' => ['label' => 'Amount', 'min' => $filter['min'] ?? '', 'max' => $filter['max'] ?? ''],
          'export' => true,
      ];
      include __DIR__ . '/../partials/list_filter_bar.php';
    ?>

    <div data-list-results>
    <?php $count = count($requests); include __DIR__ . '/../partials/list_count.php'; ?>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <th>Request No</th><th>Borrower</th><th>Type</th><th>Amount</th><th>Term</th><th>Purpose</th><th>Docs</th><th>Status</th><th>Submitted</th><th>Reviewed By</th><th class="text-end">Action</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($requests)): ?>
            <tr><td colspan="11" class="text-center text-muted py-4"><?= !empty($filtersActive) ? 'Nothing matches your filters.' : 'No loan requests from the portal yet.' ?></td></tr>
          <?php endif; ?>
          <?php foreach ($requests as $r): ?>
            <?php
              $badge = match ($r['status']) {
                'Approved', 'Converted to Application' => 'success',
                'Rejected', 'Cancelled' => 'danger',
                default => 'warning',
              };
            ?>
            <tr>
              <td><?= e($r['request_no']) ?></td>
              <td><a href="<?= url('/borrowers/' . $r['borrower_id']) ?>"><?= e($r['borrower_name']) ?></a></td>
              <td>
                <span class="badge bg-<?= $r['request_type'] === 'Top Up' ? 'info' : 'secondary' ?>"><?= e($r['request_type']) ?></span>
                <?php if ($r['request_type'] === 'Top Up' && $r['existing_loan_no']): ?>
                  <br><small class="text-muted"><?= e($r['existing_loan_no']) ?></small>
                <?php endif; ?>
              </td>
              <td><?= format_money($r['requested_amount']) ?></td>
              <td><?= (int) $r['requested_term_months'] ?> mo</td>
              <td><?= $r['purpose'] ? e($r['purpose']) : '&mdash;' ?></td>
              <td>
                <?php if ((int) $r['document_count'] > 0): ?>
                  <a href="<?= url('/loan-requests/' . $r['id'] . '/documents') ?>"><?= (int) $r['document_count'] ?> file(s)</a>
                <?php else: ?>
                  <span class="text-muted">0</span>
                <?php endif; ?>
              </td>
              <td><span class="badge bg-<?= $badge ?>"><?= e($r['status']) ?></span></td>
              <td><?= e(date('d M Y', strtotime($r['requested_at']))) ?></td>
              <td class="text-muted small"><?= e($r['reviewed_by_name'] ?: '—') ?></td>
              <td class="text-end">
                <?php if ($r['status'] === 'Pending'): ?>
                  <form method="post" action="<?= url('/loan-requests/' . $r['id'] . '/approve') ?>" class="d-inline" onsubmit="return confirmSubmit(this, 'Approve this request? You will be taken to the New Loan screen to finalize it.');">
                    <?= csrf_field() ?>
                    <button type="submit" class="btn btn-sm btn-success"><i class="mdi mdi-check"></i> Approve</button>
                  </form>
                  <form method="post" action="<?= url('/loan-requests/' . $r['id'] . '/reject') ?>" class="d-inline" onsubmit="return confirmSubmit(this, 'Reject this request?');">
                    <?= csrf_field() ?>
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-close"></i></button>
                  </form>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
    </div>
  </div>
</div>
