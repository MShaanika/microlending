<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
  <div>
    <h4 class="mb-0"><?= e($checklist['name']) ?></h4>
    <span class="text-muted"><?= e($checklist['description'] ?: '') ?></span>
  </div>
  <span class="badge bg-<?= $checklist['status'] === 'Active' ? 'success' : 'secondary' ?> fs-6"><?= e($checklist['status']) ?></span>
</div>

<div class="card mb-3">
  <div class="card-body">
    <h5 class="card-title">Checklist Items</h5>

    <?php if (Auth::can('recruitment.manage')): ?>
    <form method="post" action="<?= url('/recruitment/onboarding-checklists/' . $checklist['id'] . '/items') ?>" class="row g-2 align-items-end mb-3" data-modal-behavior="reload">
      <?= csrf_field() ?>
      <div class="col-md-3">
        <label class="form-label">Task</label>
        <input type="text" name="task_name" class="form-control" required>
      </div>
      <div class="col-md-2">
        <label class="form-label">Category</label>
        <input type="text" name="category" class="form-control" placeholder="e.g. IT Setup">
      </div>
      <div class="col-md-2">
        <label class="form-label">Assigned Role</label>
        <input type="text" name="assigned_to_role" class="form-control" placeholder="e.g. HR Manager">
      </div>
      <div class="col-md-2">
        <label class="form-label">Due Day</label>
        <input type="number" name="due_day" class="form-control" placeholder="Days from start">
      </div>
      <div class="col-md-1 d-flex align-items-center">
        <div class="form-check">
          <input type="checkbox" name="is_required" value="1" class="form-check-input" id="is_required" checked>
          <label class="form-check-label" for="is_required">Req.</label>
        </div>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-info w-100">Add Item</button>
      </div>
    </form>
    <?php endif; ?>

    <div class="table-responsive">
      <table class="table table-sm">
        <thead><tr><th>Task</th><th>Category</th><th>Assigned Role</th><th>Due Day</th><th>Required</th><th></th></tr></thead>
        <tbody>
          <?php if (empty($items)): ?>
            <tr><td colspan="6" class="text-center text-muted py-3">No items yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($items as $it): ?>
            <tr>
              <td><?= e($it['task_name']) ?><?php if (!empty($it['description'])): ?><br><span class="text-muted small"><?= e($it['description']) ?></span><?php endif; ?></td>
              <td><?= e($it['category'] ?: '—') ?></td>
              <td><?= e($it['assigned_to_role'] ?: '—') ?></td>
              <td><?= $it['due_day'] !== null ? 'Day ' . (int) $it['due_day'] : '—' ?></td>
              <td><?= $it['is_required'] ? '<i class="mdi mdi-check text-success"></i>' : '—' ?></td>
              <td class="text-end">
                <?php if (Auth::can('recruitment.manage')): ?>
                <form method="post" action="<?= url('/recruitment/onboarding-checklists/' . $checklist['id'] . '/items/' . $it['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Delete this item?');" data-modal-behavior="reload">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>

<a href="<?= url('/recruitment/onboarding-checklists') ?>" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Back</a>
