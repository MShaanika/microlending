<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Edit Onboarding Checklist</h4>
    <form method="post" action="<?= url('/recruitment/onboarding-checklists/' . $checklist['id']) ?>">
      <?= csrf_field() ?>
      <div class="mb-3">
        <label class="form-label">Name *</label>
        <input type="text" name="name" class="form-control <?= isset($errors['name']) ? 'is-invalid' : '' ?>" value="<?= e($checklist['name']) ?>">
        <?php if (isset($errors['name'])): ?><div class="invalid-feedback"><?= e($errors['name']) ?></div><?php endif; ?>
      </div>
      <div class="mb-3">
        <label class="form-label">Description</label>
        <textarea name="description" class="form-control" rows="3"><?= e($checklist['description'] ?? '') ?></textarea>
      </div>
      <div class="mb-3">
        <div class="form-check">
          <input type="checkbox" name="is_default" value="1" class="form-check-input" id="is_default" <?= $checklist['is_default'] ? 'checked' : '' ?>>
          <label class="form-check-label" for="is_default">Default checklist</label>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-select">
          <option value="Active" <?= ($checklist['status'] === 'Active') ? 'selected' : '' ?>>Active</option>
          <option value="Inactive" <?= ($checklist['status'] === 'Inactive') ? 'selected' : '' ?>>Inactive</option>
        </select>
      </div>
      <button type="submit" class="btn btn-info">Save</button>
      <a href="<?= url('/recruitment/onboarding-checklists') ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
