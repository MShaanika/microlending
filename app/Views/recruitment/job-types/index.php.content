<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Job Types</h4>
      <?php if (Auth::can('recruitment.manage')): ?>
        <a href="<?= url('/recruitment/job-types/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Add Job Type</a>
      <?php endif; ?>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>Name</th><th>Description</th><th>Status</th><?php if (Auth::can('recruitment.manage')): ?><th></th><?php endif; ?></tr>
        </thead>
        <tbody>
          <?php if (empty($types)): ?>
            <tr><td colspan="4" class="text-center text-muted py-4">No job types yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($types as $t): ?>
            <tr>
              <td><?= e($t['name']) ?></td>
              <td><?= e($t['description'] ?: '—') ?></td>
              <td><span class="badge bg-<?= $t['status'] === 'Active' ? 'success' : 'secondary' ?>"><?= e($t['status']) ?></span></td>
              <?php if (Auth::can('recruitment.manage')): ?>
              <td class="text-end">
                <a href="<?= url('/recruitment/job-types/' . $t['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-pencil"></i></a>
                <form method="post" action="<?= url('/recruitment/job-types/' . $t['id'] . '/delete') ?>" class="d-inline" onsubmit="return confirm('Delete this job type?');">
                  <?= csrf_field() ?>
                  <button type="submit" class="btn btn-sm btn-outline-danger"><i class="mdi mdi-delete"></i></button>
                </form>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
