<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Offers</h4>
      <?php if (Auth::can('recruitment.manage')): ?>
        <a href="<?= url('/recruitment/offers/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Create Offer</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/recruitment/offers') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search Offers..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
        <?php foreach ([10, 25, 50, 100] as $pp): ?>
          <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
        <?php endforeach; ?>
      </select>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Candidate', 'candidate', $_GET, $sort, $dir) ?>
            <th>Position</th>
            <?= sortable_th('Salary', 'salary', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <th>Approval</th>
            <th>Converted</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($offers)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4">No offers found.</td></tr>
          <?php endif; ?>
          <?php $statusBadge = ['Draft' => 'secondary', 'Sent' => 'info', 'Accepted' => 'success', 'Negotiating' => 'warning', 'Declined' => 'danger', 'Expired' => 'dark']; ?>
          <?php $approvalBadge = ['Pending' => 'warning', 'Approved' => 'success', 'Rejected' => 'danger']; ?>
          <?php foreach ($offers as $o): ?>
            <tr>
              <td><a href="<?= url('/recruitment/offers/' . $o['id']) ?>"><?= e($o['candidate_name']) ?></a></td>
              <td><?= e($o['position']) ?></td>
              <td><?= format_money($o['salary']) ?></td>
              <td><span class="badge bg-<?= $statusBadge[$o['status']] ?? 'secondary' ?>"><?= e($o['status']) ?></span></td>
              <td><span class="badge bg-<?= $approvalBadge[$o['approval_status']] ?? 'secondary' ?>"><?= e($o['approval_status']) ?></span></td>
              <td><?= $o['converted_to_employee'] ? '<i class="mdi mdi-check text-success"></i>' : '—' ?></td>
              <td class="text-end">
                <a href="<?= url('/recruitment/offers/' . $o['id']) ?>" class="btn btn-sm btn-outline-primary"><i class="mdi mdi-eye"></i></a>
                <?php if (Auth::can('recruitment.manage') && !$o['converted_to_employee']): ?>
                <a href="<?= url('/recruitment/offers/' . $o['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-pencil"></i></a>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($offers) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
