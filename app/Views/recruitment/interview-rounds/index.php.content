<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Interview Rounds</h4>
    </div>
    <p class="text-muted small">Rounds are added and removed from each job posting's detail page. This is a searchable overview across all jobs.</p>

    <form method="get" action="<?= url('/recruitment/interview-rounds') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search interview rounds..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
        <?php foreach ([10, 25, 50, 100] as $pp): ?>
          <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
        <?php endforeach; ?>
      </select>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Name', 'name', $_GET, $sort, $dir) ?>
            <?= sortable_th('Job', 'job', $_GET, $sort, $dir) ?>
            <?= sortable_th('Sequence', 'sequence', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <?php if (Auth::can('recruitment.manage')): ?><th class="text-end">Job Posting</th><?php endif; ?>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($rounds)): ?>
            <tr><td colspan="5" class="text-center text-muted py-4">No interview rounds found.</td></tr>
          <?php endif; ?>
          <?php foreach ($rounds as $r): ?>
            <tr>
              <td><?= e($r['name']) ?></td>
              <td><?= e($r['job_title'] ?: '—') ?></td>
              <td><?= (int) $r['sequence_number'] ?></td>
              <td><span class="badge bg-<?= $r['status'] === 'Active' ? 'success' : 'secondary' ?>"><?= e($r['status']) ?></span></td>
              <?php if (Auth::can('recruitment.manage')): ?>
              <td class="text-end">
                <?php if ($r['job_id']): ?>
                  <a href="<?= url('/recruitment/job-postings/' . $r['job_id']) ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-eye"></i> Manage on Job</a>
                <?php endif; ?>
              </td>
              <?php endif; ?>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($rounds) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
