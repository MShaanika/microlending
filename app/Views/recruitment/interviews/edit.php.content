<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-1">Edit Interview</h4>
    <p class="text-muted small mb-3">For <?= e($interview['candidate_name']) ?> &middot; <?= e($interview['job_title'] ?: 'Uncategorized') ?></p>
    <form method="post" action="<?= url('/recruitment/interviews/' . $interview['id']) ?>">
      <?= csrf_field() ?>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Interview Round</label>
          <select name="round_id" class="form-select">
            <option value="">— None —</option>
            <?php foreach ($rounds as $r): ?>
              <option value="<?= (int) $r['id'] ?>" <?= (($old['round_id'] ?? '') == $r['id']) ? 'selected' : '' ?>><?= e($r['name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Interview Type</label>
          <select name="interview_type_id" class="form-select">
            <option value="">— None —</option>
            <?php foreach ($types as $t): ?>
              <option value="<?= (int) $t['id'] ?>" <?= (($old['interview_type_id'] ?? '') == $t['id']) ? 'selected' : '' ?>><?= e($t['name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Date *</label>
          <input type="date" name="scheduled_date" class="form-control <?= isset($errors['scheduled_date']) ? 'is-invalid' : '' ?>" value="<?= e($old['scheduled_date'] ?? '') ?>">
          <?php if (isset($errors['scheduled_date'])): ?><div class="invalid-feedback"><?= e($errors['scheduled_date']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Time</label>
          <input type="time" name="scheduled_time" class="form-control" value="<?= e($old['scheduled_time'] ?? '') ?>">
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Duration (minutes)</label>
          <input type="number" min="1" name="duration" class="form-control" value="<?= e($old['duration'] ?? '') ?>">
        </div>
      </div>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-control" value="<?= e($old['location'] ?? '') ?>">
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Meeting Link</label>
          <input type="text" name="meeting_link" class="form-control" value="<?= e($old['meeting_link'] ?? '') ?>">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Interviewers</label>
        <select name="interviewer_ids[]" class="form-select" multiple size="4">
          <?php foreach ($users as $u): ?>
            <option value="<?= (int) $u['id'] ?>" <?= in_array((int) $u['id'], $old['interviewer_ids'] ?? [], true) ? 'selected' : '' ?>><?= e($u['name']) ?></option>
          <?php endforeach; ?>
        </select>
        <div class="form-text">Hold Ctrl/Cmd to select multiple.</div>
      </div>
      <button type="submit" class="btn btn-info">Save</button>
      <a href="<?= url('/recruitment/interviews/' . $interview['id']) ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
