<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Schedule Interview</h4>
    <form method="post" action="<?= url('/recruitment/interviews') ?>">
      <?= csrf_field() ?>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Candidate *</label>
          <select name="candidate_id" id="candidate_id" class="form-select <?= isset($errors['candidate_id']) ? 'is-invalid' : '' ?>">
            <option value="">— Select —</option>
            <?php foreach ($candidates as $c): ?>
              <option value="<?= (int) $c['id'] ?>" <?= (($old['candidate_id'] ?? '') == $c['id']) ? 'selected' : '' ?>><?= e($c['first_name'] . ' ' . $c['last_name']) ?> (<?= e($c['job_title'] ?? '') ?>)</option>
            <?php endforeach; ?>
          </select>
          <?php if (isset($errors['candidate_id'])): ?><div class="invalid-feedback"><?= e($errors['candidate_id']) ?></div><?php endif; ?>
          <div class="form-text">Only candidates currently at the Interview stage are listed.</div>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Interview Round</label>
          <select name="round_id" id="round_id" class="form-select">
            <option value="">— None —</option>
          </select>
        </div>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Interview Type</label>
          <select name="interview_type_id" class="form-select">
            <option value="">— None —</option>
            <?php foreach ($types as $t): ?>
              <option value="<?= (int) $t['id'] ?>" <?= (($old['interview_type_id'] ?? '') == $t['id']) ? 'selected' : '' ?>><?= e($t['name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Date *</label>
          <input type="date" name="scheduled_date" class="form-control <?= isset($errors['scheduled_date']) ? 'is-invalid' : '' ?>" value="<?= e($old['scheduled_date'] ?? '') ?>">
          <?php if (isset($errors['scheduled_date'])): ?><div class="invalid-feedback"><?= e($errors['scheduled_date']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Time</label>
          <input type="time" name="scheduled_time" class="form-control" value="<?= e($old['scheduled_time'] ?? '') ?>">
        </div>
      </div>
      <div class="row">
        <div class="col-md-4 mb-3">
          <label class="form-label">Duration (minutes)</label>
          <input type="number" min="1" name="duration" class="form-control" value="<?= e($old['duration'] ?? '') ?>">
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Location</label>
          <input type="text" name="location" class="form-control" value="<?= e($old['location'] ?? '') ?>">
        </div>
        <div class="col-md-4 mb-3">
          <label class="form-label">Meeting Link</label>
          <input type="text" name="meeting_link" class="form-control" value="<?= e($old['meeting_link'] ?? '') ?>">
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Interviewers</label>
        <select name="interviewer_ids[]" class="form-select" multiple size="4">
          <?php foreach ($users as $u): ?>
            <option value="<?= (int) $u['id'] ?>"><?= e($u['name']) ?></option>
          <?php endforeach; ?>
        </select>
        <div class="form-text">Hold Ctrl/Cmd to select multiple.</div>
      </div>
      <button type="submit" class="btn btn-info">Save</button>
      <a href="<?= url('/recruitment/interviews') ?>" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</a>
    </form>
  </div>
</div>

<script>
document.getElementById('candidate_id').addEventListener('change', function () {
  var roundSelect = document.getElementById('round_id');
  roundSelect.innerHTML = '<option value="">— None —</option>';
  if (!this.value) { return; }
  fetch('<?= url('/recruitment/candidates') ?>/' + this.value + '/rounds.json')
    .then(function (r) { return r.json(); })
    .then(function (rounds) {
      rounds.forEach(function (r) {
        var opt = document.createElement('option');
        opt.value = r.id;
        opt.textContent = r.name;
        roundSelect.appendChild(opt);
      });
    });
});
</script>
