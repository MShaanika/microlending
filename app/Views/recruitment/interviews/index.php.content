<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Interviews</h4>
      <?php if (Auth::can('recruitment.manage')): ?>
        <a href="<?= url('/recruitment/interviews/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-plus"></i> Schedule Interview</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/recruitment/interviews') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search Interviews..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
        <?php foreach ([10, 25, 50, 100] as $pp): ?>
          <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
        <?php endforeach; ?>
      </select>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Candidate', 'candidate', $_GET, $sort, $dir) ?>
            <?= sortable_th('Job', 'job', $_GET, $sort, $dir) ?>
            <?= sortable_th('Round', 'round', $_GET, $sort, $dir) ?>
            <?= sortable_th('Type', 'type', $_GET, $sort, $dir) ?>
            <?= sortable_th('Date', 'scheduled_date', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($interviews)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4">No interviews found.</td></tr>
          <?php endif; ?>
          <?php $statusBadge = ['Scheduled' => 'info', 'Completed' => 'success', 'Cancelled' => 'dark', 'No-show' => 'danger']; ?>
          <?php foreach ($interviews as $i): ?>
            <tr>
              <td><a href="<?= url('/recruitment/interviews/' . $i['id']) ?>"><?= e($i['candidate_name']) ?></a></td>
              <td><?= e($i['job_title'] ?: '—') ?></td>
              <td><?= e($i['round_name'] ?: '—') ?></td>
              <td><?= e($i['interview_type_name'] ?: '—') ?></td>
              <td><?= e(date('d M Y', strtotime($i['scheduled_date']))) ?> <?= e($i['scheduled_time'] ?? '') ?></td>
              <td><span class="badge bg-<?= $statusBadge[$i['status']] ?? 'secondary' ?>"><?= e($i['status']) ?></span></td>
              <td class="text-end">
                <a href="<?= url('/recruitment/interviews/' . $i['id']) ?>" class="btn btn-sm btn-outline-primary"><i class="mdi mdi-eye"></i></a>
                <?php if (Auth::can('recruitment.manage')): ?>
                <a href="<?= url('/recruitment/interviews/' . $i['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary"><i class="mdi mdi-pencil"></i></a>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($interviews) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
