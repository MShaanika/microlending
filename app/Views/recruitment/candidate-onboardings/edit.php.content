<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-1">Edit Onboarding</h4>
    <p class="text-muted small mb-3">For <?= e($onboarding['candidate_name']) ?></p>
    <form method="post" action="<?= url('/recruitment/candidate-onboardings/' . $onboarding['id']) ?>">
      <?= csrf_field() ?>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Checklist</label>
          <select name="checklist_id" class="form-select">
            <option value="">— None —</option>
            <?php foreach ($checklists as $cl): ?>
              <option value="<?= (int) $cl['id'] ?>" <?= (($old['checklist_id'] ?? '') == $cl['id']) ? 'selected' : '' ?>><?= e($cl['name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Start Date *</label>
          <input type="date" name="start_date" class="form-control <?= isset($errors['start_date']) ? 'is-invalid' : '' ?>" value="<?= e($old['start_date'] ?? '') ?>">
          <?php if (isset($errors['start_date'])): ?><div class="invalid-feedback"><?= e($errors['start_date']) ?></div><?php endif; ?>
        </div>
      </div>
      <div class="mb-3">
        <label class="form-label">Buddy</label>
        <select name="buddy_employee_id" class="form-select">
          <option value="">— None —</option>
          <?php foreach ($employees as $e): ?>
            <option value="<?= (int) $e['id'] ?>" <?= (($old['buddy_employee_id'] ?? '') == $e['id']) ? 'selected' : '' ?>><?= e($e['first_name'] . ' ' . $e['last_name']) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <button type="submit" class="btn btn-info">Save</button>
      <a href="<?= url('/recruitment/candidate-onboardings/' . $onboarding['id']) ?>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
</div>
