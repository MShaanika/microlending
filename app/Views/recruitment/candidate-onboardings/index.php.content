<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Candidate Onboarding</h4>
      <?php if (Auth::can('recruitment.manage')): ?>
        <a href="<?= url('/recruitment/candidate-onboardings/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/recruitment/candidate-onboardings/create') ?>" data-modal-title="Start Onboarding" data-modal-size="lg"><i class="mdi mdi-plus"></i> Start Onboarding</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/recruitment/candidate-onboardings') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search by candidate..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
        <?php foreach ([10, 25, 50, 100] as $pp): ?>
          <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
        <?php endforeach; ?>
      </select>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Candidate', 'candidate', $_GET, $sort, $dir) ?>
            <?= sortable_th('Checklist', 'checklist', $_GET, $sort, $dir) ?>
            <?= sortable_th('Start Date', 'start_date', $_GET, $sort, $dir) ?>
            <?= sortable_th('Buddy', 'buddy', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($onboardings)): ?>
            <tr><td colspan="6" class="text-center text-muted py-4">No onboarding records found.</td></tr>
          <?php endif; ?>
          <?php $statusBadge = ['Pending' => 'secondary', 'In Progress' => 'warning', 'Completed' => 'success']; ?>
          <?php foreach ($onboardings as $o): ?>
            <tr>
              <td><a href="<?= url('/recruitment/candidate-onboardings/' . $o['id']) ?>" data-modal-url="<?= url('/recruitment/candidate-onboardings/' . $o['id']) ?>" data-modal-title="<?= e('Onboarding: ' . $o['candidate_name']) ?>" data-modal-size="lg"><?= e($o['candidate_name']) ?></a></td>
              <td><?= e($o['checklist_name'] ?: '—') ?></td>
              <td><?= e(date('d M Y', strtotime($o['start_date']))) ?></td>
              <td><?= e($o['buddy_name'] ?: '—') ?></td>
              <td>
                <?php if (Auth::can('recruitment.manage')): ?>
                  <form method="post" action="<?= url('/recruitment/candidate-onboardings/' . $o['id'] . '/status') ?>" class="d-inline-flex gap-1">
                    <?= csrf_field() ?>
                    <select name="status" class="form-select form-select-sm" onchange="this.form.submit()" style="width:auto">
                      <?php foreach (['Pending', 'In Progress', 'Completed'] as $s): ?>
                        <option value="<?= e($s) ?>" <?= ($o['status'] === $s) ? 'selected' : '' ?>><?= e($s) ?></option>
                      <?php endforeach; ?>
                    </select>
                  </form>
                <?php else: ?>
                  <span class="badge bg-<?= $statusBadge[$o['status']] ?? 'secondary' ?>"><?= e($o['status']) ?></span>
                <?php endif; ?>
              </td>
              <td class="text-end">
                <a href="<?= url('/recruitment/candidate-onboardings/' . $o['id']) ?>" class="btn btn-sm btn-outline-primary" data-modal-url="<?= url('/recruitment/candidate-onboardings/' . $o['id']) ?>" data-modal-title="<?= e('Onboarding: ' . $o['candidate_name']) ?>" data-modal-size="lg"><i class="mdi mdi-eye"></i></a>
                <?php if (Auth::can('recruitment.manage')): ?>
                <a href="<?= url('/recruitment/candidate-onboardings/' . $o['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary" data-modal-url="<?= url('/recruitment/candidate-onboardings/' . $o['id'] . '/edit') ?>" data-modal-title="Edit Onboarding" data-modal-size="lg"><i class="mdi mdi-pencil"></i></a>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($onboardings) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
