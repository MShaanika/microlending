<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <h4 class="card-title mb-3">Start Onboarding</h4>
    <?php if (empty($candidates)): ?>
      <div class="alert alert-warning">No hired candidates are awaiting onboarding right now.</div>
    <?php endif; ?>
    <form method="post" action="<?= url('/recruitment/candidate-onboardings') ?>">
      <?= csrf_field() ?>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Candidate *</label>
          <select name="candidate_id" class="form-select <?= isset($errors['candidate_id']) ? 'is-invalid' : '' ?>">
            <option value="">— Select —</option>
            <?php foreach ($candidates as $c): ?>
              <option value="<?= (int) $c['id'] ?>" <?= (($old['candidate_id'] ?? '') == $c['id']) ? 'selected' : '' ?>><?= e($c['first_name'] . ' ' . $c['last_name']) ?></option>
            <?php endforeach; ?>
          </select>
          <?php if (isset($errors['candidate_id'])): ?><div class="invalid-feedback"><?= e($errors['candidate_id']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Checklist</label>
          <select name="checklist_id" class="form-select">
            <option value="">— None —</option>
            <?php foreach ($checklists as $cl): ?>
              <option value="<?= (int) $cl['id'] ?>" <?= (($old['checklist_id'] ?? '') == $cl['id']) ? 'selected' : '' ?>><?= e($cl['name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
      </div>
      <div class="row">
        <div class="col-md-6 mb-3">
          <label class="form-label">Start Date *</label>
          <input type="date" name="start_date" class="form-control <?= isset($errors['start_date']) ? 'is-invalid' : '' ?>" value="<?= e($old['start_date'] ?? date('Y-m-d')) ?>">
          <?php if (isset($errors['start_date'])): ?><div class="invalid-feedback"><?= e($errors['start_date']) ?></div><?php endif; ?>
        </div>
        <div class="col-md-6 mb-3">
          <label class="form-label">Buddy</label>
          <select name="buddy_employee_id" class="form-select">
            <option value="">— None —</option>
            <?php foreach ($employees as $e): ?>
              <option value="<?= (int) $e['id'] ?>" <?= (($old['buddy_employee_id'] ?? '') == $e['id']) ? 'selected' : '' ?>><?= e($e['first_name'] . ' ' . $e['last_name']) ?></option>
            <?php endforeach; ?>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-info">Save</button>
      <a href="<?= url('/recruitment/candidate-onboardings') ?>" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</a>
    </form>
  </div>
</div>
