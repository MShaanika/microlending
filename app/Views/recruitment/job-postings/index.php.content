<?php use App\Core\Auth; ?>
<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Job Postings</h4>
      <?php if (Auth::can('recruitment.manage')): ?>
        <a href="<?= url('/recruitment/job-postings/create') ?>" class="btn btn-info btn-sm waves-effect waves-light" data-modal-url="<?= url('/recruitment/job-postings/create') ?>" data-modal-title="Add Job Posting" data-modal-size="xl"><i class="mdi mdi-plus"></i> Add Job Posting</a>
      <?php endif; ?>
    </div>

    <form method="get" action="<?= url('/recruitment/job-postings') ?>" class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
      <input type="hidden" name="sort" value="<?= e($sort) ?>">
      <input type="hidden" name="dir" value="<?= e($dir) ?>">
      <div class="d-flex gap-2 flex-grow-1" style="min-width:260px; max-width:420px;">
        <input type="text" name="q" class="form-control" placeholder="Search Job Postings..." value="<?= e($search) ?>">
        <button class="btn btn-success flex-shrink-0" type="submit"><i class="mdi mdi-magnify"></i> Search</button>
      </div>
      <div class="d-flex gap-2 align-items-center">
        <select name="per_page" class="form-select form-select-sm" style="width:auto" onchange="this.form.submit()">
          <?php foreach ([10, 25, 50, 100] as $pp): ?>
            <option value="<?= $pp ?>" <?= $perPage === $pp ? 'selected' : '' ?>><?= $pp ?> per page</option>
          <?php endforeach; ?>
        </select>
        <div class="dropdown">
          <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="mdi mdi-filter-outline"></i> Filters
          </button>
          <div class="dropdown-menu dropdown-menu-end p-3" style="min-width:240px">
            <label class="form-label small mb-1">Status</label>
            <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
              <option value="">All</option>
              <?php foreach (['Draft', 'Active', 'Closed'] as $s): ?>
                <option value="<?= e($s) ?>" <?= (($filters['status'] ?? '') === $s) ? 'selected' : '' ?>><?= e($s) ?></option>
              <?php endforeach; ?>
            </select>
          </div>
        </div>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr>
            <?= sortable_th('Title', 'title', $_GET, $sort, $dir) ?>
            <?= sortable_th('Type', 'job_type', $_GET, $sort, $dir) ?>
            <?= sortable_th('Location', 'location', $_GET, $sort, $dir) ?>
            <?= sortable_th('Candidates', 'candidates', $_GET, $sort, $dir) ?>
            <?= sortable_th('Published', 'published', $_GET, $sort, $dir) ?>
            <?= sortable_th('Status', 'status', $_GET, $sort, $dir) ?>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <?php if (empty($postings)): ?>
            <tr><td colspan="7" class="text-center text-muted py-4">No job postings found.</td></tr>
          <?php endif; ?>
          <?php $statusBadge = ['Draft' => 'secondary', 'Active' => 'success', 'Closed' => 'dark']; ?>
          <?php foreach ($postings as $p): ?>
            <tr>
              <td><a href="<?= url('/recruitment/job-postings/' . $p['id']) ?>" data-modal-url="<?= url('/recruitment/job-postings/' . $p['id']) ?>" data-modal-title="<?= e($p['title']) ?>" data-modal-size="xl"><?= e($p['title']) ?></a> <?php if ($p['is_featured']): ?><span class="badge bg-warning">Featured</span><?php endif; ?></td>
              <td><?= e($p['job_type_name'] ?: '—') ?></td>
              <td><?= e($p['location_name'] ?: '—') ?></td>
              <td><?= (int) $p['candidate_count'] ?></td>
              <td><?= $p['is_published'] ? '<span class="badge bg-info">Published</span>' : '<span class="badge bg-secondary">Unpublished</span>' ?></td>
              <td><span class="badge bg-<?= $statusBadge[$p['status']] ?? 'secondary' ?>"><?= e($p['status']) ?></span></td>
              <td class="text-end">
                <a href="<?= url('/recruitment/job-postings/' . $p['id']) ?>" class="btn btn-sm btn-outline-primary" data-modal-url="<?= url('/recruitment/job-postings/' . $p['id']) ?>" data-modal-title="<?= e($p['title']) ?>" data-modal-size="xl"><i class="mdi mdi-eye"></i></a>
                <?php if (Auth::can('recruitment.manage')): ?>
                <a href="<?= url('/recruitment/job-postings/' . $p['id'] . '/edit') ?>" class="btn btn-sm btn-outline-secondary" data-modal-url="<?= url('/recruitment/job-postings/' . $p['id'] . '/edit') ?>" data-modal-title="Edit Job Posting" data-modal-size="xl"><i class="mdi mdi-pencil"></i></a>
                <?php endif; ?>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
      <p class="text-muted small mb-0">Showing <?= count($postings) ?> of <?= $total ?> result<?= $total === 1 ? '' : 's' ?></p>
      <?= pagination_nav($page, $totalPages, $_GET) ?>
    </div>
  </div>
</div>
