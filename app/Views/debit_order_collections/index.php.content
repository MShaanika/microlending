<?= flash_messages() ?>

<div class="card">
  <div class="card-body">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
      <h4 class="card-title mb-0">Collection Reports</h4>
      <div class="d-flex gap-2 flex-wrap">
        <form method="post" action="<?= url('/debit-order-collections/download-payments') ?>" class="d-flex gap-2">
          <?= csrf_field() ?>
          <select name="bank_account_id" class="form-select form-select-sm" style="width:200px;">
            <option value="">No specific bank account</option>
            <?php foreach ($bankAccounts as $ba): ?>
              <option value="<?= (int) $ba['id'] ?>"><?= e($ba['bank_name'] . ' - ' . $ba['account_name']) ?></option>
            <?php endforeach; ?>
          </select>
          <button type="submit" class="btn btn-outline-info btn-sm waves-effect waves-light" <?= (!$collexiaEnabled || !$collexiaConfigured) ? 'disabled' : '' ?>><i class="mdi mdi-cloud-download"></i> Download Payments from Collexia</button>
        </form>
        <a href="<?= url('/debit-order-collections/create') ?>" class="btn btn-info btn-sm waves-effect waves-light"><i class="mdi mdi-upload"></i> Import Report</a>
      </div>
    </div>
    <p class="text-muted small">Upload any of Collexia's report exports here -- the report type is detected automatically from the file. Matched rows from a Successful Transactions report (plain or "with Detail Selection") are posted as real payments automatically; every other report type is imported for visibility only.</p>
    <?php if (!$collexiaConfigured): ?>
      <p class="text-muted small">"Download Payments from Collexia" needs API credentials first -- <a href="<?= url('/collexia/settings') ?>">set them up here</a>.</p>
    <?php elseif (!$collexiaEnabled): ?>
      <p class="text-muted small">"Download Payments from Collexia" is configured but disabled -- <a href="<?= url('/collexia/settings') ?>">enable the integration</a> to use it.</p>
    <?php endif; ?>

    <form method="get" action="<?= url('/debit-order-collections') ?>" class="row g-2 align-items-center mb-3">
      <div class="col-md-4">
        <select name="report_type" class="form-select form-select-sm">
          <option value="">All Statuses</option>
          <?php foreach (['Successful', 'SuccessfulDetail', 'SuccessfulSimplified', 'Unsuccessful', 'FailedValidation', 'Scheduled', 'ScheduledDetail', 'ScheduledForecast', 'CollexiaAPI', 'MandateAudit'] as $rt): ?>
            <option value="<?= e($rt) ?>" <?= $reportType === $rt ? 'selected' : '' ?>><?= e(collexia_report_type_label($rt)) ?></option>
          <?php endforeach; ?>
        </select>
      </div>
      <div class="col-md-5">
        <div class="form-check">
          <input type="checkbox" class="form-check-input" id="show_empty" name="show_empty" value="1" <?= $showEmpty ? 'checked' : '' ?>>
          <label class="form-check-label small" for="show_empty">Show empty downloads (0 rows -- mostly Collexia API pulls that found nothing new)</label>
        </div>
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-outline-secondary btn-sm w-100"><i class="mdi mdi-magnify"></i> Filter</button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead>
          <tr><th>File</th><th>Report Type</th><th>Rows</th><th>Matched</th><th>Payments Posted</th><th>Imported By</th><th>Imported At</th><th class="text-end">Action</th></tr>
        </thead>
        <tbody>
          <?php if (empty($imports)): ?>
            <tr><td colspan="8" class="text-center text-muted py-4">No collection reports imported yet.</td></tr>
          <?php endif; ?>
          <?php foreach ($imports as $i): ?>
            <?php $typeBadge = collexia_report_type_badge($i['report_type']); ?>
            <tr>
              <td><?= e($i['filename']) ?></td>
              <td><span class="badge bg-<?= $typeBadge ?>"><?= e(collexia_report_type_label($i['report_type'])) ?></span></td>
              <td><?= (int) $i['total_rows'] ?></td>
              <td><?= (int) $i['matched_rows'] ?></td>
              <td><span class="badge bg-success"><?= (int) $i['posted_payments'] ?></span></td>
              <td><?= $i['imported_by_name'] ? e($i['imported_by_name']) : '&mdash;' ?></td>
              <td><?= e(date('d M Y H:i', strtotime($i['imported_at']))) ?></td>
              <td class="text-end">
                <a href="<?= url('/debit-order-collections/' . $i['id']) ?>" class="btn btn-sm btn-outline-info"><i class="mdi mdi-eye"></i></a>
              </td>
            </tr>
          <?php endforeach; ?>
        </tbody>
      </table>
    </div>
  </div>
</div>
